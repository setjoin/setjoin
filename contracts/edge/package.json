{
  "name": "@setjoin/edge-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Schema-first TypeSpec definitions and OpenAPI 3.1 baseline for Setjoin HTTP edge APIs.",
  "scripts": {
    "compile": "tsp compile main.tsp",
    "gen:ts": "openapi-typescript openapi/edge.v1.yaml -o ../../webmail/src/lib/edge/schema.d.ts",
    "gen:rust": "node scripts/gen-rust-dtos.mjs openapi/edge.v1.yaml ../../server/crates/edge-contract/src/generated.rs",
    "build": "npm run compile && npm run gen:ts && npm run gen:rust"
  },
  "devDependencies": {
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "js-yaml": "4.1.1",
    "openapi-typescript": "7.13.0"
  }
}
