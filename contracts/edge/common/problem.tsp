import "@typespec/http";

using TypeSpec.Http;

namespace SetjoinEdge.Common;

@doc("RFC 9457 Problem Details payload returned by Setjoin HTTP edge handlers.")
model ProblemDetails {
  @doc("URI reference identifying the problem type.")
  type?: string;

  @doc("Short human-readable summary of the problem type.")
  title?: string;

  @doc("HTTP status code generated by the origin server.")
  status: int32;

  @doc("Human-readable explanation specific to this occurrence of the problem.")
  detail?: string;

  @doc("Machine-readable Setjoin error code (e.g., dpop_admission, BZ121).")
  code?: string;

  @doc("URI reference identifying the specific occurrence of the problem.")
  instance?: string;

  @doc("Optional remediation hint or action key.")
  remediation?: string;

  @doc("Optional Terms of Use identifier when remediation is 'terms'.")
  remediation_tou_id?: int64;

  @doc("Whether the client may safely retry the operation.")
  retryable?: boolean;

  @doc("Optional lock holder identifier for conflict responses.")
  holderId?: int64;
}

@error
model BadRequestProblem {
  @statusCode statusCode: 400;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}

@error
model UnauthorizedProblem {
  @statusCode statusCode: 401;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}

@error
model ForbiddenProblem {
  @statusCode statusCode: 403;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}

@error
model NotFoundProblem {
  @statusCode statusCode: 404;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}

@error
model NotFoundTextResponse {
  @statusCode statusCode: 404;
  @header("content-type") contentType: "text/plain";
  @body body: string;
}

@error
model TooManyRequestsProblem {
  @statusCode statusCode: 429;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}

@error
model InternalServerProblem {
  @statusCode statusCode: 500;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}

@error
model ServiceUnavailableProblem {
  @statusCode statusCode: 503;
  @header("content-type") contentType: "application/problem+json";
  @body body: ProblemDetails;
}
