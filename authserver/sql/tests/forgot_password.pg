-- pgTAP test: forgot-password schema — table, toggles, and the REAL registered
-- prune path for consumed reset-token hashes (med-shard3-003).
--
-- The superseded version of this file executed the prune DELETE inline and
-- asserted the pg_cron job behind a pg_cron-absence skip — an assertion that
-- could only ever pass by skipping (false-green, D-AUTHSERVER-SQL-TESTS-002).
-- Now: has_function is a HARD failure on any schema lacking the pruner
-- (no skip arm), the sweep is exercised through prune_used_password_reset_tokens()
-- — the function the registered Go cron task prune-used-password-reset-tokens
-- executes (mailserver/internal/cron/tasks.go; registration is asserted by
-- TestPasswordResetTokenRetention_TaskRegistered and resolve drift by
-- ValidateRegistrations, the startup/test-time gate that fails on any
-- schema where a registered prune function does not resolve).
BEGIN;
SELECT plan(15);

-- 1. Table exists
SELECT has_table('used_password_reset_tokens');

-- 2. Primary key enforces uniqueness — and the single-use property is
--    PROVEN, not presumed: replaying the SAME token_hash must throw 23505
--    (used_password_reset_tokens_pkey, V001 baseline). Dropping the PK
--    turns this file red (mutation-checked), so single-use replay
--    prevention can no longer regress silently.
INSERT INTO used_password_reset_tokens (token_hash) VALUES ('abc123');
SELECT is(COUNT(*), 1::bigint) FROM used_password_reset_tokens WHERE token_hash = 'abc123';
SELECT throws_ok(
    'INSERT INTO used_password_reset_tokens (token_hash) VALUES (''abc123'')',
    '23505',
    NULL,
    'duplicate token_hash INSERT is rejected — the token is single-use'
);
SELECT is(COUNT(*), 1::bigint) FROM used_password_reset_tokens WHERE token_hash = 'abc123';

-- 3. Feature toggles are seeded
SELECT is(
    (SELECT enabled FROM feature_toggles WHERE key = 'feature.forgot_password'),
    TRUE,
    'forgot_password toggle defaults to true'
);
SELECT is(
    (SELECT enabled FROM feature_toggles WHERE key = 'feature.forgot_password_push'),
    TRUE,
    'forgot_password_push toggle defaults to true'
);

-- 4. The pruner itself exists — hard FAIL (not a skip) on any schema lacking
--    it, so the old skip-only-pass shape cannot come back.
SELECT has_function(
    'prune_used_password_reset_tokens',
    'consumed reset-token pruner is installed in the active schema'
);

-- 5. Prune through the REAL registered path (not an inline DELETE): exactly
--    the tombstone past the 10-minute default window goes; fresh tombstones —
--    whose JWTs may still be inside the 5-minute validity — survive.
INSERT INTO used_password_reset_tokens (token_hash, created_at) VALUES
    ('old-token',   now() - interval '11 minutes'),
    ('fresh-token', now() - interval '2 minutes');

SELECT is(
    prune_used_password_reset_tokens(),
    1::bigint,
    'registered pruner removes exactly the consumed hash past the default window'
);
SELECT is_empty(
    'SELECT 1 FROM used_password_reset_tokens WHERE token_hash = ''old-token''',
    'expired token was pruned'
);
SELECT ok(
    EXISTS (SELECT 1 FROM used_password_reset_tokens WHERE token_hash = 'fresh-token'),
    'fresh tombstone inside the window survives'
);
SELECT ok(
    EXISTS (SELECT 1 FROM used_password_reset_tokens WHERE token_hash = 'abc123'),
    'untouched tombstone from the uniqueness arm survives'
);

-- 6. An explicit NULL window resolves to the same built-in default.
INSERT INTO used_password_reset_tokens (token_hash, created_at)
VALUES ('null-window-token', now() - interval '11 minutes');
SELECT is(
    prune_used_password_reset_tokens(NULL),
    1::bigint,
    'NULL window resolves to the built-in 10-minute default'
);
SELECT is_empty(
    'SELECT 1 FROM used_password_reset_tokens WHERE token_hash = ''null-window-token''',
    'NULL-window sweep pruned the stale tombstone'
);

-- 7. Destructive-parameter guard: a window below the reset-token JWT's
--    5-minute validity would delete tombstones whose JWTs could still
--    replay — refused, BZ040 (cron-prune family invalidArguments).
SELECT throws_ok(
    'SELECT prune_used_password_reset_tokens(interval ''1 minute'')',
    'BZ040'
);

-- 8. Boundary: a window exactly at the validity floor is accepted and, with
--    only in-window rows remaining, deletes nothing.
SELECT is(
    prune_used_password_reset_tokens(interval '5 minutes'),
    0::bigint,
    'window exactly at the 5-minute validity is accepted and deletes nothing'
);

SELECT * FROM finish();
ROLLBACK;
