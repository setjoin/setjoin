-- pgTAP test: push_mfa_challenges constraints, defaults, and expiry queries.
BEGIN;
SELECT plan(6);

-- Setup: create a test user
DO $$
BEGIN
    PERFORM mk_auth_user('push-test@test.local', 'x', 'Push Test');
END;
$$;

-- Test 1: expires_at NOT NULL constraint enforced (23502 = not_null_violation)
SELECT throws_ok(
    $sql$INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at)
         VALUES ((SELECT id FROM users WHERE email = 'push-test@test.local'),
                 '42', '\x01020304', NULL)$sql$,
    '23502', NULL,
    'expires_at NOT NULL constraint enforced');

-- Test 2: failed_attempts defaults to 0, created_at defaults to now()
DO $$
DECLARE
    v_uid       BIGINT;
BEGIN
    v_uid := mk_auth_user('push-defaults@test.local', 'x', 'Defaults Test');

    INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at)
    VALUES (v_uid, '99', '\x05060708', now() + interval '2 minutes');
END;
$$;
SELECT ok(
    (SELECT failed_attempts = 0 AND created_at IS NOT NULL
     FROM push_mfa_challenges
     WHERE user_id = (SELECT id FROM users WHERE email = 'push-defaults@test.local')),
    'failed_attempts defaults to 0, created_at defaults to now()');

-- Test 3: Insert with session_id=NULL succeeds
DO $$
BEGIN
    PERFORM mk_auth_user('push-null-session@test.local', 'x', 'Null Session');
END;
$$;
SELECT lives_ok(
    $sql$INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at, session_id)
         VALUES ((SELECT id FROM users WHERE email = 'push-null-session@test.local'),
                 '55', '\x0a0b0c0d', now() + interval '1 minute', NULL)$sql$,
    'insert with session_id=NULL succeeds');

-- Test 4: expired + unverified challenges identified correctly
DO $$
DECLARE
    v_uid       BIGINT;
BEGIN
    v_uid := mk_auth_user('push-expiry@test.local', 'x', 'Expiry Test');

    -- Create an expired unverified challenge
    INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at)
    VALUES (v_uid, '11', '\x01020304', now() - interval '5 minutes');

    -- Create an active unverified challenge
    INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at)
    VALUES (v_uid, '22', '\x05060708', now() + interval '5 minutes');

END;
$$;
SELECT is(
    (SELECT ARRAY[COUNT(*) FILTER (WHERE expires_at < now()),
                  COUNT(*) FILTER (WHERE expires_at > now())]::INT[]
     FROM push_mfa_challenges
     WHERE user_id = (SELECT id FROM users WHERE email = 'push-expiry@test.local')
       AND verified_at IS NULL),
    ARRAY[1, 1],
    'expired and active challenges are correctly distinguishable');

-- Test 5: verified challenges excluded from unverified queries
DO $$
DECLARE
    v_uid       BIGINT;
BEGIN
    v_uid := mk_auth_user('push-verified@test.local', 'x', 'Verified Test');

    -- Create a verified challenge (already used)
    INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at, verified_at)
    VALUES (v_uid, '33', '\x01020304', now() + interval '10 minutes', now());
END;
$$;
SELECT is(
    (SELECT COUNT(*)::INT FROM push_mfa_challenges
     WHERE user_id = (SELECT id FROM users WHERE email = 'push-verified@test.local')
       AND expires_at > now() AND verified_at IS NULL),
    0,
    'verified challenges excluded from unverified queries');

-- Test 6: 3 failed_attempts detectable via SQL
DO $$
DECLARE
    v_uid   BIGINT;
BEGIN
    v_uid := mk_auth_user('push-failed@test.local', 'x', 'Failed Test');

    INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at, failed_attempts)
    VALUES (v_uid, '44', '\x01020304', now() + interval '2 minutes', 3);
END;
$$;
SELECT is(
    (SELECT COUNT(*)::INT FROM push_mfa_challenges
     WHERE user_id = (SELECT id FROM users WHERE email = 'push-failed@test.local')
       AND failed_attempts >= 3 AND verified_at IS NULL),
    1,
    '3 failed_attempts detectable via SQL');

SELECT * FROM finish();
ROLLBACK;
