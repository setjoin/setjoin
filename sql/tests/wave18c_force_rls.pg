SELECT is((SELECT count(*)::int FROM user_app_entitlements WHERE user_id IN (SELECT v FROM _w18c WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own user_app_entitlements');
SELECT is((SELECT count(*)::int FROM user_smime_certs WHERE id IN (SELECT v FROM _w18c WHERE k IN ('usc_a','usc_b'))), 1, 'tenant A: sees only own user_smime_certs');
SELECT is((SELECT count(*)::int FROM recipient_smime_certs WHERE id IN (SELECT v FROM _w18c WHERE k IN ('rsc_a','rsc_b'))), 1, 'tenant A: sees only own recipient_smime_certs');
