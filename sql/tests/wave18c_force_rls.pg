  0,
  'non-widening: manage_calendar delegate Carol sees 0 of Alice contacts'
);
SELECT is(
  (SELECT count(*)::int FROM messages WHERE id = (SELECT v FROM _w18c WHERE k = 'msg_a')),
  0,
  'non-widening: manage_calendar delegate Carol sees 0 of Alice messages'
);

