-- pgTAP: wave18c_force_rls.pg
-- Wave 1.8 Phase 546d (`V288__wave18c_root_auth_force_rls.sql`) proof:
--   1. All 20 Wave C root/auth tables have BOTH relrowsecurity AND relforcerowsecurity.
--   2. `resolve_identity(text)` is SECURITY DEFINER owned by `setjoin_worker`, fails closed
--      without an active caller GUC under `setjoin_app`, and resolves colleagues with an active GUC.
--   3. Divergent user_id != mailbox_id fixtures (`mk_account`) under SET LOCAL ROLE setjoin_app:
--      - Unset GUCs fail closed (0 rows visible on SELECT across all 20 tables).
--      - Nullable scope columns (`mailboxes.user_id IS NULL` shared/group mailbox,
--        `oidc_auth_requests.user_id IS NULL` pre-login request,
--        `webhook_subscriptions.user_id IS NULL` org webhook) fail closed under setjoin_app.
--      - Divergent ID trap: setting app.current_mailbox_id = user_id sees 0 rows on `mailboxes`.
--      - Tenant A sees ONLY Tenant A rows and CANNOT SELECT, INSERT, UPDATE, or DELETE
--        Tenant B rows across all 20 tables.
--      - `mailbox_delegates` (V090) <-> `mailboxes` (V288) mutual RLS recursion is broken via
--        worker-owned `rls_mailbox_delegate_for_current_user`: delegate Carol (`manage_calendar`)
--        can read Alice's `mailboxes` row without infinite recursion and CANNOT read Alice's
--        `rules`, `contacts`, or `messages` (non-widening proof).
--      - App-callable Wave 1.8d reducers enforce `p_user_id <-> app.current_user_id` GUC binding
--        (rejecting forged `p_user_id` with 42501); worker-only reducers reject `setjoin_app`
--        with 42501 (`EXECUTE` revoked + `rls_caller_is_privileged()` backstop).
--      - Positive same-tenant ALLOW-flow proofs for all 20 tables under SET LOCAL ROLE setjoin_app.

BEGIN;
SELECT plan(122);

-- ── 1) Structural check: all 20 Wave C tables have ENABLE + FORCE RLS ───────
SELECT is(
  (SELECT count(*)::int
     FROM pg_class c
     JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname = 'public'
    WHERE c.relname IN (
      'mailboxes','users','sessions','app_passwords','oauth_tokens',
      'oidc_auth_requests','oidc_tokens','passkey_credentials','password_history',
      'push_devices','push_mfa_challenges','mfa_reauth_step_ups',
      'totp_pending_enrollments','totp_removal_step_ups','webauthn_ceremonies',
      'user_app_entitlements','user_smime_certs','recipient_smime_certs',
      'webhook_subscriptions','ws_subscriptions'
    )
      AND c.relrowsecurity = true
      AND c.relforcerowsecurity = true),
  20,
  'V288: all 20 Wave C root/auth tables have ENABLE + FORCE ROW LEVEL SECURITY'
);

-- Verify resolve_identity(text) is SECURITY DEFINER owned by setjoin_worker.
SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
     JOIN pg_authid r ON r.oid = p.proowner
    WHERE p.proname = 'resolve_identity'
      AND p.prosecdef = true
      AND r.rolname = 'setjoin_worker'),
  1,
  'V288: resolve_identity(text) is SECURITY DEFINER owned by setjoin_worker'
);

-- Empty users table under unscoped setjoin_app: system_has_users() returns false (rolled-back subtx)
SELECT lives_ok($$
  DO $p$
  DECLARE
    v_has boolean;
  BEGIN
    BEGIN
      TRUNCATE public.users CASCADE;
      SET LOCAL ROLE setjoin_app;
      PERFORM set_config('app.current_user_id', '', true);
      PERFORM set_config('app.current_mailbox_id', '', true);
      v_has := public.system_has_users();
      IF v_has IS DISTINCT FROM false THEN
        RAISE EXCEPTION 'expected system_has_users() = false on empty users, got %', v_has;
      END IF;
      RAISE EXCEPTION '__w18c_empty_users_ok';
    EXCEPTION WHEN OTHERS THEN
      IF SQLERRM <> '__w18c_empty_users_ok' THEN
        RAISE;
      END IF;
    END;
  END $p$;
$$, 'V288: system_has_users() returns false under unscoped setjoin_app when public.users is empty');

-- ── 2) Seed two divergent-ID tenants (A & B) plus delegate (C) as superuser ─
CREATE TEMP TABLE _w18c (
  k text PRIMARY KEY,
  v bigint NOT NULL
);
CREATE TEMP TABLE _w18c_txt (
  k text PRIMARY KEY,
  v text NOT NULL
);

DO $$
DECLARE
  v_mb_a   bigint := mk_account('w18c-alice');
  v_mb_b   bigint := mk_account('w18c-bob');
  v_mb_c   bigint := mk_account('w18c-carol');
  v_u_a    bigint; v_u_b  bigint; v_u_c  bigint;
  v_d_a    bigint; v_d_b  bigint;
  v_mb_null bigint;
  v_ap_a   bigint; v_ap_b bigint;
  v_ot_a   bigint; v_ot_b bigint;
  v_ph_a   bigint; v_ph_b bigint;
  v_pd_a   bigint; v_pd_b bigint;
  v_pm_a   bigint; v_pm_b bigint;
  v_usc_a  bigint; v_usc_b bigint;
  v_rsc_a  bigint; v_rsc_b bigint;
  v_wh_a   bigint; v_wh_b bigint; v_wh_null bigint;
  v_tpe_a  uuid;   v_tpe_b uuid;
  v_rl_a   bigint;
  v_ab_a   bigint; v_ct_a bigint;
  v_fld_a  bigint; v_msg_a bigint;
BEGIN
  SELECT user_id, domain_id INTO v_u_a, v_d_a FROM mailboxes WHERE id = v_mb_a;
  SELECT user_id, domain_id INTO v_u_b, v_d_b FROM mailboxes WHERE id = v_mb_b;
  SELECT user_id INTO v_u_c FROM mailboxes WHERE id = v_mb_c;

  IF v_u_a = v_mb_a OR v_u_b = v_mb_b OR v_u_c = v_mb_c THEN
    RAISE EXCEPTION 'expected divergent user_id != mailbox_id';
  END IF;

  -- Nullable user_id mailbox (shared/group mailbox without user owner)
  INSERT INTO mailboxes (user_id, domain_id, email, type, is_primary, display_name)
  VALUES (NULL, v_d_a, 'w18c-shared-null@mk.test', 'personal', false, 'W18C Shared Null')
  RETURNING id INTO v_mb_null;

  -- Delegate Carol with manage_calendar ONLY on Alice's mailbox (recursion + non-widening test)
  INSERT INTO mailbox_delegates (mailbox_id, user_id, permission, granted_by)
  VALUES (v_mb_a, v_u_c, 'manage_calendar', v_u_a) ON CONFLICT DO NOTHING;

  -- Seed Alice's rules, contacts, messages to prove manage_calendar delegate cannot read them
  INSERT INTO rules (mailbox_id, name, is_transport_rule)
  VALUES (v_mb_a, 'W18C Alice Rule', false) RETURNING id INTO v_rl_a;
  INSERT INTO addressbooks (mailbox_id, name)
  VALUES (v_mb_a, 'W18C Alice AB') RETURNING id INTO v_ab_a;
  INSERT INTO contacts (addressbook_id, vcard_uid, display_name)
  VALUES (v_ab_a, 'w18c-ct-a', 'Alice Secret Contact') RETURNING id INTO v_ct_a;
  INSERT INTO folders (mailbox_id, name, path)
  VALUES (v_mb_a, 'W18C-Inbox', 'W18C-Inbox') RETURNING id INTO v_fld_a;
  INSERT INTO messages (mailbox_id, folder_id, message_id, subject, from_addr, to_addrs, size_bytes, thread_id, raw_ref, received_at)
  VALUES (v_mb_a, v_fld_a, '<w18c-msg-a@mk.test>', 'Alice Secret Mail', 'a@mk.test', '[]'::jsonb, 10, 'thr-w18c-a', 'raw/w18c-a', now())
  RETURNING id INTO v_msg_a;

  -- 3. sessions
  INSERT INTO sessions (id, user_id, expires_at) VALUES ('w18c-sess-a', v_u_a, now() + interval '1 hour');
  INSERT INTO sessions (id, user_id, expires_at) VALUES ('w18c-sess-b', v_u_b, now() + interval '1 hour');

  -- 4. app_passwords
  INSERT INTO app_passwords (user_id, name, token_hash) VALUES (v_u_a, 'ap-a', 'hash-a') RETURNING id INTO v_ap_a;
  INSERT INTO app_passwords (user_id, name, token_hash) VALUES (v_u_b, 'ap-b', 'hash-b') RETURNING id INTO v_ap_b;

  -- 5. oauth_tokens
  INSERT INTO oauth_tokens (user_id, token_hash, token_type) VALUES (v_u_a, '\xaa01'::bytea, 'refresh') RETURNING id INTO v_ot_a;
  INSERT INTO oauth_tokens (user_id, token_hash, token_type) VALUES (v_u_b, '\xbb01'::bytea, 'refresh') RETURNING id INTO v_ot_b;

  -- 6. oidc_auth_requests (including NULL user_id pre-login row)
  INSERT INTO oidc_clients (id, name, secret, redirect_uris)
  VALUES ('cli', 'W18C Client', 'sec', ARRAY['https://a.test/cb','https://b.test/cb','https://n.test/cb'])
  ON CONFLICT DO NOTHING;
  INSERT INTO oidc_auth_requests (id, client_id, redirect_uri, state, scopes, user_id)
  VALUES ('w18c-oar-a', 'cli', 'https://a.test/cb', 'st-a', ARRAY['openid'], v_u_a);
  INSERT INTO oidc_auth_requests (id, client_id, redirect_uri, state, scopes, user_id)
  VALUES ('w18c-oar-b', 'cli', 'https://b.test/cb', 'st-b', ARRAY['openid'], v_u_b);
  INSERT INTO oidc_auth_requests (id, client_id, redirect_uri, state, scopes, user_id)
  VALUES ('w18c-oar-null', 'cli', 'https://n.test/cb', 'st-n', ARRAY['openid'], NULL);

  -- 7. oidc_tokens
  INSERT INTO oidc_tokens (id, client_id, user_id, subject, scopes, expires_at)
  VALUES ('w18c-oidct-a', 'cli', v_u_a, 'sub-a', ARRAY['openid'], now() + interval '1 hour');
  INSERT INTO oidc_tokens (id, client_id, user_id, subject, scopes, expires_at)
  VALUES ('w18c-oidct-b', 'cli', v_u_b, 'sub-b', ARRAY['openid'], now() + interval '1 hour');

  -- 8. passkey_credentials
  INSERT INTO passkey_credentials (id, user_id, public_key, device_name)
  VALUES ('\x01aa'::bytea, v_u_a, '\x1111'::bytea, 'Key A');
  INSERT INTO passkey_credentials (id, user_id, public_key, device_name)
  VALUES ('\x01bb'::bytea, v_u_b, '\x2222'::bytea, 'Key B');

  -- 9. password_history
  INSERT INTO password_history (user_id, password_hash) VALUES (v_u_a, '$argon2id$a') RETURNING id INTO v_ph_a;
  INSERT INTO password_history (user_id, password_hash) VALUES (v_u_b, '$argon2id$b') RETURNING id INTO v_ph_b;

  -- 10. push_devices
  INSERT INTO push_devices (user_id, push_provider, push_token_enc, device_name)
  VALUES (v_u_a, 'fcm', '\xaa'::bytea, 'Phone A') RETURNING id INTO v_pd_a;
  INSERT INTO push_devices (user_id, push_provider, push_token_enc, device_name)
  VALUES (v_u_b, 'fcm', '\xbb'::bytea, 'Phone B') RETURNING id INTO v_pd_b;

  -- 11. push_mfa_challenges
  INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at)
  VALUES (v_u_a, '12', '\xaa'::bytea, now() + interval '5 minutes') RETURNING id INTO v_pm_a;
  INSERT INTO push_mfa_challenges (user_id, challenge_code, nonce, expires_at)
  VALUES (v_u_b, '34', '\xbb'::bytea, now() + interval '5 minutes') RETURNING id INTO v_pm_b;

  -- 12. mfa_reauth_step_ups
  INSERT INTO mfa_reauth_step_ups (token_hash, user_id, session_jti, expires_at, operation, proof_method, bound_factor_generation)
  VALUES ('w18c-mrs-a', v_u_a, 'jti-a', now() + interval '5 minutes', 'totp', 'password', 1);
  INSERT INTO mfa_reauth_step_ups (token_hash, user_id, session_jti, expires_at, operation, proof_method, bound_factor_generation)
  VALUES ('w18c-mrs-b', v_u_b, 'jti-b', now() + interval '5 minutes', 'totp', 'password', 1);

  -- 13. totp_pending_enrollments
  INSERT INTO totp_pending_enrollments (user_id, secret_enc, staged_by_jti, expires_at)
  VALUES (v_u_a, '\xaa'::bytea, 'jti-a', now() + interval '5 minutes') RETURNING id INTO v_tpe_a;
  INSERT INTO totp_pending_enrollments (user_id, secret_enc, staged_by_jti, expires_at)
  VALUES (v_u_b, '\xbb'::bytea, 'jti-b', now() + interval '5 minutes') RETURNING id INTO v_tpe_b;

  -- 14. totp_removal_step_ups
  INSERT INTO totp_removal_step_ups (token_hash, user_id, session_jti, expires_at)
  VALUES ('w18c-trs-a', v_u_a, 'jti-a', now() + interval '5 minutes');
  INSERT INTO totp_removal_step_ups (token_hash, user_id, session_jti, expires_at)
  VALUES ('w18c-trs-b', v_u_b, 'jti-b', now() + interval '5 minutes');

  -- 15. webauthn_ceremonies
  INSERT INTO webauthn_ceremonies (challenge_hash, user_id, kind, operation, session_jti, expires_at)
  VALUES ('w18c-wc-a', v_u_a, 'management_assertion', 'login', 'jti-a', now() + interval '5 minutes');
  INSERT INTO webauthn_ceremonies (challenge_hash, user_id, kind, operation, session_jti, expires_at)
  VALUES ('w18c-wc-b', v_u_b, 'management_assertion', 'login', 'jti-b', now() + interval '5 minutes');

  -- 16. user_app_entitlements
  INSERT INTO user_app_entitlements (user_id, app, enabled) VALUES (v_u_a, 'mail', true) ON CONFLICT DO NOTHING;
  INSERT INTO user_app_entitlements (user_id, app, enabled) VALUES (v_u_b, 'mail', true) ON CONFLICT DO NOTHING;

  -- 17. user_smime_certs
  INSERT INTO user_smime_certs (user_id, label, cert_pem)
  VALUES (v_u_a, 'Cert A', '-----BEGIN CERTIFICATE-----A') RETURNING id INTO v_usc_a;
  INSERT INTO user_smime_certs (user_id, label, cert_pem)
  VALUES (v_u_b, 'Cert B', '-----BEGIN CERTIFICATE-----B') RETURNING id INTO v_usc_b;

  -- 18. recipient_smime_certs
  INSERT INTO recipient_smime_certs (owner_user_id, email, cert_pem, fingerprint, source)
  VALUES (v_u_a, 'ext-a@mk.test', '-----BEGIN CERTIFICATE-----RA', 'fp-a', 'imported') RETURNING id INTO v_rsc_a;
  INSERT INTO recipient_smime_certs (owner_user_id, email, cert_pem, fingerprint, source)
  VALUES (v_u_b, 'ext-b@mk.test', '-----BEGIN CERTIFICATE-----RB', 'fp-b', 'imported') RETURNING id INTO v_rsc_b;

  -- 19. webhook_subscriptions (including NULL user_id org webhook)
  INSERT INTO webhook_subscriptions (user_id, url, scope)
  VALUES (v_u_a, 'https://a.test/hook', 'self') RETURNING id INTO v_wh_a;
  INSERT INTO webhook_subscriptions (user_id, url, scope)
  VALUES (v_u_b, 'https://b.test/hook', 'self') RETURNING id INTO v_wh_b;
  INSERT INTO webhook_subscriptions (user_id, url, scope)
  VALUES (NULL, 'https://org.test/hook', 'organization') RETURNING id INTO v_wh_null;

  -- 20. ws_subscriptions
  INSERT INTO ws_subscriptions (connection_id, session_id, user_id)
  VALUES ('w18c-ws-a', 'w18c-sess-a', v_u_a);
  INSERT INTO ws_subscriptions (connection_id, session_id, user_id)
  VALUES ('w18c-ws-b', 'w18c-sess-b', v_u_b);

  INSERT INTO _w18c VALUES
    ('mb_a', v_mb_a), ('mb_b', v_mb_b), ('mb_c', v_mb_c), ('mb_null', v_mb_null),
    ('u_a', v_u_a), ('u_b', v_u_b), ('u_c', v_u_c),
    ('d_a', v_d_a), ('d_b', v_d_b),
    ('ap_a', v_ap_a), ('ap_b', v_ap_b),
    ('ot_a', v_ot_a), ('ot_b', v_ot_b),
    ('ph_a', v_ph_a), ('ph_b', v_ph_b),
    ('pd_a', v_pd_a), ('pd_b', v_pd_b),
    ('pm_a', v_pm_a), ('pm_b', v_pm_b),
    ('usc_a', v_usc_a), ('usc_b', v_usc_b),
    ('rsc_a', v_rsc_a), ('rsc_b', v_rsc_b),
    ('wh_a', v_wh_a), ('wh_b', v_wh_b), ('wh_null', v_wh_null),
    ('rl_a', v_rl_a), ('ct_a', v_ct_a), ('msg_a', v_msg_a);
  INSERT INTO _w18c_txt VALUES
    ('tpe_a', v_tpe_a::text), ('tpe_b', v_tpe_b::text),
    ('email_b', (SELECT email FROM users WHERE id = v_u_b));
END $$;

GRANT SELECT ON _w18c, _w18c_txt TO setjoin_app;

-- ── 3) Switch to setjoin_app (NOSUPERUSER NOBYPASSRLS) with UNSET GUCs ──────
SET LOCAL ROLE setjoin_app;
SELECT set_config('app.current_user_id', '', true);
SELECT set_config('app.current_mailbox_id', '', true);

SELECT is((SELECT count(*)::int FROM mailboxes WHERE id IN (SELECT v FROM _w18c WHERE k IN ('mb_a','mb_b','mb_null'))), 0, 'unset GUC: mailboxes fail-closed');
SELECT is((SELECT count(*)::int FROM users WHERE id IN (SELECT v FROM _w18c WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: users fail-closed');
SELECT is((SELECT count(*)::int FROM sessions WHERE id IN ('w18c-sess-a','w18c-sess-b')), 0, 'unset GUC: sessions fail-closed');
SELECT is((SELECT count(*)::int FROM app_passwords WHERE id IN (SELECT v FROM _w18c WHERE k IN ('ap_a','ap_b'))), 0, 'unset GUC: app_passwords fail-closed');
SELECT is((SELECT count(*)::int FROM oauth_tokens WHERE id IN (SELECT v FROM _w18c WHERE k IN ('ot_a','ot_b'))), 0, 'unset GUC: oauth_tokens fail-closed');
SELECT is((SELECT count(*)::int FROM oidc_auth_requests WHERE id IN ('w18c-oar-a','w18c-oar-b','w18c-oar-null')), 0, 'unset GUC: oidc_auth_requests fail-closed');
SELECT is((SELECT count(*)::int FROM oidc_tokens WHERE id IN ('w18c-oidct-a','w18c-oidct-b')), 0, 'unset GUC: oidc_tokens fail-closed');
SELECT is((SELECT count(*)::int FROM passkey_credentials WHERE id IN ('\x01aa'::bytea,'\x01bb'::bytea)), 0, 'unset GUC: passkey_credentials fail-closed');
SELECT is((SELECT count(*)::int FROM password_history WHERE id IN (SELECT v FROM _w18c WHERE k IN ('ph_a','ph_b'))), 0, 'unset GUC: password_history fail-closed');
SELECT is((SELECT count(*)::int FROM push_devices WHERE id IN (SELECT v FROM _w18c WHERE k IN ('pd_a','pd_b'))), 0, 'unset GUC: push_devices fail-closed');
SELECT is((SELECT count(*)::int FROM push_mfa_challenges WHERE id IN (SELECT v FROM _w18c WHERE k IN ('pm_a','pm_b'))), 0, 'unset GUC: push_mfa_challenges fail-closed');
SELECT is((SELECT count(*)::int FROM mfa_reauth_step_ups WHERE token_hash IN ('w18c-mrs-a','w18c-mrs-b')), 0, 'unset GUC: mfa_reauth_step_ups fail-closed');
SELECT is((SELECT count(*)::int FROM totp_pending_enrollments WHERE id::text IN (SELECT v FROM _w18c_txt WHERE k IN ('tpe_a','tpe_b'))), 0, 'unset GUC: totp_pending_enrollments fail-closed');
SELECT is((SELECT count(*)::int FROM totp_removal_step_ups WHERE token_hash IN ('w18c-trs-a','w18c-trs-b')), 0, 'unset GUC: totp_removal_step_ups fail-closed');
SELECT is((SELECT count(*)::int FROM webauthn_ceremonies WHERE challenge_hash IN ('w18c-wc-a','w18c-wc-b')), 0, 'unset GUC: webauthn_ceremonies fail-closed');
SELECT is((SELECT count(*)::int FROM user_app_entitlements WHERE user_id IN (SELECT v FROM _w18c WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: user_app_entitlements fail-closed');
SELECT is((SELECT count(*)::int FROM user_smime_certs WHERE id IN (SELECT v FROM _w18c WHERE k IN ('usc_a','usc_b'))), 0, 'unset GUC: user_smime_certs fail-closed');
SELECT is((SELECT count(*)::int FROM recipient_smime_certs WHERE id IN (SELECT v FROM _w18c WHERE k IN ('rsc_a','rsc_b'))), 0, 'unset GUC: recipient_smime_certs fail-closed');
SELECT is((SELECT count(*)::int FROM webhook_subscriptions WHERE id IN (SELECT v FROM _w18c WHERE k IN ('wh_a','wh_b','wh_null'))), 0, 'unset GUC: webhook_subscriptions fail-closed');
SELECT is((SELECT count(*)::int FROM ws_subscriptions WHERE connection_id IN ('w18c-ws-a','w18c-ws-b')), 0, 'unset GUC: ws_subscriptions fail-closed');

-- resolve_identity fails closed under setjoin_app when no caller GUC is set.
SELECT is(
  (SELECT count(*)::int FROM resolve_identity((SELECT v FROM _w18c_txt WHERE k = 'email_b'))),
  0,
  'unset GUC: resolve_identity fails closed under setjoin_app'
);

-- ── 4) Divergent-ID trap: setting mailbox GUC to user_id (without user GUC) sees 0 mailboxes ──
SELECT set_config('app.current_user_id', '', true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18c WHERE k = 'u_a'), true);
SELECT is((SELECT count(*)::int FROM mailboxes WHERE id = (SELECT v FROM _w18c WHERE k = 'mb_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 mailboxes');

-- ── 5) Tenant A scope (user_id=u_a, mailbox_id=mb_a) ────────────────────────
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18c WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18c WHERE k = 'mb_a'), true);

SELECT is((SELECT count(*)::int FROM mailboxes WHERE id IN (SELECT v FROM _w18c WHERE k IN ('mb_a','mb_b','mb_null'))), 1, 'tenant A: sees only own mailboxes (NULL user_id mailbox hidden)');
SELECT is((SELECT count(*)::int FROM users WHERE id IN (SELECT v FROM _w18c WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own users');
SELECT is((SELECT count(*)::int FROM sessions WHERE id IN ('w18c-sess-a','w18c-sess-b')), 1, 'tenant A: sees only own sessions');
SELECT is((SELECT count(*)::int FROM app_passwords WHERE id IN (SELECT v FROM _w18c WHERE k IN ('ap_a','ap_b'))), 1, 'tenant A: sees only own app_passwords');
SELECT is((SELECT count(*)::int FROM oauth_tokens WHERE id IN (SELECT v FROM _w18c WHERE k IN ('ot_a','ot_b'))), 1, 'tenant A: sees only own oauth_tokens');
SELECT is((SELECT count(*)::int FROM oidc_auth_requests WHERE id IN ('w18c-oar-a','w18c-oar-b','w18c-oar-null')), 1, 'tenant A: sees only own oidc_auth_requests (NULL pre-login hidden)');
SELECT is((SELECT count(*)::int FROM oidc_tokens WHERE id IN ('w18c-oidct-a','w18c-oidct-b')), 1, 'tenant A: sees only own oidc_tokens');
SELECT is((SELECT count(*)::int FROM passkey_credentials WHERE id IN ('\x01aa'::bytea,'\x01bb'::bytea)), 1, 'tenant A: sees only own passkey_credentials');
SELECT is((SELECT count(*)::int FROM password_history WHERE id IN (SELECT v FROM _w18c WHERE k IN ('ph_a','ph_b'))), 1, 'tenant A: sees only own password_history');
SELECT is((SELECT count(*)::int FROM push_devices WHERE id IN (SELECT v FROM _w18c WHERE k IN ('pd_a','pd_b'))), 1, 'tenant A: sees only own push_devices');
SELECT is((SELECT count(*)::int FROM push_mfa_challenges WHERE id IN (SELECT v FROM _w18c WHERE k IN ('pm_a','pm_b'))), 1, 'tenant A: sees only own push_mfa_challenges');
SELECT is((SELECT count(*)::int FROM mfa_reauth_step_ups WHERE token_hash IN ('w18c-mrs-a','w18c-mrs-b')), 1, 'tenant A: sees only own mfa_reauth_step_ups');
SELECT is((SELECT count(*)::int FROM totp_pending_enrollments WHERE id::text IN (SELECT v FROM _w18c_txt WHERE k IN ('tpe_a','tpe_b'))), 1, 'tenant A: sees only own totp_pending_enrollments');
SELECT is((SELECT count(*)::int FROM totp_removal_step_ups WHERE token_hash IN ('w18c-trs-a','w18c-trs-b')), 1, 'tenant A: sees only own totp_removal_step_ups');
