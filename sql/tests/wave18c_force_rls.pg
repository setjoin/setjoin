  BEGIN
    INSERT INTO webauthn_ceremonies (challenge_hash, user_id, kind, operation, session_jti, expires_at)
    VALUES ('w18c-allow-wc', (SELECT v FROM _w18c WHERE k = 'u_a'), 'management_assertion', 'login', 'jti-a', now() + interval '5 minutes');
    UPDATE webauthn_ceremonies SET target_ref = 'y' WHERE challenge_hash = 'w18c-allow-wc';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'webauthn_ceremonies UPDATE affected % rows', v_cnt; END IF;
    DELETE FROM webauthn_ceremonies WHERE challenge_hash = 'w18c-allow-wc';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'webauthn_ceremonies DELETE affected % rows', v_cnt; END IF;
  END $p$;
$$, 'ALLOW webauthn_ceremonies: setjoin_app INSERT/UPDATE/DELETE own ceremony succeeds');

-- 16. user_app_entitlements ALLOW (SELECT-only for setjoin_app; admin writes on worker)
SELECT is(
  (SELECT count(*)::int FROM user_app_entitlements WHERE user_id = (SELECT v FROM _w18c WHERE k = 'u_a') AND app = 'mail'),
  1,
  'ALLOW user_app_entitlements: setjoin_app SELECT own entitlement succeeds'
);

