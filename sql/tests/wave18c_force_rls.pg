-- 19. webhook_subscriptions ALLOW (via rust_webhook_self_create/delete)
SELECT lives_ok($$
  DO $p$
  DECLARE v_id bigint; v_cnt int;
  BEGIN
    v_id := rust_webhook_self_create(
      (SELECT v FROM _w18c WHERE k = 'u_a'),
      'https://allow.test/hook', '["mail.received"]', NULL, NULL
    );
    UPDATE webhook_subscriptions SET is_active = false WHERE id = v_id;
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'webhook_subscriptions UPDATE affected % rows', v_cnt; END IF;
    IF NOT rust_webhook_self_delete((SELECT v FROM _w18c WHERE k = 'u_a'), v_id) THEN
      RAISE EXCEPTION 'rust_webhook_self_delete returned false';
    END IF;
  END $p$;
$$, 'ALLOW webhook_subscriptions: setjoin_app INSERT/UPDATE/DELETE own subscription succeeds');

-- 20. ws_subscriptions ALLOW
SELECT lives_ok($$
  DO $p$
  DECLARE v_cnt int;
  BEGIN
    INSERT INTO ws_subscriptions (connection_id, session_id, user_id)
    VALUES ('w18c-allow-ws', 'w18c-sess-a', (SELECT v FROM _w18c WHERE k = 'u_a'));
    UPDATE ws_subscriptions SET last_ping_at = now() WHERE connection_id = 'w18c-allow-ws';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'ws_subscriptions UPDATE affected % rows', v_cnt; END IF;
    DELETE FROM ws_subscriptions WHERE connection_id = 'w18c-allow-ws';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'ws_subscriptions DELETE affected % rows', v_cnt; END IF;
  END $p$;
$$, 'ALLOW ws_subscriptions: setjoin_app INSERT/UPDATE/DELETE own subscription succeeds');

-- ── 10) Review hardening proofs: ARCH-018 3VL, webhook scope='self', V249 triggers, catalog ACLs ──

-- 10a. Catalog-level EXECUTE revocation on worker-only Wave 1.8d reducers
SELECT is(
  has_function_privilege('setjoin_app', 'public.rust_mailbox_admin_set_quota(bigint,bigint,bigint,integer)', 'EXECUTE'),
  false,
  'catalog ACL: setjoin_app lacks EXECUTE on rust_mailbox_admin_set_quota'
);
SELECT is(
  has_function_privilege('setjoin_app', 'public.rust_system_config_upsert_batch_encrypted(text[],text[],boolean[],text)', 'EXECUTE'),
  false,
  'catalog ACL: setjoin_app lacks EXECUTE on rust_system_config_upsert_batch_encrypted'
);
SELECT is(
  has_function_privilege('setjoin_app', 'public.rust_ca_policy_soft_delete(bigint,bigint)', 'EXECUTE'),
  false,
  'catalog ACL: setjoin_app lacks EXECUTE on rust_ca_policy_soft_delete'
);
SELECT is(
  has_function_privilege('setjoin_app', 'public.rust_compliance_content_search_kql(text,text[])', 'EXECUTE'),
  false,
  'catalog ACL: setjoin_app lacks EXECUTE on rust_compliance_content_search_kql'
);

-- 10b. webhook_subscriptions scope='self' enforcement & users least-privilege (no DELETE under setjoin_app)
SELECT throws_ok(
  $$INSERT INTO webhook_subscriptions (user_id, url, scope) VALUES ((SELECT v FROM _w18c WHERE k = 'u_a'), 'https://org-esc.test/hook', 'organization')$$,
  '42501', NULL,
  'webhook_subscriptions: setjoin_app cannot INSERT scope=organization even with own user_id'
);
SELECT throws_ok(
  $$UPDATE webhook_subscriptions SET scope = 'organization' WHERE id = (SELECT v FROM _w18c WHERE k = 'wh_a')$$,
  '42501', NULL,
  'webhook_subscriptions: setjoin_app cannot escalate own webhook to scope=organization'
);
WITH d AS (DELETE FROM users WHERE id = (SELECT v FROM _w18c WHERE k = 'u_a') RETURNING id)
SELECT is((SELECT count(*)::int FROM d), 0, 'users least privilege: setjoin_app DELETE own user affects 0 rows');

-- 10c. V249 identity-address admission triggers remain unblinded under V288 FORCE RLS
SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
     JOIN pg_roles r ON r.oid = p.proowner
    WHERE p.proname IN (
      'identity_address_admission_users',
      'identity_address_admission_aliases',
      'identity_address_admission_mailboxes'
    )
      AND p.prosecdef = true
      AND r.rolname = 'setjoin_worker'
      AND NOT has_function_privilege('setjoin_app', p.oid, 'EXECUTE')),
  3,
  'V249 triggers: all 3 admission trigger functions are worker-owned SECURITY DEFINER without setjoin_app EXECUTE'
);
SELECT throws_ok(
  $$UPDATE users SET ad_upn = (SELECT v FROM _w18c_txt WHERE k = 'email_b') WHERE id = (SELECT v FROM _w18c WHERE k = 'u_a')$$,
  'BZ328', NULL,
  'V249 trigger unblinded: setjoin_app UPDATE users.ad_upn to competing enabled user email raises BZ328'
);
SELECT throws_ok(
  $$UPDATE users SET email = (SELECT v FROM _w18c_txt WHERE k = 'email_b') WHERE id = (SELECT v FROM _w18c WHERE k = 'u_a')$$,
  'BZ328', NULL,
  'V249 trigger unblinded: setjoin_app UPDATE users.email to competing enabled user email raises BZ328'
);

-- 10d. ARCH-018 admin reach predicates: strict FALSE (never NULL) on unset GUC & forged p_actor
SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
     JOIN pg_roles r ON r.oid = p.proowner
    WHERE p.proname IN ('admin_can_reach','admin_can_manage_with_permission','admin_can_reach_perm')
      AND p.prosecdef = true
      AND r.rolname = 'setjoin_worker'),
  3,
  'ARCH-018 admin predicates: all 3 are SECURITY DEFINER owned by setjoin_worker'
);

-- Seed a global admin role assignment for Alice as owner, then test under setjoin_app
RESET ROLE;
INSERT INTO admin_role_assignments (user_id, role_group_id, granted_by)
VALUES ((SELECT v FROM _w18c WHERE k = 'u_a'), 1, (SELECT v FROM _w18c WHERE k = 'u_a'))
ON CONFLICT DO NOTHING;

SET LOCAL ROLE setjoin_app;
-- Unset GUC: all 3 must return strict FALSE (never NULL — zero 3VL enumeration oracle!)
SELECT set_config('app.current_user_id', '', true);
SELECT is(
  admin_can_reach((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b')),
  false,
  '3VL oracle closed: admin_can_reach returns strict false (not NULL) when app.current_user_id is unset'
);
SELECT is(
  admin_can_manage_with_permission((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b'), 'users.read'),
  false,
  '3VL oracle closed: admin_can_manage_with_permission returns strict false (not NULL) when app.current_user_id is unset'
);
SELECT is(
  admin_can_reach_perm((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b'), ARRAY['users.read']),
  false,
  '3VL oracle closed: admin_can_reach_perm returns strict false (not NULL) when app.current_user_id is unset'
);

-- Forged p_actor (Bob trying to probe Alice's reach): all 3 must return strict FALSE
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18c WHERE k = 'u_b'), true);
SELECT is(
  admin_can_reach((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b')),
  false,
  '3VL oracle closed: admin_can_reach returns strict false for forged p_actor'
);
SELECT is(
  admin_can_manage_with_permission((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b'), 'users.read'),
  false,
  '3VL oracle closed: admin_can_manage_with_permission returns strict false for forged p_actor'
);
SELECT is(
  admin_can_reach_perm((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b'), ARRAY['users.read']),
  false,
  '3VL oracle closed: admin_can_reach_perm returns strict false for forged p_actor'
);

-- Authentic Alice caller GUC: admin_can_reach returns true for Alice reaching Bob
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18c WHERE k = 'u_a'), true);
SELECT is(
  admin_can_reach((SELECT v FROM _w18c WHERE k = 'u_a'), (SELECT v FROM _w18c WHERE k = 'u_b')),
  true,
  'ARCH-018 positive: authentic Alice GUC evaluates admin_can_reach(u_a, u_b) = true under setjoin_app'
);

-- 10e. Public first-boot setup check `public.system_has_users()` under V288 FORCE RLS
-- + pg_temp search_path guard across all newly hardened V288 SECURITY DEFINER helpers.
SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
     JOIN pg_roles r ON r.oid = p.proowner
    WHERE p.proname = 'system_has_users'
      AND p.prosecdef = true
      AND r.rolname = 'setjoin_worker'
      AND has_function_privilege('setjoin_app', p.oid, 'EXECUTE')),
  1,
  'V288: system_has_users() is worker-owned SECURITY DEFINER callable by setjoin_app'
);

SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
    WHERE p.proname IN (
      'resolve_identity',
      'admin_can_reach',
      'admin_can_manage_with_permission',
      'admin_can_reach_perm',
      'identity_address_claims',
      'identity_address_admission_users',
      'identity_address_admission_aliases',
      'identity_address_admission_mailboxes',
      'system_has_users'
    )
      AND p.proconfig @> ARRAY['search_path=pg_catalog, public, pg_temp']),
  9,
  'V288: all 9 hardened identity/admin/setup helpers pin search_path = pg_catalog, public, pg_temp'
);

-- Unscoped setjoin_app on populated DB: users table returns 0 rows, system_has_users() returns true!
SELECT set_config('app.current_user_id', '', true);
SELECT set_config('app.current_mailbox_id', '', true);
SELECT is(
  public.system_has_users(),
  true,
  'V288: system_has_users() returns true under unscoped setjoin_app on populated DB (prevents / -> /setup loop)'
);

SELECT * FROM finish();
ROLLBACK;
