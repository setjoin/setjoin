-- ── 9) Positive same-tenant ALLOW-flow proofs for all 20 Wave C tables ──────
-- 1. users ALLOW (own-row UPDATE via rust_user_profile_update + read-back)
SELECT lives_ok($$
  DO $p$
  DECLARE v_dn text;
  BEGIN
    PERFORM rust_user_profile_update((SELECT v FROM _w18c WHERE k = 'u_a'), 'Alice Updated');
    SELECT display_name INTO v_dn FROM users WHERE id = (SELECT v FROM _w18c WHERE k = 'u_a');
    IF v_dn <> 'Alice Updated' THEN RAISE EXCEPTION 'users display_name readback mismatch: %', v_dn; END IF;
  END $p$;
$$, 'ALLOW users: setjoin_app UPDATE own profile succeeds');

-- 2. mailboxes ALLOW (own-row UPDATE + read-back)
SELECT lives_ok($$
  DO $p$
  DECLARE v_cnt int;
  BEGIN
    UPDATE mailboxes SET display_name = 'Alice Mailbox Updated' WHERE id = (SELECT v FROM _w18c WHERE k = 'mb_a');
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'mailboxes UPDATE affected % rows', v_cnt; END IF;
  END $p$;
$$, 'ALLOW mailboxes: setjoin_app UPDATE own mailbox succeeds');

-- 3. sessions ALLOW
SELECT lives_ok($$
  DO $p$
  DECLARE v_cnt int;
  BEGIN
    INSERT INTO sessions (id, user_id, expires_at) VALUES ('w18c-allow-s', (SELECT v FROM _w18c WHERE k = 'u_a'), now() + interval '1 hour');
    UPDATE sessions SET auth_method = 'password' WHERE id = 'w18c-allow-s';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'sessions UPDATE affected % rows', v_cnt; END IF;
    DELETE FROM sessions WHERE id = 'w18c-allow-s';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'sessions DELETE affected % rows', v_cnt; END IF;
  END $p$;
$$, 'ALLOW sessions: setjoin_app INSERT/UPDATE/DELETE own session succeeds');

