-- testMonthlyIntervalLarge
SELECT is(
    (SELECT array_agg(occ_start ORDER BY occ_start) FROM expand_recurrence(
        '1997-09-02 09:00:00+00', '1997-09-02 10:00:00+00',
        'FREQ=MONTHLY;INTERVAL=18;COUNT=3',
