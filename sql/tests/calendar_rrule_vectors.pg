-- testYearlyIntervalLarge
SELECT is(
    (SELECT array_agg(occ_start ORDER BY occ_start) FROM expand_recurrence(
        '1997-09-02 09:00:00+00', '1997-09-02 10:00:00+00',
        'FREQ=YEARLY;INTERVAL=100;COUNT=3',
        '-infinity', '2500-01-01 00:00:00+00'
    )),
    ARRAY[
        '1997-09-02 09:00:00+00', '2097-09-02 09:00:00+00',
        '2197-09-02 09:00:00+00'
    ]::TIMESTAMPTZ[],
    'testYearlyIntervalLarge'
