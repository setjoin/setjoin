{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setjoin.local/schema/connectivity-aware-sync-decision-v1.json",
  "title": "Setjoin connectivity-aware sync privacy-safe decision record",
  "description": "Schema-version-1 allowlist for normalized evidence explanations. High-cardinality identities and content are intentionally not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requested",
    "effective",
    "policySource",
    "capabilitySource",
    "eligibility",
    "queue",
    "pauseReason"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requested": {
      "$ref": "#/$defs/normalizedValues"
    },
    "effective": {
      "$ref": "#/$defs/normalizedValues"
    },
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rule",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "default",
            "global",
            "group",
            "account-policy"
          ]
        },
        "rule": {
          "enum": [
            "default",
            "allow",
            "observe",
            "deny"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "capabilitySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contractVersion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "default",
            "compiled-manifest",
            "native-snapshot"
          ]
        },
        "contractVersion": {
          "const": 1
        }
      }
    },
    "eligibility": {
      "enum": [
        "eligible",
        "ineligible",
        "blocked",
        "unknown"
      ]
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "ageSeconds"
      ],
      "properties": {
        "class": {
          "enum": [
            "interactive",
            "background",
            "opportunistic"
          ]
        },
        "ageSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        }
      }
    },
    "pauseReason": {
      "enum": [
        "none",
        "critical-activity",
        "feature-disabled",
        "policy",
        "capability",
        "network",
        "power-saver",
        "thermal",
        "storage-pressure",
        "deadline",
        "revoked",
        "unknown"
      ]
    }
  },
  "$defs": {
    "normalizedValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "networkCost",
        "power",
        "thermal",
        "storagePressure",
        "maxBytes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "off",
            "observe",
            "execute"
          ]
        },
        "networkCost": {
          "enum": [
            "offline",
            "unmetered",
            "metered",
            "unknown"
          ]
        },
        "power": {
          "enum": [
            "normal",
            "charging",
            "saver",
            "unknown"
          ]
        },
        "thermal": {
          "enum": [
            "nominal",
            "serious",
            "critical",
            "unknown"
          ]
        },
        "storagePressure": {
          "enum": [
            "normal",
            "low",
            "critical",
            "unknown"
          ]
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        }
      }
    }
  }
}
