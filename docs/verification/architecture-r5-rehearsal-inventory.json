  "operations": [
    {
      "id": "totp-uri-and-code",
      "participants": [
        "d3",
        "d4-directory",
        "d4-oidc",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [
        "provisioning-uri secret query",
        "RFC4226 dynamic truncation",
        "SHA-1",
        "30-second step",
        "six digits",
        "unpadded case-insensitive Base32"
      ],
      "differences": [],
      "disposition": "extracted-pure-leaf",
      "owner": "scripts/deploy/rehearsal-totp.sh"
    },
    {
      "id": "http-response-capture",
      "participants": [
        "d3",
        "d4-directory",
        "d4-oidc",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [
        "bounded curl request",
        "body retained separately from status"
      ],
      "differences": [
        "D4 OIDC retains headers and a cookie jar",
        "D5 selects an environment address",
        "updater and rewind add audit-reason and idempotency headers",
        "body diagnostics have different disclosure bounds"
      ],
      "disposition": "scenario-local",
      "owner": "each rehearsal controller"
    },
    {
      "id": "status-retry-policy",
      "participants": [
        "d3",
        "d4-directory",
        "d4-oidc",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [
        "exact expected HTTP status"
      ],
      "differences": [
        "D4 directory retries HTTP 429 five times with 20-second waits",
        "other enrollment paths do not retry 429",
        "rewind accepts an existing HTTP 200 token before enrollment",
        "failure-body retention differs"
      ],
      "disposition": "scenario-local",
      "owner": "each rehearsal controller"
    },
    {
      "id": "cookie-and-session-policy",
      "participants": [
        "d4-oidc",
        "d3",
        "d4-directory",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [],
      "differences": [
        "D4 OIDC owns browser-equivalent cookie continuity across redirects",
        "all other paths use bearer tokens and no cookie jar"
      ],
      "disposition": "scenario-local",
      "owner": "scripts/deploy/unified-deployment-d4-oidc-flow.sh"
    },
    {
      "id": "enrollment-reset-policy",
      "participants": [
        "d3",
        "d4-directory",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [
        "disposable factor reset",
        "token-family revocation"
      ],
      "differences": [
        "D3 checks auth service activity",
        "D4 and D5 clear a loopback rate-limit counter",
        "rewind may retain an already-valid login",
        "labels and evidence bodies differ"
      ],
      "disposition": "scenario-local",
      "owner": "each rehearsal controller"
    },
    {
      "id": "readiness-wait",
      "participants": [
        "readiness",
        "d3",
        "d4-directory",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [
        "bounded readiness observation"
      ],
      "differences": [
        "deadlines and intervals differ",
        "rewind requires PostgreSQL and object storage in the same boundary",
        "D3 also waits on the SMTP sink",
        "failure diagnostics and repair actions differ"
      ],
      "disposition": "scenario-local",
      "owner": "each rehearsal controller"
    },
    {
      "id": "topology-and-checkpoint-orchestration",
      "participants": [
        "readiness",
        "d3",
        "d4-directory",
        "d5",
        "updater",
        "rewind"
      ],
      "matchingDimensions": [
        "exact-prefix disposable resources",
        "fail-closed checkpoints"
      ],
      "differences": [
        "resource sets, phase order, cleanup boundary, fault injection, status output and resume policy are scenario-specific"
      ],
      "disposition": "scenario-local",
      "owner": "each rehearsal controller"
    }
