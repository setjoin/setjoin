      {
        "send": "EHLO smtp6.test\r\n",
        "lines": 5
      },
      {
        "send": "MAIL FROM:<visitor@external.test>\r\nRCPT TO:<alias@smtp1.test>\r\nDATA\r\n",
        "lines": 3
      },
      {
        "send": "From: Alice <visitor@external.test>\r\nTo: alias@smtp1.test\r\nMessage-ID: <phish-exact-rejected@smtp6.test>\r\nSubject: Ordinary message\r\n\r\nhello\r\n.\r\n",
