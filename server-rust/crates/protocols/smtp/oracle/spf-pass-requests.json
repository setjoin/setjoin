[
  {
    "name": "SPF passes from MAIL identity",
    "mail_auth": {
      "feature.spf": true
    },
    "dns": {
      "txt:pass.smtp2.test": [
        "v=spf1 ip4:127.0.0.1 -all"
      ]
    },
    "observe_effects": true,
    "steps": [
      {
        "send": "",
        "lines": 1
      },
      {
        "send": "EHLO peer.test\r\n",
        "lines": 5
      },
      {
        "send": "MAIL FROM:<sender@pass.smtp2.test>\r\n",
        "lines": 1
      },
      {
        "send": "RCPT TO:<alice@smtp1.test>\r\n",
        "lines": 1
      },
      {
        "send": "DATA\r\n",
        "lines": 1
      },
      {
        "send": "From: sender@pass.smtp2.test\r\nTo: alice@smtp1.test\r\nMessage-Id: <spf-pass@smtp2.test>\r\nSubject: SPF pass\r\n\r\nbody\r\n.\r\n",
        "lines": 1
      },
      {
        "send": "QUIT\r\n",
        "lines": 1
      }
    ]
  }
]
