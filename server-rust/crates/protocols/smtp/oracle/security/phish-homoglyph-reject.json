  "steps": [
    {
      "lines": 1,
      "reply": "220 mailserver ESMTP\r\n",
      "send": ""
    },
    {
      "lines": 5,
      "reply": "250-mailserver\r\n250-PIPELINING\r\n250-8BITMIME\r\n250-ENHANCEDSTATUSCODES\r\n250 SIZE 157286400\r\n",
      "send": "EHLO smtp6.test\r\n"
    },
    {
      "lines": 3,
      "reply": "250 OK\r\n250 OK\r\n354 Start mail input; end with <CRLF>.<CRLF>\r\n",
      "send": "MAIL FROM:<visitor@external.test>\r\nRCPT TO:<alias@smtp1.test>\r\nDATA\r\n"
    },
    {
      "lines": 1,
      "reply": "550 Message rejected per anti-phishing policy\r\n",
      "send": "From: Visitor <sender@exаmple.com>\r\nTo: alias@smtp1.test\r\nMessage-ID: <phish-homoglyph-reject@smtp6.test>\r\nSubject: Ordinary message\r\n\r\nhello\r\n.\r\n"
