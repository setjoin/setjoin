  "steps": [
   {
    "request": "l1 LOGIN \"alice@imap2.test\" \"imap2-app-token-alice\"\r\n",
    "until": "l1"
   },
   {
    "request": "s1 SELECT Inbox\r\n",
    "until": "s1"
   },
   {
    "request": "w01 UID STORE 5 +FLAGS (\\Seen)\r\n",
    "until": "w01"
   },
   {
    "request": "w02 UID STORE 3:5 -FLAGS (\\Seen)\r\n",
    "until": "w02"
   },
   {
    "request": "w03 UID STORE 4 +FLAGS (\\Seen)\r\n",
    "until": "w03"
   },
   {
    "request": "w04 UID STORE 14:* FLAGS (\\Answered)\r\n",
    "until": "w04"
   },
   {
    "request": "w05 UID STORE * +FLAGS.SILENT (\\Flagged)\r\n",
    "until": "w05"
   },
   {
    "request": "w06 UID STORE 1 +FLAGS (\\Seen)\r\n",
    "until": "w06"
   },
   {
    "request": "w07 UID STORE 5\r\n",
    "until": "w07"
   },
   {
    "request": "w08 UID STORE\r\n",
    "until": "w08"
   },
   {
    "request": "w09 UID STORE x +FLAGS (\\Seen)\r\n",
    "until": "w09"
   },
   {
    "request": "w10 UID STORE 20:3 +FLAGS (\\Draft)\r\n",
    "until": "w10"
   },
   {
    "request": "w11 FETCH 1:* (FLAGS)\r\n",
    "until": "w11"
   }
  ]
 },
 {
  "name": "store-read-only-and-project",
  "transport": "plain",
  "steps": [
   {
    "request": "l1 LOGIN \"alice@imap2.test\" \"imap2-app-token-alice\"\r\n",
    "until": "l1"
   },
   {
    "request": "e0 EXAMINE Inbox\r\n",
