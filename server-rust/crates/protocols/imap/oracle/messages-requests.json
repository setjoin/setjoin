   },
   {
    "request": "b1 FETCH 1:* (FLAGS)\r\n",
    "until": "b1"
   },
   {
    "request": "b2 UID FETCH 1:* (UID)\r\n",
    "until": "b2"
   },
   {
    "request": "b3 SEARCH ALL\r\n",
    "until": "b3"
   },
   {
    "request": "b4 SEARCH FROM example\r\n",
    "until": "b4"
   },
   {
    "request": "b5 UID SEARCH KEYWORD Label\r\n",
    "until": "b5"
   },
   {
    "request": "b6 STORE 1:* +FLAGS (\\Seen \\Deleted)\r\n",
    "until": "b6"
   },
   {
    "request": "b7 UID STORE 3:20 +FLAGS (\\Seen)\r\n",
    "until": "b7"
   },
   {
    "request": "b8 SEARCH DELETED\r\n",
    "until": "b8"
   },
   {
    "request": "b9 SELECT Project\r\n",
    "until": "b9"
   },
   {
    "request": "c1 FETCH 1:* (FLAGS)\r\n",
    "until": "c1"
   }
  ]
 },
 {
  "name": "pipelined-and-mixed",
  "transport": "plain",
  "steps": [
   {
    "request": "l1 LOGIN \"alice@imap2.test\" \"imap2-app-token-alice\"\r\n",
    "until": "l1"
   },
   {
    "request": "p0 SELECT Inbox\r\np1 FETCH 1 (FLAGS)\r\np2 STORE 1 +FLAGS (\\Seen)\r\np3 SEARCH SEEN\r\np4 UID FETCH 5 (UID)\r\np5 NOOP\r\n",
    "until": "p5"
   },
   {
    "request": "p6 STORE 2 +FLAGS (\\Seen)\r\n",
    "until": "p6"
   },
   {
    "request": "p7 SEARCH SEEN UNFLAGGED\r\n",
    "until": "p7"
   },
   {
    "request": "p8 LOGOUT\r\n",
    "until": "p8"
   }
  ]
 },
