   },
   {
    "request": "e10 UID STORE 1:2 FLAGS (\\Flagged)\r\n",
    "until": "e10"
   },
   {
    "request": "e11 FETCH 1:* (FLAGS)\r\n",
    "until": "e11"
   }
  ]
 },
 {
  "name": "cross-mailbox-isolation",
  "transport": "plain",
  "steps": [
   {
    "request": "l1 LOGIN \"bob@imap2.test\" \"imap2-app-token-bob\"\r\n",
