   },
   {
    "request": "e1 STORE 1 +FLAGS (\\Seen)\r\n",
    "until": "e1"
   },
   {
    "request": "e2 UID STORE 3 +FLAGS (\\Seen)\r\n",
    "until": "e2"
   },
   {
    "request": "e3 STORE\r\n",
    "until": "e3"
   },
   {
    "request": "e4 STORE 1 BOGUS\r\n",
