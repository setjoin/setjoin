{
	"name": "mailserver-webmail",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"predev": "node scripts/vendor-blur-assets.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/vendor-blur-assets.mjs",
		"build": "vite build",
		"postbuild": "node scripts/generate-critical-shell.mjs && node scripts/generate-static-representations.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:performance": "node --test scripts/performance-report.test.mjs scripts/performance-evidence.test.mjs scripts/performance-receipts.test.mjs",
		"test:performance:report": "node scripts/performance-report.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:csp": "playwright test --config playwright.csp.config.ts",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "npm run lint -- --fix",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\" --cache --cache-strategy content --max-warnings 0",
		"lint:css:fix": "npm run lint:css -- --fix"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.5.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"postcss-html": "^2.0.0",
		"stylelint": "^17.14.1",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10"
	},
	"overrides": {
		"cookie": "0.7.2",
		"lodash-es": "4.18.1",
		"@excalidraw/excalidraw": {
			"nanoid": "3.3.18"
		},
		"@excalidraw/mermaid-to-excalidraw": {
			"nanoid": "5.1.16"
		}
	},
	"type": "module",
	"dependencies": {
		"@excalidraw/excalidraw": "0.18.1",
		"@livekit/track-processors": "^0.7.2",
		"@noble/hashes": "^2.2.0",
		"@tiptap/core": "^3.29.2",
		"@tiptap/extension-image": "^3.29.2",
		"@tiptap/extension-mention": "^3.29.2",
		"@tiptap/extension-placeholder": "^3.29.2",
		"@tiptap/extension-table": "^3.29.2",
		"@tiptap/extension-text-style": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"@tiptap/starter-kit": "^3.29.2",
		"clsx": "^2.1.1",
		"cookie": "0.7.2",
		"dompurify": "^3.4.13",
		"livekit-client": "~2.22.3",
		"lucide-svelte": "^1.0.1",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	}
}
