# Mailserver configuration — copy to /opt/mailserver/config.env and edit.
# All variables map to gateway/cmd/gateway/main.go config.Load().
#
# ⚠️  SECURITY: All secrets below are defaults for local development only.
# You MUST change every password, key, and secret before deploying to production.
# At minimum, change: DB_DSN, DB_DIRECT_DSN, DB_ENCRYPTION_KEY, JWT_SECRET

# Database (PgBouncer for transactions, direct PG for LISTEN/NOTIFY)
DB_DSN=postgres://user:password@127.0.0.1:5433/mailserver
DB_DIRECT_DSN=postgres://user:password@127.0.0.1:5432/mailserver
DB_ENCRYPTION_KEY=change-me-in-production-must-be-32-chars

# Auth secrets
JWT_SECRET=change-me-in-production-must-be-32-chars
# Optional independent attachment-token secret; empty derives from JWT_SECRET.
# JWT_MAIL_ATTACHMENT_SECRET=
# Rotation-only retiring attachment master secret for five-minute tokens.
# JWT_MAIL_ATTACHMENT_PREVIOUS_SECRET=

# Network ports
LISTEN_ADDR=:443
SMTP_INBOUND_ADDR=:25
SMTP_SUBMISSION_ADDR=:587
IMAP_ADDR=:143
SMTP_INBOUND_TLS_ADDR=:465
IMAP_TLS_ADDR=:993

# Object storage (MinIO / S3-compatible)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=mailblobs

# TLS certificates
TLS_CERT=/etc/mail/tls/server.crt
TLS_KEY=/etc/mail/tls/server.key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Initial admin user
DEFAULT_ADMIN_EMAIL=admin@company.com
DEFAULT_ADMIN_PASSWORD=change-me-now

# Virus scanner
CLAMAV_ADDR=127.0.0.1:3310

# Public hostname
HOSTNAME=mail.company.com

# WebAuthn origin (must match TLS certificate domain)
WEBAUTHN_RP_ORIGIN=https://mail.company.com

# Optional: LDAP GAL
# LDAP_ADDR=:389
# LDAP_DOMAIN=company.com

# Optional: OIDC / SAML
# OIDC_ENABLED=true
# OIDC_PROVIDER_URL=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_REDIRECT_URL=https://mail.company.com/auth/oidc/callback
