BEGIN;
SELECT plan(63);


SELECT mk_account('migration-source') AS mailbox_id \gset
SELECT user_id AS migration_user_id FROM mailboxes WHERE id=:mailbox_id \gset
SELECT id AS inbox_tag_id FROM tags WHERE mailbox_id=:mailbox_id AND name='Inbox' \gset
INSERT INTO migration_jobs(id,user_id,source_type,target_mailbox_id,conflict_strategy,status,resume_cursor)
VALUES (99531,:migration_user_id,'imap',:mailbox_id,'skip','pending',
  '{"Legacy":5,"delta":{"INBOX":"d1"}}');

SELECT lives_ok($$SELECT migration_source_bind(99531,'imap','host/user','aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa')$$,
  'bind source instance');
SELECT is((SELECT count(*)::int FROM migration_source_instances WHERE job_id=99531),1,'one source instance');
SELECT lives_ok($$SELECT migration_source_bind(99531,'imap','host/user','aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa')$$,
  'same source bind replays');
SELECT throws_ok($$SELECT migration_source_bind(99531,'imap','other/user','bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb')$$,
  'BZ264','Migration source identity changed','source conflict fails closed');

SELECT ok(migration_apply_mail_object(
  99531,'11111111-1111-4111-8111-111111111111','imap:INBOX:1:1','v1','INBOX','upsert',
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc',:inbox_tag_id,
  '<migration-1@test>','subject','from@test','','[]','[]','[]','','','body','',4,false,false,
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc',now()) IS NOT NULL,
	'apply source message');
SELECT is((SELECT count(*)::int FROM migration_source_objects),1,'one source object');
SELECT is((SELECT count(*)::int FROM messages WHERE mailbox_id=:mailbox_id),1,'one target message');
SELECT is((SELECT state FROM migration_object_operations WHERE operation_id='11111111-1111-4111-8111-111111111111'),'completed','operation completed');

SELECT ok(migration_apply_mail_object(
  99531,'11111111-1111-4111-8111-111111111111','imap:INBOX:1:1','v1','INBOX','upsert',
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc',:inbox_tag_id,
  '<migration-1@test>','subject','from@test','','[]','[]','[]','','','body','',4,false,false,
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc',now()) IS NOT NULL,
	'operation replay succeeds');
SELECT is((SELECT count(*)::int FROM messages WHERE mailbox_id=:mailbox_id),1,'replay creates no duplicate');
SELECT throws_ok(format($sql$SELECT migration_apply_mail_object(
  99531,'11111111-1111-4111-8111-111111111111','imap:INBOX:1:2','v1','INBOX','upsert',
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc',%s,
  '<migration-2@test>','subject','from@test','','[]','[]','[]','','','body','',4,false,false,
  'cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc',now())$sql$, :inbox_tag_id),
  'BZ266','Migration operation replay conflict','operation UUID conflict rejected');

SELECT ok(migration_apply_mail_object(
  99531,'22222222-2222-4222-8222-222222222222','imap:INBOX:1:1','v2','INBOX','upsert',
  'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd',:inbox_tag_id,
  '<migration-1@test>','changed','from@test','','[]','[]','[]','','','new body','',8,false,false,
  'dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd',now()) IS NOT NULL,
	'new source version replaces projection');
SELECT is((SELECT count(*)::int FROM messages WHERE mailbox_id=:mailbox_id),1,'version replace remains one message');
SELECT is((SELECT subject FROM messages WHERE mailbox_id=:mailbox_id),'changed','new version visible');
SELECT lives_ok($$SELECT migration_thread_reconcile_start(99531)$$,'start thread reconciliation');
SELECT is((migration_thread_reconcile_batch(99531,100)->>'remaining')::int,0,'thread reconciliation drains');
SELECT is((SELECT state FROM migration_thread_reconcile_jobs WHERE job_id=99531),'completed','thread reconciliation terminal');
SELECT throws_ok($$SELECT migration_thread_reconcile_start(999999999)$$,
  'BZ270','Migration target mailbox is missing','thread reconciliation rejects an unknown migration');
SELECT throws_ok($$SELECT migration_thread_reconcile_batch(99531,0)$$,
  'BZ271','Thread reconcile limit must be 1..1000','thread reconciliation enforces its batch bound');

SELECT ok(migration_apply_mail_object(
  99531,'33333333-3333-4333-8333-333333333333','imap:INBOX:1:1','v3','INBOX','delete',NULL,NULL,
  NULL,NULL,NULL,NULL,'[]','[]','[]',NULL,NULL,NULL,NULL,0,false,false,NULL,NULL) IS NOT NULL,
	'source tombstone deletes projection');
SELECT is((SELECT count(*)::int FROM messages WHERE mailbox_id=:mailbox_id),0,'target deleted');
SELECT is((SELECT projection_state FROM migration_source_objects),'tombstoned','tombstone retained');

SELECT lives_ok($$SELECT migration_checkpoint_commit(99531,'INBOX','imap_uid','{"uidValidity":1,"lastUID":1}',1,1)$$,
  'commit source checkpoint');
SELECT is((SELECT committed_count FROM migration_checkpoints WHERE job_id=99531),1::bigint,'checkpoint count retained');
SELECT is((SELECT (resume_cursor::jsonb->'uids'->>'INBOX')::bigint FROM migration_jobs WHERE id=99531),
  1::bigint,'legacy checkpoint projects atomically to resume cursor');
SELECT lives_ok($$SELECT migration_checkpoint_commit(99531,'Archive','imap_uid','{"uidValidity":2,"uid":7}',1,2)$$,
  'canonical checkpoint commits');
SELECT is((SELECT resume_cursor::jsonb FROM migration_jobs WHERE id=99531),
  '{"Legacy":5,"delta":{"INBOX":"d1"},"uids":{"Legacy":5,"INBOX":1,"Archive":7}}'::jsonb,
  'canonical projection deep-merges legacy resume cursor');
SELECT lives_ok($$SELECT migration_checkpoint_commit(99531,'Mixed','imap_uid','{"uidValidity":3,"uid":9,"lastUID":9}',1,3)$$,
  'matching mixed checkpoint remains compatible');
SELECT throws_ok($$SELECT migration_checkpoint_commit(99531,'Conflict','imap_uid','{"uidValidity":3,"uid":9,"lastUID":10}',1,3)$$,
  'BZ265','Invalid IMAP checkpoint cursor','conflicting mixed checkpoint is rejected');
SELECT throws_ok($$SELECT migration_checkpoint_commit(99531,'Malformed','imap_uid','{"uidValidity":3}',1,3)$$,
  'BZ265','Invalid IMAP checkpoint cursor','malformed checkpoint is rejected');
SELECT throws_ok($$SELECT migration_checkpoint_commit(99531,'','imap_uid','{"uidValidity":3,"uid":9}',1,3)$$,
  'BZ265','Invalid migration checkpoint scope','legacy checkpoint rejects an empty scope');
SELECT is((SELECT count(*)::int FROM migration_checkpoints
           WHERE job_id=99531 AND scope_key IN ('Conflict','Malformed')),
  0,'rejected checkpoint shapes publish neither durable rows nor projections');
SELECT throws_ok($$SELECT migration_checkpoint_commit(99531,'INBOX','imap_uid','{}',2,2)$$,
  'BZ267','Migration checkpoint source generation mismatch','stale generation rejected');
SELECT lives_ok($$SELECT migration_checkpoint_commit_v2(99531,'ews-folder-id','Projects','ews_sync_state','"ews-state-2"',1,4)$$,
  'v2 EWS checkpoint commits with separate durable and legacy scopes');
SELECT is((SELECT cursor_value #>> '{}' FROM migration_checkpoints
           WHERE job_id=99531 AND scope_key='ews-folder-id' AND cursor_kind='ews_sync_state'),
  'ews-state-2','EWS durable checkpoint uses stable folder id');
SELECT is((SELECT resume_cursor::jsonb->'delta'->>'Projects' FROM migration_jobs WHERE id=99531),
  'ews-state-2','EWS legacy projection retains display-name key');
SELECT lives_ok($$SELECT migration_checkpoint_commit_v2(99531,'messages:inbox','messages:inbox','m365_delta_link','"https://graph.test/delta/2"',1,5)$$,
  'v2 M365 checkpoint commits');
SELECT is((SELECT resume_cursor::jsonb->'delta'->>'messages:inbox' FROM migration_jobs WHERE id=99531),
  'https://graph.test/delta/2','M365 legacy projection is atomic with durable checkpoint');
SELECT lives_ok($$SELECT migration_checkpoint_commit_v2(99531,'Batch','Batch','imap_uid','{"uidValidity":4,"uid":11}',1,6)$$,
  'v2 IMAP batch checkpoint commits');
SELECT is((SELECT (resume_cursor::jsonb->'uids'->>'Batch')::bigint FROM migration_jobs WHERE id=99531),
  11::bigint,'v2 IMAP legacy projection is atomic');
SELECT throws_ok($$SELECT migration_checkpoint_commit_v2(99531,'bad','bad','ews_sync_state','""',1,7)$$,
  'BZ265','Invalid delta checkpoint cursor','v2 empty delta cursor fails closed');

SELECT id AS sent_tag_id FROM tags WHERE mailbox_id=:mailbox_id AND name='Sent' \gset
SELECT is(migration_apply_mail_object(
  99531,'77777777-7777-4777-8777-777777777777','graph-move-1','v1','inbox','upsert',
  'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',:inbox_tag_id,
  '<move-1@test>','move','from@test','','[]','[]','[]','','','body','',4,false,false,
  'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',now())->>'outcome','imported',
  'folder-scoped source message imports');
SELECT is(migration_apply_mail_object(
  99531,'88888888-8888-4888-8888-888888888888','graph-move-1','v1','sentitems','upsert',
  'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',:sent_tag_id,
  '<move-1@test>','move','from@test','','[]','[]','[]','','','body','',4,false,false,
  'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',now())->>'outcome','moved',
  'destination upsert with same version is classified as move');
SELECT is((SELECT source_folder_id FROM migration_source_objects WHERE source_object_id='graph-move-1'),
  'sentitems','move stores destination folder scope');
SELECT is(migration_apply_mail_object(
  99531,'99999999-9999-4999-8999-999999999999','graph-move-1','v1','inbox','delete',
  NULL,NULL,NULL,NULL,NULL,NULL,'[]','[]','[]',NULL,NULL,NULL,NULL,0,false,false,NULL,NULL)->>'outcome',
  'unchanged','late old-folder tombstone is ignored');
SELECT is((SELECT projection_state FROM migration_source_objects WHERE source_object_id='graph-move-1'),
  'applied','late old-folder tombstone preserves destination projection');
SELECT is(migration_apply_mail_object(
  99531,'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa','graph-move-1','v2','sentitems','delete',
  NULL,NULL,NULL,NULL,NULL,NULL,'[]','[]','[]',NULL,NULL,NULL,NULL,0,false,false,NULL,NULL)->>'outcome',
  'deleted','current-folder tombstone deletes projection');

INSERT INTO calendars(mailbox_id,name,is_default) VALUES(:mailbox_id,'Migration',true)
RETURNING id AS calendar_id \gset
INSERT INTO calendar_events(calendar_id,uid,component_type,title)
VALUES(:calendar_id,'migration-event','VEVENT','Migration event') RETURNING id AS calendar_event_id \gset
SELECT is(migration_aux_object_begin(99531,'44444444-4444-4444-8444-444444444444',
  'calendar','ews-event-1','ck1','calendar','upsert',
  'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee')->>'action','apply',
  'calendar object begins as apply');
SELECT lives_ok(format($sql$SELECT migration_aux_object_complete(99531,
  '44444444-4444-4444-8444-444444444444','applied','calendar_event',%s)$sql$,:calendar_event_id),
  'calendar projection completion validates target ownership');
SELECT is((SELECT target_kind FROM migration_source_objects WHERE object_type='calendar'),
  'calendar_event','calendar target is durably mapped');
SELECT is(migration_aux_object_begin(99531,'44444444-4444-4444-8444-444444444444',
  'calendar','ews-event-1','ck1','calendar','upsert',
  'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee')->>'action','replay',
  'calendar operation replay is exact');

INSERT INTO addressbooks(mailbox_id,name,is_default) VALUES(:mailbox_id,'Migration',true)
RETURNING id AS addressbook_id \gset
INSERT INTO contacts(addressbook_id,vcard_uid,display_name)
VALUES(:addressbook_id,'migration-contact','Migration Contact') RETURNING id AS contact_id \gset
SELECT is(migration_aux_object_begin(99531,'55555555-5555-4555-8555-555555555555',
  'contact','graph-contact-1','ck1','contacts','upsert',
  'ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff')->>'action','apply',
  'contact object begins as apply');
SELECT lives_ok(format($sql$SELECT migration_aux_object_complete(99531,
  '55555555-5555-4555-8555-555555555555','applied','contact',%s)$sql$,:contact_id),
  'contact projection completion validates target ownership');
SELECT is((SELECT target_id FROM migration_source_objects WHERE object_type='contact'),
  :contact_id::bigint,'contact target is durably mapped');
SELECT is(migration_aux_object_begin(99531,'66666666-6666-4666-8666-666666666666',
  'contact','graph-contact-1','ck2','contacts','delete',NULL)->>'action','delete',
  'contact tombstone begins as delete');
SELECT lives_ok($$SELECT migration_aux_object_complete(99531,
  '66666666-6666-4666-8666-666666666666','tombstoned',NULL,NULL)$$,
  'contact tombstone completion succeeds without a target');
SELECT is((SELECT projection_state FROM migration_source_objects WHERE object_type='contact'),
  'tombstoned','contact tombstone retained');
SELECT throws_ok($$SELECT migration_aux_object_begin(99531,gen_random_uuid(),
  'task','bad','v1','','upsert',NULL)$$,'BZ265','Invalid auxiliary source object envelope',
  'unsupported auxiliary object type is rejected');

SELECT mk_account('migration-source-foreign') AS foreign_mailbox_id \gset
SELECT user_id AS foreign_user_id FROM mailboxes WHERE id=:foreign_mailbox_id \gset
INSERT INTO migration_jobs(id,user_id,source_type,target_mailbox_id,conflict_strategy,status,resume_cursor)
VALUES (99532,:foreign_user_id,'imap',:foreign_mailbox_id,'skip','completed','{}');
INSERT INTO migration_source_instances(id,job_id,source_type,source_mailbox_key,selector_digest)
VALUES ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',99532,'imap','foreign/source',repeat('b',64));
INSERT INTO migration_source_objects(source_instance_id,object_type,source_object_id,projection_state,
  applied_operation_id)
VALUES ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb','mail','foreign-object','tombstoned',
  'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbc');
INSERT INTO migration_object_operations(operation_id,job_id,source_instance_id,object_type,
  source_object_id,source_change,state)
VALUES ('bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbd',99532,'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb',
  'mail','foreign-object','delete','accepted');
INSERT INTO migration_checkpoints(job_id,scope_key,cursor_kind,cursor_value,source_generation)
VALUES (99532,'INBOX','imap_uid','{"uidValidity":1,"uid":1}',1);
INSERT INTO migration_thread_reconcile_jobs(job_id,target_mailbox_id,state)
VALUES (99532,:foreign_mailbox_id,'completed');
SELECT set_config('app.current_mailbox_id',:mailbox_id::text,true);
SET LOCAL ROLE setjoin_app;
SELECT is((SELECT count(*)::int FROM migration_source_instances WHERE job_id=99532),0,
  'migration source instances hide another mailbox');
SELECT is((SELECT count(*)::int FROM migration_source_objects
  WHERE source_instance_id='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'),0,
  'migration source objects hide another mailbox');
SELECT is((SELECT count(*)::int FROM migration_object_operations WHERE job_id=99532),0,
  'migration object operations hide another mailbox');
SELECT is((SELECT count(*)::int FROM migration_checkpoints WHERE job_id=99532),0,
  'migration checkpoints hide another mailbox');
SELECT is((SELECT count(*)::int FROM migration_thread_reconcile_jobs WHERE job_id=99532),0,
  'migration thread reconciliation hides another mailbox');
RESET ROLE;

SELECT * FROM finish();
ROLLBACK;
