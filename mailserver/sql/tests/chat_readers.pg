-- chat_readers.pg: read-receipt watermark projection + DM-only member_read
-- fanout (Pillar A3 QoL Task 4, ADR DES-010). chat_channel_members has no FK
-- to users (V119) so bare bigint ids suffice.
-- Requires: chat_channel.sql, notify_chat_state.sql, chat_message.sql,
-- chat_read.sql, chat_readers.sql.
BEGIN;
SELECT plan(8);
SELECT set_config('app.capture_notify', 'on', true);

-- Fixture: a channel with owner 1101, member 1102, non-member 1103.
SELECT chat_channel_create(1101, 'readers-general') AS ch_id \gset
SELECT chat_member_add(1101, :ch_id, 1102);
SELECT chat_message_send(1101, :ch_id, 'first message') AS m1_json \gset
SELECT (:'m1_json'::jsonb ->> 'seq')::bigint AS m1_seq \gset

-- A DM between 1101 and 1104. chat_dm_open now validates its target member
-- id against `users` (BZ170); 1104 needs a real row (this file otherwise
-- uses bare ids throughout).
INSERT INTO domains (id, name, is_local) VALUES (110099, 'chat-readers.test', TRUE)
  ON CONFLICT (id) DO NOTHING;
INSERT INTO users (id, username, domain_id, email, display_name) VALUES
  (1104, 'readers1104', 110099, 'readers1104@chat-readers.test', 'Readers 1104')
  ON CONFLICT (id) DO NOTHING;
SELECT chat_dm_open(1101, ARRAY[1104]::bigint[]) AS dm_id \gset
SELECT chat_message_send(1101, :dm_id, 'dm message') AS dm_json \gset

-- ── BZ163: a non-member cannot read the watermark projection ────────────
SELECT throws_ok(format($$ SELECT chat_channel_readers(1103, %s) $$, :ch_id),
  'BZ163', NULL, 'non-member cannot fetch channel readers (BZ163)');

-- ── membership-scoped watermark projection: both members present, both
-- start at 0 (neither has marked read yet) ───────────────────────────────
SELECT is(jsonb_array_length(chat_channel_readers(1102, :ch_id)), 2,
  'readers projection carries one row per channel member');
SELECT is((SELECT (elem->>'lastReadSeq')::bigint FROM jsonb_array_elements(chat_channel_readers(1101, :ch_id)) elem
            WHERE (elem->>'userId')::bigint = 1102), 0::bigint,
  '1102''s watermark starts at 0 before any mark_read');

-- ── mark_read advances the watermark the projection reflects ────────────
SELECT chat_mark_read(1102, :ch_id, :m1_seq);
SELECT is((SELECT (elem->>'lastReadSeq')::bigint FROM jsonb_array_elements(chat_channel_readers(1101, :ch_id)) elem
            WHERE (elem->>'userId')::bigint = 1102), :m1_seq::bigint,
  'readers projection reflects the advanced watermark after mark_read');

-- ── channel mark_read does NOT fan out member_read to other members
-- (ADR DES-010: channels refetch on open/focus, no O(members^2) noise) ───
SELECT last_notify_event('chat:1101') AS ch_last_before \gset
SELECT chat_mark_read(1102, :ch_id, :m1_seq);
SELECT is(last_notify_event('chat:1101'), :'ch_last_before',
  'a CHANNEL mark_read does not change what the other member''s last notify event was (no member_read fanout)');

-- ── DM mark_read DOES fan out member_read to the peer (2 members, cheap) ─
SELECT chat_mark_read(1101, :dm_id, 0);
SELECT is(last_notify_event('chat:1104'), 'member_read',
  'a DM mark_read fans out member_read to the peer');
SELECT is((last_notify_payload('chat:1104')::jsonb ->> 'userId')::bigint, 1101::bigint,
  'the member_read payload carries the reader''s userId (for the peer''s DM read-tick)');

-- ── the acting user''s own self-notify (multi-device sync) is unaffected ─
SELECT is(last_notify_event('chat:1101'), 'read',
  'the acting user still gets their own self-scoped ''read'' event (multi-device sync, unchanged)');

SELECT * FROM finish();
ROLLBACK;
