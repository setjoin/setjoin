-- #332 credential mutation seam, including Go's distinct reset flag/history contract.
BEGIN;
SELECT plan(16);
SELECT set_config('app.capture_notify','on',true);
INSERT INTO domains(name,is_local) VALUES('rust-idlogin2-password.test',true) RETURNING id AS dom \gset
INSERT INTO users(username,email,display_name,domain_id,password_hash,enabled,must_change_password)
VALUES('password@rust-idlogin2-password.test','password@rust-idlogin2-password.test','a',:dom,'old',true,true) RETURNING id AS u \gset
INSERT INTO users(username,email,display_name,domain_id,password_hash,enabled)
VALUES('foreign@rust-idlogin2-password.test','foreign@rust-idlogin2-password.test','b',:dom,'foreign',true) RETURNING id AS ou \gset
INSERT INTO oauth_tokens(user_id,token_hash,token_type,expires_at) VALUES(:u,digest('parent','sha256'),'refresh',now()+interval '1 hour');
INSERT INTO sessions(id,user_id,token_hash,expires_at,auth_method) VALUES('idlogin2-password-session',:u,digest('access','sha256'),now()+interval '1 hour','password');
SELECT is(rust_identity_password_write(:u,'password@rust-idlogin2-password.test','stale','[]','new',5,false)->>'status','invalid-current','stale credential proof cannot publish');
SELECT is((SELECT password_hash FROM users WHERE id=:u),'old','stale proof does not mutate');
SELECT is((SELECT password_hash FROM users WHERE id=:ou),'foreign','foreign credential stays untouched');
SELECT set_config('app.rust_operation_id','33200000-0000-4000-8000-000000000100',true);
SELECT is(rust_identity_password_write(:u,'password@rust-idlogin2-password.test','old','[]','new',5,false)->>'status','ok','current proof changes password');
SELECT is((SELECT password_hash FROM users WHERE id=:u),'new','new credential committed');
SELECT ok((SELECT NOT must_change_password FROM users WHERE id=:u),'ordinary change clears enforced-change flag');
SELECT is((SELECT count(*) FROM password_history WHERE user_id=:u),1::bigint,'ordinary change records history');
SELECT is((SELECT count(*) FROM oauth_tokens WHERE user_id=:u AND revoked_at IS NOT NULL),1::bigint,'OAuth capability revoked atomically');
SELECT is((SELECT count(*) FROM sessions WHERE user_id=:u),0::bigint,'runtime sessions cleared atomically');
SELECT is((SELECT count(*) FROM _test_notify_log WHERE channel='session_revoke'),1::bigint,'one real revocation notification');
UPDATE users SET must_change_password=true WHERE id=:u;
SELECT set_config('app.rust_operation_id','33200000-0000-4000-8000-000000000101',true);
SELECT is(rust_identity_password_write(:u,'ignored',NULL,'[]','reset',0,true)->>'status','ok','verified reset uses its token principal');
SELECT is((SELECT password_hash FROM users WHERE id=:u),'reset','reset installs new credential');
SELECT ok((SELECT must_change_password FROM users WHERE id=:u),'parity: reset preserves enforced-change flag');
SELECT is((SELECT count(*) FROM password_history WHERE user_id=:u),1::bigint,'parity: reset does not alter password history');
SELECT is((SELECT count(*) FROM admin_audit_log WHERE target_type='user' AND target_id=:u AND action='revoke_user_sessions'),2::bigint,'both transactions retain revocation audit');
SELECT is((SELECT count(*) FROM rust_operation_receipts WHERE operation_id IN ('33200000-0000-4000-8000-000000000100','33200000-0000-4000-8000-000000000101') AND family='F21'),2::bigint,'both writes atomically record opaque outcomes');
SELECT * FROM finish();
ROLLBACK;
