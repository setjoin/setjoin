-- pgTAP: saved_searches.sql — saved-search folders (named per-mailbox persisted
-- queries). Mirrors quick_steps.pg: create → list → verbatim-query → validate
-- empty name/query (BZ040) → delete → ownership (divergent-id mk_account so a
-- foreign mailbox can neither list nor delete another's saved search).
BEGIN;
SELECT plan(11);

-- ── Fixtures: two divergent-id accounts (user_id != mailbox_id via mk_account) ──
CREATE TEMP TABLE _mb AS SELECT mk_account('ssa') AS a, mk_account('ssb') AS b;

-- ── list empty initially ──
SELECT is(jsonb_array_length(saved_search_list((SELECT a FROM _mb))), 0, 'no saved searches yet');

-- ── create a saved search ──
SELECT lives_ok($$
  SELECT saved_search_set((SELECT a FROM _mb), 'Big unread', 'is:unread larger:5M')
$$, 'create saved search');

-- the RAW query string is returned verbatim (never a resolved filter)
SELECT is(
  saved_search_set((SELECT a FROM _mb), 'From boss', 'from:boss@corp.test tag:Inbox')->>'query',
  'from:boss@corp.test tag:Inbox',
  'set returns the raw query string verbatim');

SELECT is(jsonb_array_length(saved_search_list((SELECT a FROM _mb))), 2, 'two saved searches listed');

-- list rows carry id/name/query/position with the verbatim query
SELECT ok(
  EXISTS (SELECT 1 FROM jsonb_array_elements(saved_search_list((SELECT a FROM _mb))) e
          WHERE e->>'name' = 'Big unread' AND e->>'query' = 'is:unread larger:5M'
            AND e ? 'id' AND e ? 'position'),
  'list row has id/name/query/position with the verbatim query');

-- ── empty / blank name and empty query are rejected (BZ040 invalidArguments) ──
SELECT throws_ok($$ SELECT saved_search_set((SELECT a FROM _mb), '', 'is:unread') $$,
  'BZ040', NULL, 'reject empty name');
SELECT throws_ok($$ SELECT saved_search_set((SELECT a FROM _mb), '   ', 'is:unread') $$,
  'BZ040', NULL, 'reject blank name');
SELECT throws_ok($$ SELECT saved_search_set((SELECT a FROM _mb), 'Nope', '') $$,
  'BZ040', NULL, 'reject empty query');

-- ── delete removes it (ownership in the WHERE) ──
SELECT is(
  (SELECT saved_search_delete((SELECT a FROM _mb),
     (SELECT id FROM saved_searches WHERE mailbox_id = (SELECT a FROM _mb) AND name = 'Big unread'))
   )->>'deleted',
  'true',
  'delete reports the row removed');

SELECT is(jsonb_array_length(saved_search_list((SELECT a FROM _mb))), 1, 'one saved search left after delete');

-- ── ownership: mailbox B can neither see nor delete mailbox A's saved search ──
-- B's list is empty (A still has one row); B's delete of A's id is a no-op and A
-- keeps the row — R1 (list) + R3 (delete) both scope by mailbox.
SELECT ok(
  jsonb_array_length(saved_search_list((SELECT b FROM _mb))) = 0
  AND (saved_search_delete((SELECT b FROM _mb),
        (SELECT id FROM saved_searches WHERE mailbox_id = (SELECT a FROM _mb) LIMIT 1))->>'deleted') = 'false'
  AND EXISTS (SELECT 1 FROM saved_searches WHERE mailbox_id = (SELECT a FROM _mb)),
  'foreign mailbox cannot list or delete another mailbox''s saved search (R1/R3)');

SELECT * FROM finish();
ROLLBACK;
