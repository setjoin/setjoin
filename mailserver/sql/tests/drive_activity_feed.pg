-- mailserver/sql/tests/drive_activity_feed.pg — the §5.6 activity feed
-- (Task 7, LR-2): reads the actor-bearing drive_audit_log chain, newest
-- first, with per-file filtering + keyset pagination.
BEGIN;
SELECT plan(10);

SELECT mk_account('daa') AS mba \gset
SELECT mk_account('dab') AS mbb \gset
SELECT mk_account('dac') AS mbc \gset
SELECT mk_account('dad') AS mbd \gset
SELECT user_id AS m  FROM mailboxes WHERE id = :mba \gset
SELECT user_id AS e  FROM mailboxes WHERE id = :mbb \gset
SELECT user_id AS e2 FROM mailboxes WHERE id = :mbc \gset
SELECT user_id AS o  FROM mailboxes WHERE id = :mbd \gset

SELECT drive_space_create(:m, 'AF', 'regular') AS sid \gset
SELECT drive_member_grant(:m, :sid, :e, 'editor');
SELECT drive_member_grant(:m, :sid, :e2, 'editor');

-- Interleaved scripted session across two files (F1 the subject, F2 a decoy)
SELECT drive_node_create(:m, :sid, NULL, 'file', 'f1.docx') AS f1 \gset
SELECT drive_node_create(:m, :sid, NULL, 'file', 'f2.docx') AS f2 \gset
SELECT drive_chunk_register(:m, :sid, repeat('1',64), 10);
SELECT drive_chunk_register(:m, :sid, repeat('2',64), 10);
SELECT drive_chunk_register(:m, :sid, repeat('3',64), 10);
SELECT (drive_file_put_version(:m, :f1, repeat('a',64), 10, NULL, NULL,
  format('[{"sha256":"%s","size":10}]', repeat('1',64))::jsonb, NULL, 'test')->>'versionId')::bigint AS v1 \gset
SELECT (drive_file_put_version(:m, :f2, repeat('b',64), 10, NULL, NULL,
  format('[{"sha256":"%s","size":10}]', repeat('2',64))::jsonb, NULL, 'test')->>'versionId')::bigint AS w1 \gset
SELECT (drive_file_put_version(:m, :f1, repeat('c',64), 10, NULL, :v1,
  format('[{"sha256":"%s","size":10}]', repeat('3',64))::jsonb, NULL, 'test')->>'versionId')::bigint AS v2 \gset
SELECT drive_branch_create(:e, :f1, 'af-branch', :v1) AS bid \gset
SELECT drive_branch_set_status(:e, :bid, 'review');
SELECT drive_file_lock(:e2, :f1, 'hard');
SELECT drive_file_unlock(:m, :f1, true);
SELECT drive_version_label_set(:m, :v2, 'Approved');

-- full-space feed, newest-first
SELECT drive_activity_feed(:m, :sid, NULL, 50, NULL) AS feed_all \gset
SELECT is(:'feed_all'::jsonb->'items'->0->>'action', 'label.set', 'newest-first: the last action is first in the feed');
SELECT ok(jsonb_array_length(:'feed_all'::jsonb->'items') >= 10, 'full-space feed carries every scripted event');

-- per-file filter: F1 only (node.create, 2x version.create, branch.create,
-- branch.review, lock.acquire, lock.break, label.set = 8 rows; F2's rows excluded)
SELECT drive_activity_feed(:m, :sid, :f1, 50, NULL) AS feed_f1 \gset
SELECT is(jsonb_array_length(:'feed_f1'::jsonb->'items')::int, 8, 'per-file feed returns exactly F1''s 8 events');
SELECT ok(NOT EXISTS (
    SELECT 1 FROM jsonb_array_elements(:'feed_f1'::jsonb->'items') it
     WHERE (it->>'targetType')='node' AND (it->>'targetId')::bigint = :f2
  ), 'per-file feed never leaks F2''s node.create row');

-- keyset pagination: page 1 (3 newest), page 2 continues with no overlap
SELECT drive_activity_feed(:m, :sid, :f1, 3, NULL) AS page1 \gset
SELECT jsonb_array_length(:'page1'::jsonb->'items')::int AS n1 \gset
SELECT is(:n1, 3, 'page 1 returns 3 items');
SELECT ((:'page1'::jsonb->'items'->2)->>'id')::bigint AS before_id \gset
SELECT drive_activity_feed(:m, :sid, :f1, 50, :before_id) AS page2 \gset
SELECT is((
    SELECT count(*) FROM jsonb_array_elements(:'page1'::jsonb->'items') a
    JOIN jsonb_array_elements(:'page2'::jsonb->'items') b ON (a->>'id') = (b->>'id')
  )::int, 0, 'page 2 (keyset-continued) never repeats a page-1 id');
SELECT is(jsonb_array_length(:'page1'::jsonb->'items') + jsonb_array_length(:'page2'::jsonb->'items'), 8,
  'the two pages together account for every one of F1''s 8 events');

-- non-member
SELECT throws_ok(format($$ SELECT drive_activity_feed(%s, %s, NULL, 50, NULL) $$, :o, :sid),
  'BZ139', NULL, 'non-member → BZ139');

-- p_max clamp floor (>= 1 even for 0 / negative)
SELECT is(jsonb_array_length((drive_activity_feed(:m, :sid, :f1, 0, NULL))->'items')::int, 1, 'p_max=0 clamps to floor 1');
SELECT is(jsonb_array_length((drive_activity_feed(:m, :sid, :f1, -5, NULL))->'items')::int, 1, 'p_max negative clamps to floor 1');

SELECT * FROM finish();
ROLLBACK;
