-- Public data-transaction seam; HTTP goldens cover the separate Go audit.
BEGIN;
SELECT plan(14);
CREATE TEMP TABLE appr1_accounts(kind text,mailbox_id bigint,user_id bigint);
INSERT INTO appr1_accounts(kind,mailbox_id) VALUES('admin',mk_account('appr1-policy-admin')),('stranger',mk_account('appr1-policy-stranger'));
UPDATE appr1_accounts a SET user_id=m.user_id FROM mailboxes m WHERE m.id=a.mailbox_id;
CREATE TEMP TABLE appr1_group AS WITH inserted AS (INSERT INTO admin_role_groups(name,permissions) VALUES('appr1-policy-create-'||gen_random_uuid(),ARRAY['approvals.manage']) RETURNING id) SELECT id FROM inserted;
INSERT INTO admin_role_assignments(user_id,role_group_id,granted_by) SELECT a.user_id,g.id,a.user_id FROM appr1_accounts a CROSS JOIN appr1_group g WHERE a.kind='admin';
INSERT INTO approval_policies(consumer_type,name,priority,conditions,approver_spec) VALUES('hr.leave','appr1 existing',7,'{}','{}');
GRANT SELECT ON appr1_accounts TO setjoin_app;
SELECT set_config('app.current_user_id',(SELECT user_id::text FROM appr1_accounts WHERE kind='admin'),true);
SET LOCAL ROLE setjoin_app;
CREATE TEMP TABLE appr1_result AS SELECT rust_approval_policy_create((SELECT user_id FROM appr1_accounts WHERE kind='admin'),'{"consumerType":"hr.leave","name":"appr1 new","enabled":false,"conditions":{},"requiresApproval":true,"approverSpec":{}}'::jsonb) AS id;
SELECT is((SELECT priority FROM approval_policies WHERE id=(SELECT id FROM appr1_result)),8,'creation takes the maximum priority in its own consumer');
SELECT is((SELECT count(*)::int FROM admin_audit_log WHERE target_type='approval_policy' AND target_id=(SELECT id FROM appr1_result)),0,'data transaction preserves frozen Go separate audit boundary');
SELECT set_config('app.current_user_id',(SELECT user_id::text FROM appr1_accounts WHERE kind='stranger'),true);
SELECT throws_ok($$SELECT rust_approval_policy_create((SELECT user_id FROM appr1_accounts WHERE kind='stranger'),'{"consumerType":"hr.leave","name":"appr1 denied","enabled":true,"conditions":{},"requiresApproval":true,"approverSpec":{}}')$$,'42501','approvals.manage required','app caller cannot create without a live grant');
RESET ROLE;
SELECT throws_ok($$SELECT rust_approval_policy_create((SELECT user_id FROM appr1_accounts WHERE kind='stranger'),'{"consumerType":"hr.leave","name":"appr1 denied","enabled":true,"conditions":{},"requiresApproval":true,"approverSpec":{}}')$$,'42501','approvals.manage required','same-statement grant fence also protects owner-pool calls');
SELECT is((SELECT count(*)::int FROM approval_policies WHERE name='appr1 denied'),0,'denials leave no policy behind');
SELECT is(rust_approval_policy_update((SELECT user_id FROM appr1_accounts WHERE kind='stranger'),(SELECT id FROM appr1_result),'{"name":"stolen"}'),0::bigint,'owner-pool update retains same-WHERE authority');
SELECT is(rust_approval_policy_delete((SELECT user_id FROM appr1_accounts WHERE kind='stranger'),(SELECT id FROM appr1_result)),0::bigint,'owner-pool delete retains same-WHERE authority');
SELECT lives_ok($$SELECT rust_approval_policy_reorder((SELECT user_id FROM appr1_accounts WHERE kind='stranger'),jsonb_build_object('consumerType','hr.leave','orderedIds',jsonb_build_array((SELECT id FROM appr1_result))))$$,'foreign reorder is the same zero-row Go data operation');
SELECT is((SELECT priority FROM approval_policies WHERE id=(SELECT id FROM appr1_result)),8,'foreign reorder leaves priority unchanged');
SELECT set_config('app.current_user_id',(SELECT user_id::text FROM appr1_accounts WHERE kind='admin'),true);
SET LOCAL ROLE setjoin_app;
SELECT is(rust_approval_policy_update((SELECT user_id FROM appr1_accounts WHERE kind='admin'),(SELECT id FROM appr1_result),'{"name":"updated","enabled":true}'),1::bigint,'app manager updates one policy');
SELECT is((SELECT name FROM approval_policies WHERE id=(SELECT id FROM appr1_result)),'updated','update persists patch');
SELECT lives_ok($$SELECT rust_approval_policy_reorder((SELECT user_id FROM appr1_accounts WHERE kind='admin'),jsonb_build_object('consumerType','hr.leave','orderedIds',jsonb_build_array((SELECT id FROM appr1_result))))$$,'app manager can reorder without replacing the list');
SELECT is((SELECT priority FROM approval_policies WHERE id=(SELECT id FROM appr1_result)),1,'reorder completes its negative and positive passes');
SELECT is(rust_approval_policy_delete((SELECT user_id FROM appr1_accounts WHERE kind='admin'),(SELECT id FROM appr1_result)),1::bigint,'app manager deletes one policy');
RESET ROLE;
SELECT * FROM finish();
ROLLBACK;
