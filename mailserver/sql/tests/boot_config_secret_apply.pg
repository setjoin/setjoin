-- SQL interface/atomicity proof for the boot-only trusted config batch.
BEGIN;
SELECT plan(6);
SELECT has_function('public','boot_config_secret_apply',ARRAY['jsonb'],'boot secret batch is installed');
UPDATE system_config SET value='"before"',encrypted=false WHERE key='ad_sync_password_enc';
INSERT INTO system_config(key,value,encrypted) VALUES ('ldap_sync_boot_enc','"second"',false);
SELECT throws_ok($q$SELECT boot_config_secret_apply('[
 {"key":"ad_sync_password_enc","value":"changed","replace":true},
 {"key":"ldap_sync_boot_enc","value":null,"replace":true}]')$q$,
 '23502',NULL,'a later rejected update aborts the whole batch');
SELECT is((SELECT value #>> '{}' FROM system_config WHERE key='ad_sync_password_enc'),'before','earlier plaintext remains unchanged after failure');
SELECT is((SELECT encrypted FROM system_config WHERE key='ad_sync_password_enc'),false,'earlier encrypted flag also rolls back');
SELECT is(boot_config_secret_apply('[{"key":"ad_sync_password_enc","replace":false}]'),1,'flag-only repair updates the selected row');
SELECT ok((SELECT encrypted AND value='"before"'::jsonb FROM system_config WHERE key='ad_sync_password_enc'),'flag-only repair preserves the stored bytes');
SELECT * FROM finish();
ROLLBACK;
