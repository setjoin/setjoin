-- mailserver/sql/tests/drive_lock_enforce.pg — I-12: lock enforcement inside
-- drive_file_put_version, no TOCTOU (spec §10 row, verbatim).
BEGIN;
SELECT plan(17);
-- M=manager, A=editor(holder), B=editor(second saver), FA=subtree folder admin
SELECT mk_account('dlea') AS mba \gset
SELECT mk_account('dleb') AS mbb \gset
SELECT mk_account('dlec') AS mbc \gset
SELECT mk_account('dled') AS mbd \gset
SELECT user_id AS m  FROM mailboxes WHERE id = :mba \gset
SELECT user_id AS a  FROM mailboxes WHERE id = :mbb \gset
SELECT user_id AS b  FROM mailboxes WHERE id = :mbc \gset
SELECT user_id AS fa FROM mailboxes WHERE id = :mbd \gset

SELECT drive_space_create(:m, 'LE', 'regular') AS sid \gset
SELECT drive_member_grant(:m, :sid, :a, 'editor');
SELECT drive_member_grant(:m, :sid, :b, 'editor');
SELECT drive_node_create(:m, :sid, NULL, 'folder', 'dept') AS pfid \gset
SELECT drive_node_create(:m, :sid, :pfid, 'file', 'F.bin') AS nid \gset
INSERT INTO drive_folder_admins (node_id, space_id, user_id, granted_by) VALUES (:pfid, :sid, :fa, :m);
SELECT drive_chunk_register(:m, :sid, repeat('1',64), 10);
SELECT (drive_file_put_version(:m, :nid, repeat('a',64), 10, NULL, NULL,
  format('[{"sha256":"%s","size":10}]', repeat('1',64))::jsonb, NULL, 'h1')->>'versionId')::bigint AS h1 \gset

-- 1. HARD lock by A on main, unexpired -> B's save to main is rejected, and
-- NOTHING changed (head unchanged, no new version row, no quota charge).
SELECT drive_file_lock(:a, :nid, 'hard');
SELECT drive_space_quota_charge(:sid, 0);   -- no-op, just to read used_bytes below cleanly
SELECT used_bytes AS ub0 FROM drive_spaces WHERE id=:sid \gset
SELECT drive_chunk_register(:b, :sid, repeat('2',64), 10);
SELECT throws_ok(format($$ SELECT drive_file_put_version(%s, %s, %L, 10, NULL, %s,
  '[{"sha256":"%s","size":10}]', NULL, 'b') $$, :b, :nid, repeat('c',64), :h1, repeat('2',64)),
  'BZ149', NULL, 'hard lock rejects another user''s save to the locked ref');
SELECT is((SELECT head_version_id FROM drive_files WHERE node_id=:nid), :h1::bigint, 'head unchanged after BZ149');
SELECT is((SELECT count(*) FROM drive_file_versions WHERE file_node_id=:nid)::int, 1, 'no new version row after BZ149');
SELECT is((SELECT used_bytes FROM drive_spaces WHERE id=:sid), :ub0::bigint, 'quota unchanged after BZ149');
SELECT drive_file_unlock(:a, :nid, false);

-- 2. SOFT lock by A on main -> B saves from the CURRENT (non-stale) base ->
-- NO error, auto-branches anyway (soft protects the holder's expectation of
-- main even from a fresh base), main head UNCHANGED.
SELECT drive_file_lock(:a, :nid, 'soft');
SELECT drive_file_put_version(:b, :nid, repeat('d',64), 10, NULL, :h1,
  format('[{"sha256":"%s","size":10}]', repeat('2',64))::jsonb, NULL, 'b') AS r2 \gset
SELECT is((:'r2'::jsonb->>'conflict')::boolean, TRUE, 'soft lock forces auto-branch even from a current base');
SELECT ok((:'r2'::jsonb->>'branchId') IS NOT NULL, 'auto-branch created');
SELECT is((SELECT head_version_id FROM drive_files WHERE node_id=:nid), :h1::bigint, 'main head UNCHANGED under a soft lock');
SELECT drive_file_unlock(:a, :nid, false);

-- 3. Hard lock EXPIRED -> B's save lands clean, head advances.
SELECT drive_file_lock(:a, :nid, 'hard');
UPDATE drive_file_locks SET expires_at = now() - interval '1 minute' WHERE node_id=:nid;
SELECT drive_chunk_register(:b, :sid, repeat('3',64), 10);
SELECT drive_file_put_version(:b, :nid, repeat('e',64), 10, NULL, :h1,
  format('[{"sha256":"%s","size":10}]', repeat('3',64))::jsonb, NULL, 'b') AS r3 \gset
SELECT is((:'r3'::jsonb->>'conflict')::boolean, FALSE, 'expired hard lock: save lands clean');
SELECT is((SELECT head_version_id FROM drive_files WHERE node_id=:nid),
  (:'r3'::jsonb->>'versionId')::bigint, 'head advanced past the expired lock');
DELETE FROM drive_file_locks WHERE node_id=:nid;

-- 4. Hard lock by A on a BRANCH R -> B's save to MAIN is free (per-ref
-- match); B's save to R is BZ149.
SELECT drive_branch_create(:m, :nid, 'R', (:'r3'::jsonb->>'versionId')::bigint) AS rbid \gset
SELECT drive_file_lock(:a, :nid, 'hard', :rbid);
SELECT drive_chunk_register(:b, :sid, repeat('4',64), 10);
SELECT drive_file_put_version(:b, :nid, repeat('f',64), 10, NULL, (:'r3'::jsonb->>'versionId')::bigint,
  format('[{"sha256":"%s","size":10}]', repeat('4',64))::jsonb, NULL, 'b') AS r4 \gset
SELECT is((:'r4'::jsonb->>'conflict')::boolean, FALSE, 'main save is free while the lock is held on a different ref (R)');
SELECT throws_ok(format($$ SELECT drive_file_put_version(%s, %s, %L, 10, NULL,
  (SELECT head_version_id FROM drive_file_branches WHERE id=%s),
  '[{"sha256":"%s","size":10}]', NULL, 'b', %s) $$,
  :b, :nid, repeat('7',64), :rbid, repeat('4',64), :rbid),
  'BZ149', NULL, 'save to the LOCKED ref (R) itself → BZ149');

-- 5. A (the holder) saves under their own hard lock -> clean, head advances.
SELECT drive_chunk_register(:a, :sid, repeat('5',64), 10);
SELECT drive_file_put_version(:a, :nid, repeat('8',64), 10, NULL,
  (SELECT head_version_id FROM drive_file_branches WHERE id=:rbid),
  format('[{"sha256":"%s","size":10}]', repeat('5',64))::jsonb, NULL, 'a', :rbid) AS r5 \gset
SELECT is((:'r5'::jsonb->>'conflict')::boolean, FALSE, 'the lock holder''s own save under their own hard lock is clean');
SELECT is((SELECT head_version_id FROM drive_file_branches WHERE id=:rbid),
  (:'r5'::jsonb->>'versionId')::bigint, 'branch head advanced by the holder''s own save');

-- 6. Break by manager and by subtree folder-admin each succeed and audit
-- lock.break; a non-admin editor break → BZ140; after the break, B's save
-- to R lands.
SELECT throws_ok(format($$ SELECT drive_file_unlock(%s, %s, true) $$, :b, :nid), 'BZ140', NULL, 'non-admin editor break → BZ140');
SELECT drive_file_unlock(:m, :nid, true);
SELECT ok(EXISTS (SELECT 1 FROM drive_audit_log WHERE space_id=:sid AND action='lock.break' AND user_id=:m), 'manager break audited');
SELECT drive_file_lock(:a, :nid, 'hard', :rbid);
SELECT drive_file_unlock(:fa, :nid, true);
SELECT ok(EXISTS (SELECT 1 FROM drive_audit_log WHERE space_id=:sid AND action='lock.break' AND user_id=:fa), 'subtree folder-admin break audited');
SELECT drive_chunk_register(:b, :sid, repeat('6',64), 10);
SELECT drive_file_put_version(:b, :nid, repeat('9',64), 10, NULL,
  (SELECT head_version_id FROM drive_file_branches WHERE id=:rbid),
  format('[{"sha256":"%s","size":10}]', repeat('6',64))::jsonb, NULL, 'b', :rbid) AS r6 \gset
SELECT is((:'r6'::jsonb->>'conflict')::boolean, FALSE, 'after the break, B''s save lands clean');

SELECT * FROM finish();
ROLLBACK;
