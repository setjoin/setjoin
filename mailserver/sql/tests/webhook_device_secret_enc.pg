-- webhook_device_secret_enc.pg — pgTAP for V260 (D6 / DBSCHEMA-005): the
-- remaining RECOVERABLE secrets move to the family's AES-256-GCM _enc format
-- with key-id handling (the V247 device_hmac_secret_enc pattern):
--   webhook_subscriptions.secret / prev_secret (per-subscription HMAC signing
--   secrets) and device_registry.device_secret (legacy MAM check-in key, no
--   live writer/reader). oidc_clients.secret is deliberately NOT covered —
--   it stores bcrypt verifiers (non-recoverable), outside D6's scope.
--
-- Proven here (this package's acceptance ONLY):
--   1. ciphertext-only storage: the at-rest shape (nullable plaintext columns
--      + _enc/key_id pairs); create-shaped and rotation-shaped rows store ONLY
--      _enc ciphertext (plaintext cells NULL, envelopes + active key id);
--   2. legacy-compat: a pre-V260 plaintext row is still claimed by
--      webhook_delivery_claim, and the Go lazy-migration UPDATE shape (one
--      atomic re-seal, plaintext out) ends ciphertext-only with the reducer
--      still functioning — including a ROTATED legacy row: both secret and
--      prev_secret drain in the SAME update (Astra D6 impl-r2 finding 1),
--      a swapped prev makes the whole re-seal a no-op (R3), and no phantom
--      prev envelope appears on a row that never had one;
--   3. no secret material crosses the SQL boundary: the delivery-claim JSON
--      carries url but NO secret cell for legacy, ciphertext, and
--      unknown-key-id rows alike — the unknown/unstamped key-id refusal
--      itself lives in the Go codec (shared/webhook, fail-closed) because SQL
--      holds no decrypt path (the master key never enters the database);
--      proven in SQL as: an unknown-key-id envelope is stored verbatim and
--      still yields a claim with no secret material;
--   4. device_registry.device_secret has a migration path despite having no
--      live reader (Astra D6 impl-r2 finding 2): the startup backfill's
--      UPDATE shape (mailserver/internal/mdm BackfillRegistryDeviceSecrets)
--      drains the archived plaintext into the envelope and is idempotent;
--   5. the settlement contract the dispatcher's retryable classification
--      relies on (Astra D6 impl-r2 finding 4): a claimed delivery settled
--      retryable=true returns to the retry queue (failed + backoff), never
--      exhausted;
--   6. the V260 schema_migrations record exists.
-- The EK01 envelope CONTENT (AES-256-GCM under the app master key) is proven
-- by the shared/webhook Go tests; SQL only exercises the storage shape with
-- placeholder envelopes ('EK01' magic || random body).
BEGIN;
SELECT plan(28);

-- ── 1–9: schema shape ────────────────────────────────────────────────────────
SELECT has_column('webhook_subscriptions', 'secret_enc',
  'webhook_subscriptions has the secret_enc envelope column');
SELECT col_type_is('webhook_subscriptions', 'secret_enc', 'bytea',
  'secret_enc is bytea (EK01 envelope)');
SELECT has_column('webhook_subscriptions', 'secret_key_id',
  'webhook_subscriptions has the secret_key_id key-version column');
SELECT col_type_is('webhook_subscriptions', 'secret_key_id', 'text',
  'secret_key_id is text');
SELECT has_column('webhook_subscriptions', 'prev_secret_enc',
  'webhook_subscriptions has the prev_secret_enc rotation-grace envelope column');
SELECT has_column('webhook_subscriptions', 'prev_secret_key_id',
  'webhook_subscriptions has the prev_secret_key_id key-version column');
SELECT has_column('device_registry', 'device_secret_enc',
  'device_registry has the device_secret_enc envelope column');
SELECT col_type_is('device_registry', 'device_secret_enc', 'bytea',
  'device_secret_enc is bytea (EK01 envelope)');
SELECT has_column('device_registry', 'device_secret_key_id',
  'device_registry has the device_secret_key_id key-version column');
SELECT ok(
  (SELECT NOT attnotnull FROM pg_attribute
    WHERE attrelid = 'webhook_subscriptions'::regclass AND attname = 'secret'),
  'webhook_subscriptions.secret dropped NOT NULL (legacy rows + ciphertext-only writes coexist)');

-- ── 10: create-shaped write stores ONLY ciphertext ──────────────────────────
-- Mirrors the Go writers (user/admin webhook Create): envelope + key id in,
-- plaintext never persisted (secret NULL — possible only after V260 dropped
-- NOT NULL). Organization scope needs no user row.
INSERT INTO webhook_subscriptions (id, url, secret, secret_enc, secret_key_id, event_types, scope)
VALUES (900401, 'https://enc.test/create', NULL,
        'EK01'::bytea || gen_random_bytes(48), 'v1', '["mail.received"]', 'organization');
SELECT is(
  (SELECT (secret IS NULL)::int
          + (secret_enc IS NOT NULL)::int
          + (secret_key_id = 'v1')::int
     FROM webhook_subscriptions WHERE id = 900401),
  3,
  'create-shaped row stores only _enc ciphertext with the active key id');

-- ── 11: rotation-shaped write ends ciphertext-only in all four cells ────────
-- Mirrors the Go RotateSecret: previous value re-sealed into prev_*, new
-- envelope installed, every plaintext cell NULL.
INSERT INTO webhook_subscriptions (id, url, secret, prev_secret,
                                   secret_enc, secret_key_id,
                                   prev_secret_enc, prev_secret_key_id,
                                   event_types, scope)
VALUES (900402, 'https://enc.test/rotate', NULL, NULL,
        'EK01'::bytea || gen_random_bytes(48), 'v1',
        'EK01'::bytea || gen_random_bytes(48), 'v1',
        '["mail.received"]', 'organization');
SELECT is(
  (SELECT (secret IS NULL)::int
          + (prev_secret IS NULL)::int
          + (secret_enc IS NOT NULL)::int
          + (secret_key_id = 'v1')::int
          + (prev_secret_enc IS NOT NULL)::int
          + (prev_secret_key_id = 'v1')::int
     FROM webhook_subscriptions WHERE id = 900402),
  6,
  'rotation-shaped row is ciphertext-only across all four secret cells');

-- ── 12–13: legacy-compat — plaintext row still claimed, claim has no secret ─
-- Pre-V260 row: the issued value sits in plaintext. The delivery claim must
-- keep functioning (compatibility leg) while carrying NO secret material.
-- The claim is captured ONCE (claiming leases the row, so a second call with
-- the same event filter would legitimately return an empty array).
INSERT INTO webhook_subscriptions (id, url, secret, event_types, scope)
VALUES (900403, 'https://enc.test/legacy', 'legacy-issued-webhook-secret',
        '["mail.received"]', 'organization');
INSERT INTO webhook_deliveries (subscription_id, event_id, event_type, request_body, attempt, status)
VALUES (900403, 'enc-legacy-event', 'mail.received', '{"specversion":"1.0"}', 0, 'pending');
CREATE TEMP TABLE enc_legacy_claim AS
  SELECT webhook_delivery_claim(gen_random_uuid(), 10, 'enc-legacy-event') AS claims;
SELECT is(
  jsonb_array_length((SELECT claims FROM enc_legacy_claim)),
  1,
  'legacy plaintext row is still claimed by the delivery claim reducer (compat leg)');
SELECT is(
  (SELECT (claims->0->>'url' = 'https://enc.test/legacy')::int
          + (NOT claims->0 ? 'secret')::int
          + (NOT claims->0 ? 'secret_enc')::int
     FROM enc_legacy_claim),
  3,
  'delivery claim carries url but NO signing-secret material');

-- ── 14–15: lazy migration (the Go reader's atomic re-seal) ──────────────────
-- The exact UPDATE shape shared/webhook LoadSubscriptionSecret runs on first
-- delivery: envelope + key id in, plaintext out, predicated on the exact
-- values just loaded (R3, with the NULL-safe IS NOT DISTINCT FROM on
-- prev_secret). This row has no rotation-grace prev, so the prev cells must
-- be left UNtouched (no phantom prev envelope for a prev that never existed).
UPDATE webhook_subscriptions
   SET secret_enc           = 'EK01'::bytea || gen_random_bytes(48),
       secret_key_id        = 'v1',
       secret               = NULL,
       prev_secret_enc      = COALESCE(prev_secret_enc, NULL),
       prev_secret_key_id   = COALESCE(prev_secret_key_id, NULL),
       prev_secret          = NULL
 WHERE id = 900403 AND secret = 'legacy-issued-webhook-secret' AND secret_enc IS NULL
   AND prev_secret IS NOT DISTINCT FROM NULL;
SELECT is(
  (SELECT (secret IS NULL)::int
          + (secret_enc IS NOT NULL)::int
          + (secret_key_id = 'v1')::int
          + (prev_secret IS NULL)::int
          + (prev_secret_enc IS NULL)::int
          + (prev_secret_key_id IS NULL)::int
     FROM webhook_subscriptions WHERE id = 900403),
  6,
  'row migrated from plaintext stores only _enc ciphertext and NO phantom prev envelope');
SELECT is(
  (SELECT secret FROM webhook_subscriptions WHERE id = 900403),
  NULL,
  'the issued plaintext is gone after lazy migration');

-- ── 16: rotated legacy row migrates BOTH secrets in ONE update ──────────────
-- Astra D6 impl-r2 finding 1: a pre-V260 ROTATED row holds plaintext in BOTH
-- secret and prev_secret. The lazy migration drains both cells in the same
-- atomic UPDATE — a row must never end migrated while prev_secret stays
-- plaintext. (Placeholder envelopes stand in for codec.Seal output; SQL
-- cannot seal — the master key never enters the database.)
INSERT INTO webhook_subscriptions (id, url, secret, prev_secret, event_types, scope)
VALUES (900405, 'https://enc.test/legacy-rotated', 'legacy-current-webhook-secret',
        'legacy-previous-webhook-secret', '["mail.received"]', 'organization');
UPDATE webhook_subscriptions
   SET secret_enc           = 'EK01'::bytea || gen_random_bytes(48),
       secret_key_id        = 'v1',
       secret               = NULL,
       prev_secret_enc      = COALESCE(prev_secret_enc, 'EK01'::bytea || gen_random_bytes(48)),
       prev_secret_key_id   = COALESCE(prev_secret_key_id, 'v1'),
       prev_secret          = NULL
 WHERE id = 900405 AND secret = 'legacy-current-webhook-secret' AND secret_enc IS NULL
   AND prev_secret IS NOT DISTINCT FROM 'legacy-previous-webhook-secret';
SELECT is(
  (SELECT (secret IS NULL)::int
          + (prev_secret IS NULL)::int
          + (secret_enc IS NOT NULL)::int
          + (secret_key_id = 'v1')::int
          + (prev_secret_enc IS NOT NULL)::int
          + (prev_secret_key_id = 'v1')::int
     FROM webhook_subscriptions WHERE id = 900405),
  6,
  'rotated legacy row ends ciphertext-only in ALL FOUR cells after one load');
SELECT is(
  (SELECT (secret IS NULL)::int + (prev_secret IS NULL)::int
     FROM webhook_subscriptions WHERE id = 900405),
  2,
  'neither the current nor the rotation-grace plaintext survives the migration');

-- ── 17: R3 no-op — a concurrent prev swap blocks the whole re-seal ─────────
-- The migration UPDATE is predicated on the EXACT values loaded. A concurrent
-- rotation that replaced prev_secret between the read and the re-seal makes
-- the whole UPDATE a no-op instead of sealing a value the call never saw.
INSERT INTO webhook_subscriptions (id, url, secret, prev_secret, event_types, scope)
VALUES (900406, 'https://enc.test/legacy-race', 'legacy-race-current-secret',
        'legacy-race-loaded-prev', '["mail.received"]', 'organization');
-- The concurrent rotation lands first: prev_secret is replaced under us.
UPDATE webhook_subscriptions SET prev_secret = 'legacy-race-rotated-prev' WHERE id = 900406;
UPDATE webhook_subscriptions
   SET secret_enc           = 'EK01'::bytea || gen_random_bytes(48),
       secret_key_id        = 'v1',
       secret               = NULL,
       prev_secret_enc      = COALESCE(prev_secret_enc, 'EK01'::bytea || gen_random_bytes(48)),
       prev_secret_key_id   = COALESCE(prev_secret_key_id, 'v1'),
       prev_secret          = NULL
 WHERE id = 900406 AND secret = 'legacy-race-current-secret' AND secret_enc IS NULL
   AND prev_secret IS NOT DISTINCT FROM 'legacy-race-loaded-prev';
SELECT is(
  (SELECT (secret = 'legacy-race-current-secret')::int
          + (prev_secret = 'legacy-race-rotated-prev')::int
          + (secret_enc IS NULL)::int
     FROM webhook_subscriptions WHERE id = 900406),
  3,
  'a swapped prev makes the whole migration UPDATE a no-op (R3, no partial re-seal)');

-- ── 18–19: unknown key id — stored verbatim, no SQL decrypt path ────────────
-- The Go codec refuses an envelope whose key id it does not recognize
-- (fail-closed; proven in shared/webhook tests). SQL's side of the contract:
-- such an envelope is stored verbatim (no SQL ever rewrites or decrypts it)
-- and the claim layer still exposes no secret material.
INSERT INTO webhook_subscriptions (id, url, secret, secret_enc, secret_key_id, event_types, scope)
VALUES (900404, 'https://enc.test/unknownkey', NULL,
        'EK01'::bytea || gen_random_bytes(48), 'v-future', '["mail.received"]', 'organization');
INSERT INTO webhook_deliveries (subscription_id, event_id, event_type, request_body, attempt, status)
VALUES (900404, 'enc-unknownkey-event', 'mail.received', '{"specversion":"1.0"}', 0, 'pending');
SELECT is(
  (SELECT (secret_key_id = 'v-future')::int + (secret IS NULL)::int
     FROM webhook_subscriptions WHERE id = 900404),
  2,
  'unknown-key-id envelope is stored verbatim (SQL holds no rewrite/decrypt path)');
CREATE TEMP TABLE enc_unknownkey_claim AS
  SELECT webhook_delivery_claim(gen_random_uuid(), 10, 'enc-unknownkey-event') AS claims;
SELECT is(
  (SELECT jsonb_array_length(claims)::int
          + (NOT claims->0 ? 'secret')::int
          + (NOT claims->0 ? 'secret_enc')::int
     FROM enc_unknownkey_claim),
  3,
  'unknown-key-id row still claims and the claim still carries no secret material');

-- ── 20: device_registry backfill (the migration path for the archived ───────
-- legacy check-in secret). Astra D6 impl-r2 finding 2: the column has NO live
-- reader, so lazy migration can never drain it — the startup backfill
-- (mailserver/internal/mdm BackfillRegistryDeviceSecrets) seals legacy
-- plaintext into the V260 envelope and NULLs the plaintext with the same R3
-- predicate shape. Placeholder envelope stands in for codec output; SQL
-- cannot seal (the master key never enters the database).
INSERT INTO domains (name, is_local)
VALUES ('enc-backfill.test', TRUE)
ON CONFLICT (name) DO NOTHING;
INSERT INTO users (id, username, domain_id, email, display_name, password_hash)
VALUES (900610, 'enc-backfill', (SELECT id FROM domains WHERE name = 'enc-backfill.test'),
        'enc-backfill@enc-backfill.test', 'Enc Backfill', 'x')
ON CONFLICT (id) DO NOTHING;
INSERT INTO device_registry (id, user_id, device_hash, device_secret)
VALUES (900611, 900610, 'enc-backfill-legacy', 'legacy-mam-checkin-hmac-key');
UPDATE device_registry
   SET device_secret_enc    = 'EK01'::bytea || gen_random_bytes(48),
       device_secret_key_id = 'v1',
       device_secret        = NULL
 WHERE id = 900611
   AND device_secret = 'legacy-mam-checkin-hmac-key'
   AND device_secret_enc IS NULL;
SELECT is(
  (SELECT (device_secret IS NULL)::int
          + (device_secret_enc IS NOT NULL)::int
          + (device_secret_key_id = 'v1')::int
     FROM device_registry WHERE id = 900611),
  3,
  'backfilled device_registry row stores only the envelope (legacy plaintext drained)');
SELECT is(
  (SELECT device_secret FROM device_registry WHERE id = 900611),
  NULL,
  'the archived check-in plaintext is gone after the backfill');
-- Idempotence: a drained row is never selected again (envelope + R3 predicate).
UPDATE device_registry
   SET device_secret_enc    = 'EK01'::bytea || gen_random_bytes(48),
       device_secret_key_id = 'v1',
       device_secret        = NULL
 WHERE id = 900611
   AND device_secret = 'legacy-mam-checkin-hmac-key'
   AND device_secret_enc IS NULL;
SELECT is(
  (SELECT (device_secret IS NULL)::int + (device_secret_enc IS NOT NULL)::int
     FROM device_registry WHERE id = 900611),
  2,
  'a second backfill pass is a no-op on a drained row');

-- ── 21–22: transient secret-read failure settles RETRYABLE (item 4 contract) ──
-- The dispatcher settles a failed secret read with retryable=true so a
-- transient read error returns the claimed delivery to the backoff queue
-- instead of exhausting it. SQL's side of that contract: retryable=true on a
-- claimed row with retries remaining yields 'failed' with a next attempt
-- scheduled; only retryable=false (or an exhausted budget) is terminal.
INSERT INTO webhook_deliveries (subscription_id, event_id, event_type, request_body, attempt, status)
VALUES (900404, 'enc-retryable-event', 'mail.received', '{"specversion":"1.0"}', 0, 'pending');
CREATE TEMP TABLE enc_retryable_claim AS
  SELECT webhook_delivery_claim('22222222-2222-4222-8222-222222222222'::uuid, 1, 'enc-retryable-event') AS claims;
SELECT is(
  (SELECT jsonb_array_length(claims) FROM enc_retryable_claim),
  1,
  'claimed delivery is pending settlement after the read failure');
SELECT is(
  webhook_delivery_complete(
    (SELECT (claims->0->>'id')::bigint FROM enc_retryable_claim),
    '22222222-2222-4222-8222-222222222222'::uuid,
    false, true, NULL, NULL, NULL,
    'signing secret unavailable: webhook: signing secret requires unavailable key version "v-future"'),
  true,
  'the lease-owner retryable settlement is accepted');
SELECT is(
  (SELECT (status = 'failed')::int + (next_attempt_at IS NOT NULL)::int + (lease_owner IS NULL)::int
     FROM webhook_deliveries WHERE event_id = 'enc-retryable-event'),
  3,
  'a transient secret-read failure returns the delivery to the retry queue (failed + backoff), not exhausted');

-- ── 23: schema_migrations record ────────────────────────────────────────────
SELECT ok(
  (SELECT EXISTS (SELECT 1 FROM schema_migrations WHERE version = 260)),
  'V260 recorded in schema_migrations');

SELECT * FROM finish();
ROLLBACK;
