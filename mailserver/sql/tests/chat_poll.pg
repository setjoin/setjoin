-- chat_poll.pg: polls reducer (Pillar A3 QoL Task 9).
-- Requires: chat_channel.sql, chat_message.sql, notify_chat_state.sql,
-- chat_poll.sql. chat_channel_members has no FK to users (V119) so bare
-- bigint ids suffice (chat_poll_close's creator/owner/admin check reads only
-- chat_channel_members.role, never users.is_local_admin).
BEGIN;
SELECT plan(27);
SELECT set_config('app.capture_notify', 'on', true);

-- Fixture: a channel with creator 931 (owner), member 932 (plain member),
-- a second member 933 (later promoted to admin), and a non-member 934.
SELECT chat_channel_create(931, 'poll-general') AS ch_id \gset
SELECT chat_member_add(931, :ch_id, 932);
SELECT chat_member_add(931, :ch_id, 933);

-- ── create posts a poll message through the chat_message_send seam ───────
SELECT chat_poll_create(931, :ch_id, 'Best language?', ARRAY['Go','SQL','Rust'], false, NULL) AS poll1_json \gset
SELECT (:'poll1_json'::jsonb ->> 'pollId')::bigint AS poll1_id \gset
SELECT (:'poll1_json'::jsonb ->> 'messageId')::bigint AS poll1_msg_id \gset

SELECT is((SELECT msg_type FROM chat_messages WHERE id = :poll1_msg_id), 'poll',
  'poll create posts a msg_type=poll message through the send seam');
SELECT is((SELECT question FROM chat_polls WHERE id = :poll1_id), 'Best language?',
  'chat_polls row carries the question');
SELECT is((SELECT count(*)::int FROM chat_poll_options WHERE poll_id = :poll1_id), 3,
  'three options created');
SELECT is((SELECT (chat_message_to_json(m, 931) -> 'payload' ->> 'pollId')::bigint
             FROM chat_messages m WHERE m.id = :poll1_msg_id), :poll1_id::bigint,
  'the message payload carries pollId (Task 6 seam)');

SELECT id AS opt1_id FROM chat_poll_options WHERE poll_id = :poll1_id AND ordinal = 1 \gset
SELECT id AS opt2_id FROM chat_poll_options WHERE poll_id = :poll1_id AND ordinal = 2 \gset

-- ── BZ163: a non-member cannot vote or read results ───────────────────────
SELECT throws_ok(format($$ SELECT chat_poll_vote(934, %s, %s) $$, :poll1_id, :opt1_id),
  'BZ163', NULL, 'non-member cannot vote (BZ163)');
SELECT throws_ok(format($$ SELECT chat_poll_results(934, %s) $$, :poll1_id),
  'BZ163', NULL, 'non-member sees nothing (chat_poll_results raises BZ163)');

-- ── BZ177: voting an option that belongs to a DIFFERENT poll ──────────────
SELECT chat_poll_create(931, :ch_id, 'Pick toppings', ARRAY['Cheese','Olives','Mushroom'], true, NULL) AS poll2_json \gset
SELECT (:'poll2_json'::jsonb ->> 'pollId')::bigint AS poll2_id \gset
SELECT id AS p2_opt1_id FROM chat_poll_options WHERE poll_id = :poll2_id AND ordinal = 1 \gset
SELECT id AS p2_opt2_id FROM chat_poll_options WHERE poll_id = :poll2_id AND ordinal = 2 \gset
SELECT throws_ok(format($$ SELECT chat_poll_vote(932, %s, %s) $$, :poll1_id, :p2_opt1_id),
  'BZ177', NULL, 'voting an option from a different poll raises BZ177 (bad option)');

-- ── single-vote: casting a second vote REPLACES the first (delete-then-
-- insert), never leaves two rows for the same (poll,user) ────────────────
SELECT chat_poll_vote(932, :poll1_id, :opt1_id);
SELECT is((SELECT count(*)::int FROM chat_poll_votes
            WHERE poll_id = :poll1_id AND user_id = 932), 1, 'first vote recorded');
SELECT is(last_notify_event('chat:933'), 'poll_voted', 'vote fans out poll_voted to other members');
SELECT chat_poll_vote(932, :poll1_id, :opt2_id);
SELECT is((SELECT count(*)::int FROM chat_poll_votes
            WHERE poll_id = :poll1_id AND user_id = 932), 1,
  'single-vote poll: switching options replaces the prior vote, never two rows');
SELECT is((SELECT option_id FROM chat_poll_votes
            WHERE poll_id = :poll1_id AND user_id = 932), :opt2_id::bigint,
  'the surviving vote is the NEW option');

-- ── multi: voting for N different options all accumulate ─────────────────
SELECT chat_poll_vote(932, :poll2_id, :p2_opt1_id);
SELECT chat_poll_vote(932, :poll2_id, :p2_opt2_id);
SELECT is((SELECT count(*)::int FROM chat_poll_votes
            WHERE poll_id = :poll2_id AND user_id = 932), 2,
  'multi poll: two different options both retained for the same voter');

-- ── manual close: a plain member (not creator, not owner/admin) is
-- rejected — reuses BZ161 (not owner/admin), the poll creator is the one
-- extra accepted actor, same "author OR owner/admin" shape as
-- chat_message_delete's BZ167 ─────────────────────────────────────────────
SELECT throws_ok(format($$ SELECT chat_poll_close(933, %s) $$, :poll1_id),
  'BZ161', NULL, 'a plain member (not creator, not admin) cannot close a poll (BZ161)');

-- ── the CREATOR can close their own poll ──────────────────────────────────
SELECT chat_poll_close(931, :poll1_id);
SELECT ok((SELECT closes_at FROM chat_polls WHERE id = :poll1_id) IS NOT NULL,
  'creator close sets closes_at');

-- ── voting a CLOSED poll raises BZ177 ──────────────────────────────────────
SELECT throws_ok(format($$ SELECT chat_poll_vote(932, %s, %s) $$, :poll1_id, :opt1_id),
  'BZ177', NULL, 'voting a closed poll raises BZ177');

-- ── a channel ADMIN (not the creator) can also close ──────────────────────
UPDATE chat_channel_members SET role = 'admin' WHERE channel_id = :ch_id AND user_id = 933;
SELECT chat_poll_close(933, :poll2_id);
SELECT ok((SELECT closes_at FROM chat_polls WHERE id = :poll2_id) IS NOT NULL,
  'a channel admin (not the creator) can close a poll too');

-- ── voting on a message whose anchor was soft-deleted: BZ177, rows RETAINED
-- (poll + votes are never destroyed — A1's never-destroy principle) ──────
SELECT chat_poll_create(931, :ch_id, 'Poll to delete', ARRAY['X','Y'], false, NULL) AS poll3_json \gset
SELECT (:'poll3_json'::jsonb ->> 'pollId')::bigint AS poll3_id \gset
SELECT (:'poll3_json'::jsonb ->> 'messageId')::bigint AS poll3_msg_id \gset
SELECT id AS p3_opt1_id FROM chat_poll_options WHERE poll_id = :poll3_id AND ordinal = 1 \gset
SELECT chat_poll_vote(932, :poll3_id, :p3_opt1_id);
SELECT chat_message_delete(931, :poll3_msg_id);
SELECT throws_ok(format($$ SELECT chat_poll_vote(933, %s, %s) $$, :poll3_id, :p3_opt1_id),
  'BZ177', NULL, 'voting on a poll whose anchor message was soft-deleted raises BZ177');
SELECT is((SELECT count(*)::int FROM chat_polls WHERE id = :poll3_id), 1,
  'the poll row is RETAINED after the anchor message is soft-deleted');
SELECT is((SELECT count(*)::int FROM chat_poll_votes WHERE poll_id = :poll3_id), 1,
  'the prior vote row is RETAINED after the anchor message is soft-deleted');

-- ── nonexistent poll: BZ177 (one code, no oracle on why) ──────────────────
SELECT throws_ok($$ SELECT chat_poll_vote(931, 999999999, 1) $$,
  'BZ177', NULL, 'voting a nonexistent poll raises BZ177');
SELECT throws_ok($$ SELECT chat_poll_close(931, 999999999) $$,
  'BZ177', NULL, 'closing a nonexistent poll raises BZ177');

-- ── results: tally + per-option voter lists ───────────────────────────────
SELECT chat_poll_results(932, :poll2_id) AS results_json \gset
SELECT is(jsonb_array_length(:'results_json'::jsonb -> 'options'), 3,
  'results carries all three options for poll2');
SELECT ok(
  (SELECT (o ->> 'count')::int FROM jsonb_array_elements(:'results_json'::jsonb -> 'options') o
    WHERE (o ->> 'optionId')::bigint = :p2_opt1_id) = 1,
  'results tallies the vote count for the voted option');
SELECT ok(
  (SELECT bool_or((v)::bigint = 932) FROM jsonb_array_elements_text(
     (SELECT o -> 'voters' FROM jsonb_array_elements(:'results_json'::jsonb -> 'options') o
       WHERE (o ->> 'optionId')::bigint = :p2_opt1_id)) v),
  'results lists the voter (per-voter-visible, not anonymous)');
SELECT is(:'results_json'::jsonb ->> 'question', 'Pick toppings', 'results carries the poll question');
SELECT is((:'results_json'::jsonb ->> 'multi')::boolean, true, 'results carries multi=true');
SELECT is((:'results_json'::jsonb ->> 'closed')::boolean, true, 'results reflects closed=true after chat_poll_close');

SELECT * FROM finish();
ROLLBACK;
