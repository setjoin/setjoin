-- chat_scheduled_send.pg: the scheduled-send reducer trio (Pillar A3 QoL
-- Task 2) — chat_schedule_message/chat_scheduled_list/chat_scheduled_cancel
-- (chat_schedule.sql) + the scheduled_actions_dispatch.sql `chat_send`
-- handler (scheduled_action_chat_send.sql). chat_channel_members has no FK
-- to users (V119) so bare bigint ids suffice.
-- Requires: chat_channel.sql, notify_chat_state.sql, chat_message.sql,
-- scheduled_action_enqueue.sql, scheduled_actions_dispatch.sql,
-- chat_schedule.sql, scheduled_action_chat_send.sql.
BEGIN;
SELECT plan(22);

-- Fixture: a channel with owner 9501, member 9502, non-member 9503.
SELECT chat_channel_create(9501, 'scheduled-general') AS ch_id \gset
SELECT chat_member_add(9501, :ch_id, 9502);

-- ── BZ163: a non-member cannot schedule a send ──────────────────────────
SELECT throws_ok(
  format($$ SELECT chat_schedule_message(9503, %s, 'hi', NULL, '{}'::bigint[], NULL, now() + interval '1 hour') $$, :ch_id),
  'BZ163', NULL, 'non-member cannot schedule a send (BZ163)');

-- ── BZ179: a NULL / past fireAt is rejected at enqueue ──────────────────
SELECT throws_ok(
  format($$ SELECT chat_schedule_message(9501, %s, 'hi', NULL, '{}'::bigint[], NULL, NULL) $$, :ch_id),
  'BZ179', NULL, 'a NULL fireAt raises BZ179');
SELECT throws_ok(
  format($$ SELECT chat_schedule_message(9501, %s, 'hi', NULL, '{}'::bigint[], NULL, now() - interval '1 hour') $$, :ch_id),
  'BZ179', NULL, 'a past fireAt raises BZ179');

-- ── enqueue: a NULL-mailbox row, dedup_key defaulted to the action id ───
SELECT chat_schedule_message(9501, :ch_id, 'scheduled hello', NULL, '{}'::bigint[], NULL,
         now() + interval '2 hours') AS action_id \gset
SELECT is(
  (SELECT action_kind FROM scheduled_actions WHERE id = :'action_id'::uuid),
  'chat_send', 'enqueued row has action_kind=chat_send');
SELECT ok(
  (SELECT mailbox_id IS NULL FROM scheduled_actions WHERE id = :'action_id'::uuid),
  'the chat_send row carries mailbox_id=NULL (ownership lives in payload, not the column)');
SELECT is(
  (SELECT dedup_key FROM scheduled_actions WHERE id = :'action_id'::uuid),
  :'action_id', 'dedup_key defaults to the action id, same as send');

-- ── fire delivers: force fire_at into the past, run the real dispatcher ──
UPDATE scheduled_actions SET fire_at = now() - interval '1 minute' WHERE id = :'action_id'::uuid;
SELECT dispatch_scheduled_actions('test-worker');
SELECT is(
  (SELECT status FROM scheduled_actions WHERE id = :'action_id'::uuid),
  'done', 'a fired chat_send action reaches terminal done');
SELECT ok(
  EXISTS (SELECT 1 FROM chat_messages WHERE channel_id = :ch_id AND body = 'scheduled hello'),
  'the scheduled message was actually posted to the channel at fire time');

-- ── kicked-member fires -> permanent_fail, not a retry loop ─────────────
SELECT chat_schedule_message(9502, :ch_id, 'kicked before fire', NULL, '{}'::bigint[], NULL,
         now() + interval '2 hours') AS kicked_action_id \gset
SELECT chat_member_remove(9501, :ch_id, 9502);  -- owner kicks 9502
UPDATE scheduled_actions SET fire_at = now() - interval '1 minute' WHERE id = :'kicked_action_id'::uuid;
SELECT dispatch_scheduled_actions('test-worker');
SELECT is(
  (SELECT status FROM scheduled_actions WHERE id = :'kicked_action_id'::uuid),
  'failed', 'a kicked member''s fire-time send terminates failed, not pending/retry');
SELECT is(
  (SELECT attempts FROM scheduled_actions WHERE id = :'kicked_action_id'::uuid),
  1, 'exactly one attempt — no retry loop for a permanent membership failure');
SELECT is(
  (SELECT payload->>'failureCode' FROM scheduled_actions WHERE id = :'kicked_action_id'::uuid),
  'BZ163', 'the caught BZ is recorded onto the action payload (failureCode)');
SELECT ok(
  NOT EXISTS (SELECT 1 FROM chat_messages WHERE channel_id = :ch_id AND body = 'kicked before fire'),
  'the kicked member''s message was never actually posted');

-- ── failed row stays visible on the list, with its reason + body ───────
SELECT is(jsonb_array_length(chat_scheduled_list(9502)), 1,
  'the failed row still appears on the owning user''s scheduled list');
SELECT is((chat_scheduled_list(9502) -> 0 ->> 'status'), 'failed',
  'the listed row reports status=failed');
SELECT is((chat_scheduled_list(9502) -> 0 ->> 'failureCode'), 'BZ163',
  'the listed row surfaces the failureCode for client-side i18n mapping');
SELECT is((chat_scheduled_list(9502) -> 0 ->> 'body'), 'kicked before fire',
  'the listed row still carries the original (copyable) body');

-- ── dismiss: cancel works on a FAILED row too ────────────────────────────
SELECT chat_scheduled_cancel(9502, :'kicked_action_id'::uuid);
SELECT is(jsonb_array_length(chat_scheduled_list(9502)), 0,
  'dismissing (cancelling) the failed row removes it from the list');

-- ── cancel on a pending row; B cannot cancel A's ────────────────────────
SELECT chat_schedule_message(9501, :ch_id, 'A''s pending send', NULL, '{}'::bigint[], NULL,
         now() + interval '3 hours') AS pending_action_id \gset
SELECT throws_ok(
  format($$ SELECT chat_scheduled_cancel(9502, %L::uuid) $$, :'pending_action_id'),
  'BZ179', NULL, 'a different user cannot cancel A''s pending row (BZ179)');
SELECT chat_scheduled_cancel(9501, :'pending_action_id'::uuid);
SELECT is(
  (SELECT count(*)::int FROM scheduled_actions WHERE id = :'pending_action_id'::uuid),
  0, 'the owner''s own cancel removes the pending row');

-- ── BZ179: cancelling a nonexistent/already-fired row ───────────────────
SELECT throws_ok(
  $$ SELECT chat_scheduled_cancel(9501, gen_random_uuid()) $$,
  'BZ179', NULL, 'cancelling a nonexistent action id raises BZ179');

-- ── list is mine-only ────────────────────────────────────────────────────
-- (9502 was kicked above — use a fresh member 9504, still in the channel.)
SELECT chat_member_add(9501, :ch_id, 9504);
SELECT chat_schedule_message(9501, :ch_id, 'A list-only send', NULL, '{}'::bigint[], NULL,
         now() + interval '4 hours') AS list_a_id \gset
SELECT chat_schedule_message(9504, :ch_id, 'B list-only send', NULL, '{}'::bigint[], NULL,
         now() + interval '4 hours') AS list_b_id \gset
SELECT is(jsonb_array_length(chat_scheduled_list(9501)), 1,
  '9501''s list carries exactly their own pending row');
SELECT ok(
  NOT (SELECT bool_or(elem->>'body' = 'B list-only send')
         FROM jsonb_array_elements(chat_scheduled_list(9501)) elem),
  '9501''s list never includes 9504''s scheduled send');

SELECT * FROM finish();
ROLLBACK;
