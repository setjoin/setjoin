-- notify_chat_state.pg: O(1) channel-keyed sync wakeup bell + O(1) ephemeral
-- typing bell (Wave 2.5 #552). Eliminates O(members) chat:{user_id} fanout in
-- write transactions.
-- Requires: notify_chat_state.
BEGIN;
SELECT plan(12);

INSERT INTO chat_channels (kind, name, created_by)
VALUES ('channel', 'ncs-general-notify-test', 501);
INSERT INTO chat_channel_members (channel_id, user_id, role)
  SELECT id, 501, 'owner' FROM chat_channels WHERE name = 'ncs-general-notify-test'
  UNION ALL
  SELECT id, 502, 'member' FROM chat_channels WHERE name = 'ncs-general-notify-test';

SELECT id AS ch_id FROM chat_channels WHERE name = 'ncs-general-notify-test' \gset

-- Test 1: 4-arg function exists.
SELECT has_function(
  'notify_chat_state', ARRAY['bigint','text','bigint','bigint'],
  'notify_chat_state(channel,event,message_id,seq) exists');

-- Test 2: NULL channel raises BZ160.
SELECT throws_ok(
  $$ SELECT notify_chat_state(NULL, 'message_sent') $$,
  'BZ160', NULL,
  'NULL channel raises BZ160');

-- Test 3: the call itself does not error for a 2-member channel.
SELECT lives_ok(
  format($$ SELECT notify_chat_state(%s, 'message_sent', 5001, 12) $$, :ch_id),
  'notify_chat_state emits O(1) wakeup bell without erroring');

-- Test 4-6: state-changing event emits ONE content-free bell on 'sync' and
-- ZERO per-member chat:<uid> notifications.
SET LOCAL app.capture_notify = 'on';
SELECT notify_chat_state(:ch_id, 'message_sent', 5001, 12);

SELECT is(notify_count('sync'), 1, '2-member channel emits exactly ONE sync bell');
SELECT is(
  last_notify_payload('sync'),
  format('channel:%s:12', :ch_id),
  'sync bell carries content-free channel:<id>:<seq>');
SELECT is(
  notify_count('chat:501') + notify_count('chat:502'),
  0,
  'zero per-member chat:<uid> notifications emitted for state changes');

-- Test 7-9: ephemeral 'typing' (p_seq IS NULL) emits ONE 'chat_ephemeral' bell
-- and ZERO 'sync' bells.
SELECT notify_count('sync') AS sync_before_typing \gset
SELECT notify_chat_state(:ch_id, 'typing', NULL, NULL);

SELECT is(notify_count('chat_ephemeral'), 1, 'typing emits exactly ONE chat_ephemeral bell');
SELECT is(
  last_notify_payload('chat_ephemeral')::jsonb,
  jsonb_build_object('event', 'typing', 'channelId', :ch_id, 'messageId', NULL, 'seq', NULL),
  'chat_ephemeral payload carries event=typing and channelId');
SELECT is(
  notify_count('sync'),
  :sync_before_typing,
  'typing never emits a sync bell');

-- Test 10-12: 50-member channel O(1) proof — exactly ONE 'sync' bell, ZERO
-- chat:<uid> rows regardless of member count.
INSERT INTO chat_channels (kind, name, created_by)
VALUES ('channel', 'ncs-50-member-o1-proof', 501)
RETURNING id AS ch50_id \gset
INSERT INTO chat_channel_members (channel_id, user_id, role)
  SELECT :ch50_id, 6000 + g, CASE WHEN g = 1 THEN 'owner' ELSE 'member' END
  FROM generate_series(1, 50) g;

SELECT notify_count('sync') AS sync_before_50 \gset
SELECT notify_chat_state(:ch50_id, 'message_created', 9001, 77);

SELECT is(
  notify_count('sync'),
  :sync_before_50 + 1,
  '50-member channel emits exactly ONE sync bell (O(1))');
SELECT is(
  last_notify_payload('sync'),
  format('channel:%s:77', :ch50_id),
  '50-member channel sync bell carries channel:<id>:77');
SELECT is(
  (SELECT count(*)::int FROM _test_notify_log WHERE channel LIKE 'chat:%'),
  0,
  '50-member channel emits ZERO chat:<uid> notifications');

SELECT * FROM finish();
ROLLBACK;
