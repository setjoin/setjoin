-- chat_threads.pg: My-Threads inbox (Pillar A3 QoL Task 11). Pure query, no
-- new BZ code (same "filters rather than errors" posture as chat_search.pg
-- and chat_conversation_list) — membership is scoped IN-SQL via a join
-- against chat_channel_members, never raised as an error.
-- chat_channel_members has no FK to users (V119), so bare bigint ids suffice
-- (same posture as chat_search.pg).
BEGIN;
SELECT plan(9);
SELECT set_config('app.capture_notify', 'on', true);

-- Fixture: channel "threads-chan" — 901 owner, 902/903/904 members.
SELECT chat_channel_create(901, 'threads-chan') AS chan \gset
SELECT chat_member_add(901, :chan, 902);
SELECT chat_member_add(901, :chan, 903);
SELECT chat_member_add(901, :chan, 904);

-- Thread 1: 901 authors the root, 902 replies. 904 never touches it.
SELECT chat_message_send(901, :chan, 'root topic one') AS r1 \gset
SELECT (:'r1'::jsonb ->> 'messageId')::bigint AS r1_id \gset
SELECT chat_message_send(902, :chan, 'reply from 902', :r1_id) AS r1_reply \gset
SELECT (:'r1_reply'::jsonb ->> 'messageId')::bigint AS r1_reply_id \gset
-- The whole file runs inside one outer transaction, so now() is frozen at
-- transaction start (gal_changes.pg's documented gotcha) — force thread 1's
-- reply to read as OLDER so the later ordering assertion has a real signal
-- to sort on, not a tie (drive_space_as_of.pg's UPDATE...created_at precedent).
UPDATE chat_messages SET created_at = now() - interval '1 hour' WHERE id = :r1_reply_id;

-- ── author of the root sees the thread ────────────────────────────────────
SELECT ok((SELECT jsonb_path_exists(chat_my_threads(901, 50),
             format('$[*] ? (@.messageId == %s)', :r1_id)::jsonpath)),
  'the root author (901) sees the thread in My-Threads');

-- ── the replier sees the thread too ────────────────────────────────────────
SELECT ok((SELECT jsonb_path_exists(chat_my_threads(902, 50),
             format('$[*] ? (@.messageId == %s)', :r1_id)::jsonpath)),
  'the replier (902) sees the thread in My-Threads');

-- ── an uninvolved member (never authored/replied/mentioned) sees nothing ──
SELECT is(jsonb_array_length(chat_my_threads(904, 50)), 0,
  'an uninvolved member (904) sees no threads');

-- ── a root with zero replies is not yet a "thread" ────────────────────────
SELECT chat_message_send(901, :chan, 'lonely root, no replies') AS lonely \gset
SELECT (:'lonely'::jsonb ->> 'messageId')::bigint AS lonely_id \gset
SELECT ok(NOT (SELECT jsonb_path_exists(chat_my_threads(901, 50),
             format('$[*] ? (@.messageId == %s)', :lonely_id)::jsonpath)),
  'a root with zero replies does not appear as a thread');

-- ── Thread 2: 902 authors the root, 901 replies mentioning 903 ────────────
SELECT chat_message_send(902, :chan, 'root topic two') AS r2 \gset
SELECT (:'r2'::jsonb ->> 'messageId')::bigint AS r2_id \gset
SELECT chat_message_send(901, :chan, 'reply mentioning 903', :r2_id, ARRAY[903]::bigint[]) AS r2_reply \gset

SELECT ok((SELECT jsonb_path_exists(chat_my_threads(903, 50),
             format('$[*] ? (@.messageId == %s)', :r2_id)::jsonpath)),
  'a user mentioned only in a reply (903) sees the thread via mention');

-- ── my-channels-only: removing a qualifying member from the channel hides
-- the thread on the NEXT query — membership is scoped at QUERY time, not
-- frozen at reply time ─────────────────────────────────────────────────────
SELECT chat_member_remove(901, :chan, 902);
SELECT is(jsonb_array_length(chat_my_threads(902, 50)), 0,
  'a removed member no longer sees the thread (membership scoped at query time)');

-- ── ordering: a thread with a MORE RECENT reply sorts first ───────────────
SELECT chat_my_threads(901, 50) AS ordered \gset
SELECT ok((:'ordered'::jsonb -> 0 ->> 'messageId')::bigint = :r2_id,
  'threads are ordered by lastReplyAt DESC (thread 2''s reply is the most recent)');

-- ── unread counts: 903 has never read the channel (last_read_seq=0) — the
-- thread 2 root + its one reply are both unread ───────────────────────────
SELECT ok((SELECT (jsonb_path_query_first(chat_my_threads(903, 50),
             format('$[*] ? (@.messageId == %s)', :r2_id)::jsonpath) ->> 'unreadCount')::int = 2),
  'unreadCount counts root+reply when nothing has been read yet');

-- Mark read up to (but not past) the reply's seq's predecessor: only the
-- reply itself remains unread.
SELECT chat_mark_read(903, :chan, (SELECT seq FROM chat_messages WHERE id = :r2_id));
SELECT ok((SELECT (jsonb_path_query_first(chat_my_threads(903, 50),
             format('$[*] ? (@.messageId == %s)', :r2_id)::jsonpath) ->> 'unreadCount')::int = 1),
  'unreadCount drops to 1 once the root (but not the reply) is marked read');

SELECT * FROM finish();
ROLLBACK;
