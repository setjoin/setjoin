-- ── 7) V112 shared task lists, assignee scope, & send_as delegate aliases ───
-- Carol (u_c, mb_c) is a member of Alice's shared list, assignee of tsk_assigned,
-- and send_as delegate on mb_a.
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18b WHERE k = 'u_c'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18b WHERE k = 'mb_c'), true);

SELECT is((SELECT count(*)::int FROM tasks WHERE id = (SELECT v FROM _w18b WHERE k = 'tsk_shared')), 1, 'V112 shared list: member Carol sees shared task');
SELECT is((SELECT count(*)::int FROM tasks WHERE id = (SELECT v FROM _w18b WHERE k = 'tsk_assigned')), 1, 'task assignee: Carol sees personal task assigned to her');
SELECT is((SELECT count(*)::int FROM tasks WHERE id = (SELECT v FROM _w18b WHERE k = 'tsk_a')), 0, 'task isolation: Carol cannot see Alice private unassigned task');
SELECT is((SELECT count(*)::int FROM task_activity WHERE id = (SELECT v FROM _w18b WHERE k = 'ta_shared')), 1, 'V112 shared list: member Carol sees shared task_activity');
SELECT is((SELECT count(*)::int FROM task_activity WHERE id = (SELECT v FROM _w18b WHERE k = 'ta_a')), 0, 'task_activity isolation: Carol cannot see Alice private task_activity');

-- Assignee cannot DELETE or directly UPDATE arbitrary columns on someone else's personal task.
WITH d AS (DELETE FROM tasks WHERE id = (SELECT v FROM _w18b WHERE k = 'tsk_assigned') RETURNING id)
SELECT is((SELECT count(*)::int FROM d), 0, 'task assignee: Carol cannot DELETE Alice personal assigned task');

WITH u AS (UPDATE tasks SET title = 'Hijacked Title' WHERE id = (SELECT v FROM _w18b WHERE k = 'tsk_assigned') RETURNING id)
SELECT is((SELECT count(*)::int FROM u), 0, 'task assignee: Carol cannot directly UPDATE Alice personal assigned task');

-- Assignee CAN update status via hardened SECURITY DEFINER task_assignee_set_status (own user GUC).
SELECT lives_ok(
  $$SELECT task_assignee_set_status((SELECT v FROM _w18b WHERE k = 'u_c'), (SELECT v FROM _w18b WHERE k = 'tsk_assigned'), 'in-progress')$$,
  'task assignee: Carol updates status via hardened task_assignee_set_status under setjoin_app'
);
SELECT throws_ok(
  $$SELECT task_assignee_set_status((SELECT v FROM _w18b WHERE k = 'u_a'), (SELECT v FROM _w18b WHERE k = 'tsk_assigned'), 'completed')$$,
  '42501', NULL,
  'DEFINER GUC bind: task_assignee_set_status rejects forged p_user_id under setjoin_app'
);

-- Shared task_activity INSERT enforces author_user_id = app.current_user_id (no author spoofing).
SELECT throws_ok(
  $$INSERT INTO task_activity (task_id, mailbox_id, author_user_id, kind, body)
    VALUES ((SELECT v FROM _w18b WHERE k = 'tsk_shared'), (SELECT v FROM _w18b WHERE k = 'mb_a'), (SELECT v FROM _w18b WHERE k = 'u_a'), 'comment', 'spoofed')$$,
  '42501', NULL,
  'task_activity INSERT: Carol cannot spoof author_user_id on shared task'
);

-- send_as delegate Carol sees Alice's alias (SELECT), cannot UPDATE/DELETE it.
SELECT is((SELECT count(*)::int FROM aliases WHERE id = (SELECT v FROM _w18b WHERE k = 'al_a')), 1, 'send_as delegate: Carol sees Alice alias');
WITH u AS (UPDATE aliases SET display_name = 'Hijacked' WHERE id = (SELECT v FROM _w18b WHERE k = 'al_a') RETURNING id)
SELECT is((SELECT count(*)::int FROM u), 0, 'send_as delegate: Carol cannot UPDATE Alice alias');

-- Stranger Bob sees 0 of Alice's shared tasks, task_activity, or aliases.
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18b WHERE k = 'u_b'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18b WHERE k = 'mb_b'), true);
SELECT is((SELECT count(*)::int FROM tasks WHERE id IN (SELECT v FROM _w18b WHERE k IN ('tsk_shared','tsk_assigned'))), 0, 'V112 stranger: Bob sees 0 of Alice shared/assigned tasks');
SELECT is((SELECT count(*)::int FROM task_activity WHERE id = (SELECT v FROM _w18b WHERE k = 'ta_shared')), 0, 'V112 stranger: Bob sees 0 of Alice shared task_activity');

-- ── 8) chat_schedule_* SECURITY DEFINER GUC binding ─────────────────────────
-- Bob forging Alice's p_user_id fails closed with 42501!
SELECT throws_ok(
  $$SELECT chat_schedule_message((SELECT v FROM _w18b WHERE k = 'u_a'), (SELECT v FROM _w18b WHERE k = 'ch_a'), 'forged', NULL, '{}'::bigint[], NULL, now() + interval '1 hour')$$,
  '42501', NULL,
  'DEFINER GUC bind: chat_schedule_message rejects forged p_user_id under setjoin_app'
);
SELECT throws_ok(
  $$SELECT chat_scheduled_list((SELECT v FROM _w18b WHERE k = 'u_a'))$$,
  '42501', NULL,
  'DEFINER GUC bind: chat_scheduled_list rejects forged p_user_id under setjoin_app'
);
SELECT throws_ok(
  $$SELECT chat_scheduled_cancel((SELECT v FROM _w18b WHERE k = 'u_a'), gen_random_uuid())$$,
  '42501', NULL,
  'DEFINER GUC bind: chat_scheduled_cancel rejects forged p_user_id under setjoin_app'
);

-- Alice calling chat_schedule_message / list / cancel with own user GUC succeeds under setjoin_app!
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18b WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', '', true);
SELECT lives_ok(
  $$
  DO $inner$
  DECLARE v_id uuid;
  BEGIN
    v_id := chat_schedule_message(
      (SELECT v FROM _w18b WHERE k = 'u_a'),
      (SELECT v FROM _w18b WHERE k = 'ch_a'),
      'hello scheduled',
      NULL, '{}'::bigint[], NULL, now() + interval '1 hour'
    );
    IF jsonb_array_length(chat_scheduled_list((SELECT v FROM _w18b WHERE k = 'u_a'))) <> 1 THEN
      RAISE EXCEPTION 'expected 1 scheduled chat message';
    END IF;
    PERFORM chat_scheduled_cancel((SELECT v FROM _w18b WHERE k = 'u_a'), v_id);
  END $inner$;
  $$,
  'ALLOW chat_schedule_*: Alice schedules, lists, and cancels chat_send under setjoin_app'
);

-- ── 9) Positive same-tenant INSERT/UPDATE/DELETE ALLOW-flow proofs (all 17) ─
-- Each table runs distinct INSERT -> UPDATE -> DELETE statements (separate command
-- snapshots) under SET LOCAL ROLE setjoin_app as Alice (u_a, mb_a).
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18b WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18b WHERE k = 'mb_a'), true);

-- 1. tags ALLOW
SELECT lives_ok($$
  DO $p$
  DECLARE v_id bigint; v_cnt int;
  BEGIN
    INSERT INTO tags (mailbox_id, name, tag_type)
    VALUES ((SELECT v FROM _w18b WHERE k = 'mb_a'), 'W18B-AllowTag', 'user') RETURNING id INTO v_id;
    UPDATE tags SET name = 'W18B-AllowTag-v2' WHERE id = v_id;
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'tags UPDATE affected % rows', v_cnt; END IF;
    DELETE FROM tags WHERE id = v_id;
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'tags DELETE affected % rows', v_cnt; END IF;
  END $p$;
$$, 'ALLOW tags: setjoin_app INSERT/UPDATE/DELETE own tag succeeds');

