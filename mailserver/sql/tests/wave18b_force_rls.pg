-- pgTAP: wave18b_force_rls.pg
-- Wave 1.8 Phase 546c (`V287__wave18b_mail_child_force_rls.sql`) proof:
--   1. All 17 Wave B mail/mailbox child tables have BOTH relrowsecurity AND relforcerowsecurity.
--   2. All 4 new ARCH-018 pure-boolean helpers + 3 chat_schedule_* DEFINER reducers are
--      SECURITY DEFINER owned by setjoin_worker.
--   3. Divergent user_id != mailbox_id fixtures (`mk_account`) under SET LOCAL ROLE setjoin_app:
--      - Unset GUCs fail closed (0 rows visible on SELECT across all 17 tables).
--      - Nullable scope rows (rules.mailbox_id IS NULL transport rule,
--        scheduled_actions.mailbox_id IS NULL org/compliance job,
--        message_recalls.recalled_by IS NULL) fail closed under setjoin_app.
--      - Divergent ID trap: setting app.current_mailbox_id = user_id sees 0 rows on
--        mailbox-scoped tables.
--      - Tenant A sees ONLY Tenant A rows and CANNOT SELECT, INSERT, UPDATE, or DELETE
--        Tenant B rows across all 17 tables.
--      - V112 shared task_lists & personal assignee_user_id work cleanly for tasks and
--        task_activity under setjoin_app without breaking stranger isolation.
--      - send_as delegate reads Alice's aliases (SELECT) but cannot mutate them.
--      - chat_schedule_* GUC binding rejects forged p_user_id (42501) and allows own user.
--      - Positive same-tenant INSERT/UPDATE/DELETE ALLOW-flow proofs for all 17 tables.

BEGIN;
SELECT plan(105);

-- ── 1) Structural check: all 17 tables have ENABLE + FORCE RLS ──────────────
SELECT is(
  (SELECT count(*)::int
     FROM pg_class c
     JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname = 'public'
    WHERE c.relname IN (
      'tags','tasks','task_activity','quick_steps','mailbox_audit_log',
      'message_attachments','message_recalls','read_receipts','vote_responses',
      'quarantined_messages','user_sender_list','user_spam_model','aliases',
      'folders','scheduled_actions','rules','migration_jobs'
    )
      AND c.relrowsecurity = true
      AND c.relforcerowsecurity = true),
  17,
  'V287: all 17 Wave B tables have ENABLE + FORCE ROW LEVEL SECURITY'
);

-- Verify ARCH-018 helpers + hardened chat_schedule_* reducers are SECURITY DEFINER owned by setjoin_worker.
SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
     JOIN pg_authid r ON r.oid = p.proowner
    WHERE p.proname IN (
      'rls_task_list_member',
      'rls_task_in_scope',
      'rls_message_in_scope',
      'rls_mailbox_delegate_for_current_user',
      'chat_schedule_message',
      'chat_scheduled_list',
      'chat_scheduled_cancel'
    )
      AND p.prosecdef = true
      AND r.rolname = 'setjoin_worker'),
  7,
  'V287: all 4 ARCH-018 helpers and 3 chat_schedule_* reducers are SECURITY DEFINER owned by setjoin_worker'
);

-- ── 2) Seed two divergent-ID tenants (A & B) plus collaborator/delegate (C) as superuser ──
CREATE TEMP TABLE _w18b (
  k text PRIMARY KEY,
  v bigint NOT NULL
);
CREATE TEMP TABLE _w18b_uuid (
  k text PRIMARY KEY,
  v uuid NOT NULL
);

DO $$
DECLARE
  v_mb_a bigint := mk_account('w18b-alice');
  v_mb_b bigint := mk_account('w18b-bob');
  v_mb_c bigint := mk_account('w18b-carol');
  v_u_a  bigint; v_u_b  bigint; v_u_c  bigint;
  v_d_a  bigint; v_d_b  bigint;
  v_tag_a bigint; v_tag_b bigint;
  v_fld_a bigint; v_fld_b bigint;
  v_al_a  bigint; v_al_b  bigint;
  v_tl_a  bigint;
  v_tsk_a bigint; v_tsk_b bigint; v_tsk_shared bigint; v_tsk_assigned bigint;
  v_ta_a  bigint; v_ta_b  bigint; v_ta_shared  bigint;
  v_qs_a  bigint; v_qs_b  bigint;
  v_rl_a  bigint; v_rl_b  bigint; v_rl_null bigint;
  v_sa_a  uuid;   v_sa_b  uuid;   v_sa_null uuid;
  v_mj_a  bigint; v_mj_b  bigint;
  v_msg_a bigint; v_msg_b bigint;
  v_rcv   timestamptz := date_trunc('second', now());
  v_att_a bigint; v_att_b bigint;
  v_rr_a  bigint; v_rr_b  bigint;
  v_vr_a  bigint; v_vr_b  bigint;
  v_qm_a  bigint; v_qm_b  bigint;
  v_mal_a bigint; v_mal_b bigint;
  v_ch_a  bigint;
BEGIN
  SELECT user_id, domain_id INTO v_u_a, v_d_a FROM mailboxes WHERE id = v_mb_a;
  SELECT user_id, domain_id INTO v_u_b, v_d_b FROM mailboxes WHERE id = v_mb_b;
  SELECT user_id INTO v_u_c FROM mailboxes WHERE id = v_mb_c;

  IF v_u_a = v_mb_a OR v_u_b = v_mb_b OR v_u_c = v_mb_c THEN
    RAISE EXCEPTION 'expected divergent user_id != mailbox_id';
  END IF;

  -- Delegate Carol as send_as on Alice's mailbox
  INSERT INTO mailbox_delegates (mailbox_id, user_id, permission, granted_by)
  VALUES (v_mb_a, v_u_c, 'send_as', v_u_a) ON CONFLICT DO NOTHING;

  -- 1. tags
  INSERT INTO tags (mailbox_id, name, tag_type) VALUES (v_mb_a, 'W18B-TagA', 'user') RETURNING id INTO v_tag_a;
  INSERT INTO tags (mailbox_id, name, tag_type) VALUES (v_mb_b, 'W18B-TagB', 'user') RETURNING id INTO v_tag_b;

  -- 2. folders
  INSERT INTO folders (mailbox_id, name, path) VALUES (v_mb_a, 'W18B-FldA', 'W18B-FldA') RETURNING id INTO v_fld_a;
  INSERT INTO folders (mailbox_id, name, path) VALUES (v_mb_b, 'W18B-FldB', 'W18B-FldB') RETURNING id INTO v_fld_b;

  -- 3. aliases
  INSERT INTO aliases (mailbox_id, email, domain_id) VALUES (v_mb_a, 'w18b-al-a@mk.test', v_d_a) RETURNING id INTO v_al_a;
  INSERT INTO aliases (mailbox_id, email, domain_id) VALUES (v_mb_b, 'w18b-al-b@mk.test', v_d_b) RETURNING id INTO v_al_b;

  -- V112 shared task list owned by Alice with member Carol
  INSERT INTO task_lists (owner_user_id, name) VALUES (v_u_a, 'W18B Shared List') RETURNING id INTO v_tl_a;
  INSERT INTO task_list_members (list_id, user_id, role, added_by_user_id) VALUES
    (v_tl_a, v_u_a, 'owner', v_u_a),
    (v_tl_a, v_u_c, 'member', v_u_a);

  -- 4. tasks (personal A, personal B, shared list A+C, personal A assigned to C)
  INSERT INTO tasks (mailbox_id, title) VALUES (v_mb_a, 'Alice Personal Task') RETURNING id INTO v_tsk_a;
  INSERT INTO tasks (mailbox_id, title) VALUES (v_mb_b, 'Bob Personal Task') RETURNING id INTO v_tsk_b;
  INSERT INTO tasks (mailbox_id, list_id, title) VALUES (v_mb_a, v_tl_a, 'Shared List Task') RETURNING id INTO v_tsk_shared;
  INSERT INTO tasks (mailbox_id, assignee_user_id, title) VALUES (v_mb_a, v_u_c, 'Assigned Personal Task') RETURNING id INTO v_tsk_assigned;

  -- 5. task_activity
  INSERT INTO task_activity (task_id, mailbox_id, author_user_id, kind, body)
  VALUES (v_tsk_a, v_mb_a, v_u_a, 'comment', 'Alice activity') RETURNING id INTO v_ta_a;
  INSERT INTO task_activity (task_id, mailbox_id, author_user_id, kind, body)
  VALUES (v_tsk_b, v_mb_b, v_u_b, 'comment', 'Bob activity') RETURNING id INTO v_ta_b;
  INSERT INTO task_activity (task_id, mailbox_id, author_user_id, kind, body)
  VALUES (v_tsk_shared, v_mb_a, v_u_a, 'comment', 'Shared activity') RETURNING id INTO v_ta_shared;

  -- 6. quick_steps
  INSERT INTO quick_steps (mailbox_id, name) VALUES (v_mb_a, 'Alice QS') RETURNING id INTO v_qs_a;
  INSERT INTO quick_steps (mailbox_id, name) VALUES (v_mb_b, 'Bob QS') RETURNING id INTO v_qs_b;

  -- 7. rules (personal A, personal B, org transport rule with mailbox_id IS NULL)
  INSERT INTO rules (mailbox_id, name, is_transport_rule) VALUES (v_mb_a, 'Alice Rule', false) RETURNING id INTO v_rl_a;
  INSERT INTO rules (mailbox_id, name, is_transport_rule) VALUES (v_mb_b, 'Bob Rule', false) RETURNING id INTO v_rl_b;
  INSERT INTO rules (mailbox_id, name, is_transport_rule) VALUES (NULL, 'Org Transport Rule', true) RETURNING id INTO v_rl_null;

  -- 8. scheduled_actions (mailbox A, mailbox B, org/compliance NULL mailbox_id)
  INSERT INTO scheduled_actions (action_kind, fire_at, mailbox_id)
  VALUES ('snooze', now() + interval '1 hour', v_mb_a) RETURNING id INTO v_sa_a;
  INSERT INTO scheduled_actions (action_kind, fire_at, mailbox_id)
  VALUES ('snooze', now() + interval '1 hour', v_mb_b) RETURNING id INTO v_sa_b;
  INSERT INTO scheduled_actions (action_kind, fire_at, mailbox_id)
  VALUES ('dsn', now() + interval '1 hour', NULL) RETURNING id INTO v_sa_null;

  -- 9. migration_jobs
  INSERT INTO migration_jobs (user_id, source_type, target_mailbox_id)
  VALUES (v_u_a, 'imap', v_mb_a) RETURNING id INTO v_mj_a;
  INSERT INTO migration_jobs (user_id, source_type, target_mailbox_id)
  VALUES (v_u_b, 'imap', v_mb_b) RETURNING id INTO v_mj_b;

  -- Parent messages + blob for message_attachments / read_receipts / vote_responses / quarantined_messages
  INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, ref_count)
  VALUES (repeat('d', 64), 'blobs/d', 32, 'text/plain', 0) ON CONFLICT DO NOTHING;
  INSERT INTO messages (mailbox_id, folder_id, message_id, subject, from_addr, to_addrs, size_bytes, thread_id, raw_ref, received_at)
  VALUES (v_mb_a, v_fld_a, '<w18b-msg-a@mk.test>', 'Alice Msg', 'a@mk.test', '[]'::jsonb, 10, 'thr-w18b-a', 'raw/w18b-a', v_rcv)
  RETURNING id INTO v_msg_a;
  INSERT INTO messages (mailbox_id, folder_id, message_id, subject, from_addr, to_addrs, size_bytes, thread_id, raw_ref, received_at)
  VALUES (v_mb_b, v_fld_b, '<w18b-msg-b@mk.test>', 'Bob Msg', 'b@mk.test', '[]'::jsonb, 10, 'thr-w18b-b', 'raw/w18b-b', v_rcv)
  RETURNING id INTO v_msg_b;

  -- 10. message_attachments
  INSERT INTO message_attachments (message_id, received_at, blob_sha256, filename, content_type, size_bytes)
  VALUES (v_msg_a, v_rcv, repeat('d', 64), 'a.txt', 'text/plain', 32) RETURNING id INTO v_att_a;
  INSERT INTO message_attachments (message_id, received_at, blob_sha256, filename, content_type, size_bytes)
  VALUES (v_msg_b, v_rcv, repeat('d', 64), 'b.txt', 'text/plain', 32) RETURNING id INTO v_att_b;

  -- 11. read_receipts (ensure Alice/Bob do not have read_receipt_policy='never')
  INSERT INTO read_receipts (message_id, received_at, recipient_email)
  VALUES (v_msg_a, v_rcv, 'rcpt-a@mk.test') RETURNING id INTO v_rr_a;
  INSERT INTO read_receipts (message_id, received_at, recipient_email)
  VALUES (v_msg_b, v_rcv, 'rcpt-b@mk.test') RETURNING id INTO v_rr_b;

  -- 12. vote_responses
  INSERT INTO vote_responses (message_id, received_at, voter_email, vote_option)
  VALUES (v_msg_a, v_rcv, 'voter-a@mk.test', 'Yes') RETURNING id INTO v_vr_a;
  INSERT INTO vote_responses (message_id, received_at, voter_email, vote_option)
  VALUES (v_msg_b, v_rcv, 'voter-b@mk.test', 'No') RETURNING id INTO v_vr_b;

  -- 13. quarantined_messages
  INSERT INTO quarantined_messages (message_id, mailbox_id, original_tag, reason)
  VALUES (v_msg_a, v_mb_a, 'Inbox', 'Test A') RETURNING id INTO v_qm_a;
  INSERT INTO quarantined_messages (message_id, mailbox_id, original_tag, reason)
  VALUES (v_msg_b, v_mb_b, 'Inbox', 'Test B') RETURNING id INTO v_qm_b;

  -- 14. message_recalls (user_scoped on recalled_by + NULL recalled_by row)
  INSERT INTO message_recalls (message_id, recalled_by) VALUES ('<w18b-rec-a@mk.test>', v_u_a);
  INSERT INTO message_recalls (message_id, recalled_by) VALUES ('<w18b-rec-b@mk.test>', v_u_b);
  INSERT INTO message_recalls (message_id, recalled_by) VALUES ('<w18b-rec-null@mk.test>', NULL);

  -- 15. mailbox_audit_log
  INSERT INTO mailbox_audit_log (occurred_at, mailbox_id, actor_user_id, action)
  VALUES (v_rcv, v_mb_a, v_u_a, 'w18b_test_a') RETURNING id INTO v_mal_a;
  INSERT INTO mailbox_audit_log (occurred_at, mailbox_id, actor_user_id, action)
  VALUES (v_rcv, v_mb_b, v_u_b, 'w18b_test_b') RETURNING id INTO v_mal_b;

  -- 16. user_sender_list
  INSERT INTO user_sender_list (user_id, sender, list_type) VALUES (v_u_a, 'safe-a@ext.test', 'safe');
  INSERT INTO user_sender_list (user_id, sender, list_type) VALUES (v_u_b, 'safe-b@ext.test', 'safe');

  -- 17. user_spam_model
  INSERT INTO user_spam_model (user_id, model_bytes) VALUES (v_u_a, '\x0102'::bytea);
  INSERT INTO user_spam_model (user_id, model_bytes) VALUES (v_u_b, '\x0304'::bytea);

  -- Chat channel for Alice (testing chat_schedule_* SECURITY DEFINER GUC binding)
  INSERT INTO chat_channels (kind, name, visibility, created_by)
  VALUES ('channel', 'w18b-sched', 'private', v_u_a) RETURNING id INTO v_ch_a;
  INSERT INTO chat_channel_members (channel_id, user_id, role)
  VALUES (v_ch_a, v_u_a, 'owner');

  INSERT INTO _w18b VALUES
    ('mb_a', v_mb_a), ('mb_b', v_mb_b), ('mb_c', v_mb_c),
    ('u_a', v_u_a), ('u_b', v_u_b), ('u_c', v_u_c),
    ('d_a', v_d_a), ('d_b', v_d_b),
    ('tag_a', v_tag_a), ('tag_b', v_tag_b),
    ('fld_a', v_fld_a), ('fld_b', v_fld_b),
    ('al_a', v_al_a), ('al_b', v_al_b),
    ('tl_a', v_tl_a),
    ('tsk_a', v_tsk_a), ('tsk_b', v_tsk_b), ('tsk_shared', v_tsk_shared), ('tsk_assigned', v_tsk_assigned),
    ('ta_a', v_ta_a), ('ta_b', v_ta_b), ('ta_shared', v_ta_shared),
    ('qs_a', v_qs_a), ('qs_b', v_qs_b),
    ('rl_a', v_rl_a), ('rl_b', v_rl_b), ('rl_null', v_rl_null),
    ('mj_a', v_mj_a), ('mj_b', v_mj_b),
    ('msg_a', v_msg_a), ('msg_b', v_msg_b),
    ('att_a', v_att_a), ('att_b', v_att_b),
    ('rr_a', v_rr_a), ('rr_b', v_rr_b),
    ('vr_a', v_vr_a), ('vr_b', v_vr_b),
    ('qm_a', v_qm_a), ('qm_b', v_qm_b),
    ('mal_a', v_mal_a), ('mal_b', v_mal_b),
    ('ch_a', v_ch_a);
  INSERT INTO _w18b_uuid VALUES
    ('sa_a', v_sa_a), ('sa_b', v_sa_b), ('sa_null', v_sa_null);
END $$;

GRANT SELECT ON _w18b, _w18b_uuid TO setjoin_app;

-- ── 3) Switch to setjoin_app (NOSUPERUSER NOBYPASSRLS) with UNSET GUCs ──────
SET LOCAL ROLE setjoin_app;
SELECT set_config('app.current_user_id', '', true);
SELECT set_config('app.current_mailbox_id', '', true);

SELECT is((SELECT count(*)::int FROM tags WHERE id IN (SELECT v FROM _w18b WHERE k IN ('tag_a','tag_b'))), 0, 'unset GUC: tags fail-closed');
SELECT is((SELECT count(*)::int FROM folders WHERE id IN (SELECT v FROM _w18b WHERE k IN ('fld_a','fld_b'))), 0, 'unset GUC: folders fail-closed');
SELECT is((SELECT count(*)::int FROM aliases WHERE id IN (SELECT v FROM _w18b WHERE k IN ('al_a','al_b'))), 0, 'unset GUC: aliases fail-closed');
SELECT is((SELECT count(*)::int FROM tasks WHERE id IN (SELECT v FROM _w18b WHERE k IN ('tsk_a','tsk_b'))), 0, 'unset GUC: tasks fail-closed');
SELECT is((SELECT count(*)::int FROM task_activity WHERE id IN (SELECT v FROM _w18b WHERE k IN ('ta_a','ta_b'))), 0, 'unset GUC: task_activity fail-closed');
SELECT is((SELECT count(*)::int FROM quick_steps WHERE id IN (SELECT v FROM _w18b WHERE k IN ('qs_a','qs_b'))), 0, 'unset GUC: quick_steps fail-closed');
SELECT is((SELECT count(*)::int FROM rules WHERE id IN (SELECT v FROM _w18b WHERE k IN ('rl_a','rl_b','rl_null'))), 0, 'unset GUC: rules fail-closed');
SELECT is((SELECT count(*)::int FROM scheduled_actions WHERE id IN (SELECT v FROM _w18b_uuid WHERE k IN ('sa_a','sa_b','sa_null'))), 0, 'unset GUC: scheduled_actions fail-closed');
SELECT is((SELECT count(*)::int FROM migration_jobs WHERE id IN (SELECT v FROM _w18b WHERE k IN ('mj_a','mj_b'))), 0, 'unset GUC: migration_jobs fail-closed');
SELECT is((SELECT count(*)::int FROM message_attachments WHERE id IN (SELECT v FROM _w18b WHERE k IN ('att_a','att_b'))), 0, 'unset GUC: message_attachments fail-closed');
SELECT is((SELECT count(*)::int FROM read_receipts WHERE id IN (SELECT v FROM _w18b WHERE k IN ('rr_a','rr_b'))), 0, 'unset GUC: read_receipts fail-closed');
SELECT is((SELECT count(*)::int FROM vote_responses WHERE id IN (SELECT v FROM _w18b WHERE k IN ('vr_a','vr_b'))), 0, 'unset GUC: vote_responses fail-closed');
SELECT is((SELECT count(*)::int FROM quarantined_messages WHERE id IN (SELECT v FROM _w18b WHERE k IN ('qm_a','qm_b'))), 0, 'unset GUC: quarantined_messages fail-closed');
SELECT is((SELECT count(*)::int FROM message_recalls WHERE message_id IN ('<w18b-rec-a@mk.test>','<w18b-rec-b@mk.test>','<w18b-rec-null@mk.test>')), 0, 'unset GUC: message_recalls fail-closed');
SELECT is((SELECT count(*)::int FROM mailbox_audit_log WHERE id IN (SELECT v FROM _w18b WHERE k IN ('mal_a','mal_b'))), 0, 'unset GUC: mailbox_audit_log fail-closed');
SELECT is((SELECT count(*)::int FROM user_sender_list WHERE user_id IN (SELECT v FROM _w18b WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: user_sender_list fail-closed');
SELECT is((SELECT count(*)::int FROM user_spam_model WHERE user_id IN (SELECT v FROM _w18b WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: user_spam_model fail-closed');

-- ── 4) Divergent-ID trap: setting mailbox GUC to user_id sees 0 mailbox rows ──
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18b WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18b WHERE k = 'u_a'), true);
SELECT is((SELECT count(*)::int FROM tags WHERE id = (SELECT v FROM _w18b WHERE k = 'tag_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 tags');
SELECT is((SELECT count(*)::int FROM quick_steps WHERE id = (SELECT v FROM _w18b WHERE k = 'qs_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 quick_steps');
SELECT is((SELECT count(*)::int FROM mailbox_audit_log WHERE id = (SELECT v FROM _w18b WHERE k = 'mal_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 mailbox_audit_log');

-- ── 5) Tenant A scope (MailboxTx: user_id=u_a, mailbox_id=mb_a) ─────────────
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18b WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18b WHERE k = 'mb_a'), true);

-- Tenant A sees ONLY Tenant A rows (never Tenant B, never NULL-scoped org rows) across all 17 tables.
SELECT is((SELECT count(*)::int FROM tags WHERE id IN (SELECT v FROM _w18b WHERE k IN ('tag_a','tag_b'))), 1, 'tenant A: sees only own tags');
SELECT is((SELECT count(*)::int FROM folders WHERE id IN (SELECT v FROM _w18b WHERE k IN ('fld_a','fld_b'))), 1, 'tenant A: sees only own folders');
SELECT is((SELECT count(*)::int FROM aliases WHERE id IN (SELECT v FROM _w18b WHERE k IN ('al_a','al_b'))), 1, 'tenant A: sees only own aliases');
SELECT is((SELECT count(*)::int FROM tasks WHERE id IN (SELECT v FROM _w18b WHERE k IN ('tsk_a','tsk_b'))), 1, 'tenant A: sees only own tasks');
SELECT is((SELECT count(*)::int FROM task_activity WHERE id IN (SELECT v FROM _w18b WHERE k IN ('ta_a','ta_b'))), 1, 'tenant A: sees only own task_activity');
SELECT is((SELECT count(*)::int FROM quick_steps WHERE id IN (SELECT v FROM _w18b WHERE k IN ('qs_a','qs_b'))), 1, 'tenant A: sees only own quick_steps');
SELECT is((SELECT count(*)::int FROM rules WHERE id IN (SELECT v FROM _w18b WHERE k IN ('rl_a','rl_b','rl_null'))), 1, 'tenant A: sees only own rules (NULL transport rule hidden)');
SELECT is((SELECT count(*)::int FROM scheduled_actions WHERE id IN (SELECT v FROM _w18b_uuid WHERE k IN ('sa_a','sa_b','sa_null'))), 1, 'tenant A: sees only own scheduled_actions (NULL org job hidden)');
SELECT is((SELECT count(*)::int FROM migration_jobs WHERE id IN (SELECT v FROM _w18b WHERE k IN ('mj_a','mj_b'))), 1, 'tenant A: sees only own migration_jobs');
SELECT is((SELECT count(*)::int FROM message_attachments WHERE id IN (SELECT v FROM _w18b WHERE k IN ('att_a','att_b'))), 1, 'tenant A: sees only own message_attachments');
SELECT is((SELECT count(*)::int FROM read_receipts WHERE id IN (SELECT v FROM _w18b WHERE k IN ('rr_a','rr_b'))), 1, 'tenant A: sees only own read_receipts');
SELECT is((SELECT count(*)::int FROM vote_responses WHERE id IN (SELECT v FROM _w18b WHERE k IN ('vr_a','vr_b'))), 1, 'tenant A: sees only own vote_responses');
SELECT is((SELECT count(*)::int FROM quarantined_messages WHERE id IN (SELECT v FROM _w18b WHERE k IN ('qm_a','qm_b'))), 1, 'tenant A: sees only own quarantined_messages');
SELECT is((SELECT count(*)::int FROM message_recalls WHERE message_id IN ('<w18b-rec-a@mk.test>','<w18b-rec-b@mk.test>','<w18b-rec-null@mk.test>')), 1, 'tenant A: sees only own message_recalls (NULL recalled_by hidden)');
SELECT is((SELECT count(*)::int FROM mailbox_audit_log WHERE id IN (SELECT v FROM _w18b WHERE k IN ('mal_a','mal_b'))), 1, 'tenant A: sees only own mailbox_audit_log');
SELECT is((SELECT count(*)::int FROM user_sender_list WHERE user_id IN (SELECT v FROM _w18b WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own user_sender_list');
SELECT is((SELECT count(*)::int FROM user_spam_model WHERE user_id IN (SELECT v FROM _w18b WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own user_spam_model');

-- ── 6) Cross-tenant INSERT / UPDATE / DELETE denials under Tenant A ─────────
SELECT throws_ok(
  $$INSERT INTO tags (mailbox_id, name, tag_type) VALUES ((SELECT v FROM _w18b WHERE k = 'mb_b'), 'Injected', 'user')$$,
  '42501', NULL,
  'cross-tenant INSERT into tags denied by FORCE RLS'
);
SELECT throws_ok(
  $$INSERT INTO folders (mailbox_id, name, path) VALUES ((SELECT v FROM _w18b WHERE k = 'mb_b'), 'Injected', 'Injected')$$,
  '42501', NULL,
  'cross-tenant INSERT into folders denied by FORCE RLS'
);
SELECT throws_ok(
