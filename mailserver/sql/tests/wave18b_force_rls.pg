     WHERE user_id = (SELECT v FROM _w18b WHERE k = 'u_a') AND sender = 'allow-sender@ext.test';
    GET DIAGNOSTICS v_cnt = ROW_COUNT;
    IF v_cnt <> 1 THEN RAISE EXCEPTION 'user_sender_list DELETE affected % rows', v_cnt; END IF;
  END $p$;
$$, 'ALLOW user_sender_list: setjoin_app INSERT/UPDATE/DELETE own sender succeeds');

-- 17. user_spam_model ALLOW
WITH upd AS (
  UPDATE user_spam_model SET sample_count = 7
   WHERE user_id = (SELECT v FROM _w18b WHERE k = 'u_a') RETURNING sample_count
)
SELECT is((SELECT sample_count::int FROM upd), 7, 'ALLOW user_spam_model: setjoin_app UPDATE own model succeeds');

-- ── 10) Tightened policy & hardened rust_* reducer security proofs ──────────
-- task_activity: setjoin_app cannot inject activity onto a foreign task_id even using own mailbox_id
SELECT throws_ok(
  $$INSERT INTO task_activity (task_id, mailbox_id, author_user_id, kind, body)
    VALUES ((SELECT v FROM _w18b WHERE k = 'tsk_b'), (SELECT v FROM _w18b WHERE k = 'mb_a'), (SELECT v FROM _w18b WHERE k = 'u_a'), 'comment', 'Cross-task spoof')$$,
  '42501', NULL,
  'task_activity: setjoin_app cannot INSERT onto foreign task_id using own mailbox_id'
);

-- scheduled_actions: setjoin_app cannot forge chat_send even with own mailbox_id
SELECT throws_ok(
  $$INSERT INTO scheduled_actions (action_kind, fire_at, payload, mailbox_id)
    VALUES ('chat_send', now() + interval '1 hour', '{}'::jsonb, (SELECT v FROM _w18b WHERE k = 'mb_a'))$$,
  '42501', NULL,
  'scheduled_actions: setjoin_app cannot forge action_kind=chat_send even with own mailbox_id'
);

-- mailbox_audit_log: direct leaf partition access is denied under setjoin_app
SELECT throws_ok(
  $$SELECT count(*) FROM public.mailbox_audit_log_default$$,
  '42501', NULL,
  'mailbox_audit_log leaf: direct SELECT on mailbox_audit_log_default denied for setjoin_app'
);
SELECT throws_ok(
  $$INSERT INTO public.mailbox_audit_log_default (occurred_at, mailbox_id, actor_user_id, action)
    VALUES (now(), (SELECT v FROM _w18b WHERE k = 'mb_b'), (SELECT v FROM _w18b WHERE k = 'u_a'), 'leaf_inj')$$,
  '42501', NULL,
  'mailbox_audit_log leaf: direct INSERT on mailbox_audit_log_default denied for setjoin_app'
);

-- Worker-only rust_* reducers cannot be called by setjoin_app (42501)
SELECT throws_ok(
  $$SELECT rust_system_config_upsert_batch(ARRAY['k1'], ARRAY['true'], 'forged')$$,
  '42501', NULL,
  'worker-only reducer: rust_system_config_upsert_batch denied for setjoin_app'
);
SELECT throws_ok(
  $$SELECT rust_system_config_upsert('k1', 'true', false)$$,
  '42501', NULL,
  'worker-only reducer: rust_system_config_upsert denied for setjoin_app'
);
SELECT throws_ok(
  $$SELECT rust_system_config_delete('k1')$$,
  '42501', NULL,
  'worker-only reducer: rust_system_config_delete denied for setjoin_app'
);
SELECT throws_ok(
  $$SELECT rust_outbound_queue_enqueue('<forged@mk.test>', 'a@mk.test', 'b@mk.test', 'raw/x')$$,
  '42501', NULL,
  'worker-only reducer: rust_outbound_queue_enqueue denied for setjoin_app'
);

-- User-scoped rust_* reducers reject foreign p_user_id under setjoin_app (42501)
SELECT throws_ok(
  $$SELECT rust_user_external_sender_warning_set((SELECT v FROM _w18b WHERE k = 'u_b'), true)$$,
  '42501', NULL,
  'GUC bind: rust_user_external_sender_warning_set rejects foreign p_user_id under setjoin_app'
);
SELECT throws_ok(
  $$SELECT rust_jmap_unsubscribe_record((SELECT v FROM _w18b WHERE k = 'u_b'), 1, 'forged@ext.test')$$,
  '42501', NULL,
  'GUC bind: rust_jmap_unsubscribe_record rejects foreign p_user_id under setjoin_app'
);

-- rust_blob_register_metadata: input validation (22023) & unset GUC rejection (42501)
SELECT throws_ok(
  $$SELECT rust_blob_register_metadata('not-a-sha256', 'blobs/x', 10, 'text/plain')$$,
  '22023', NULL,
  'input validation: rust_blob_register_metadata rejects malformed sha256'
);
SELECT set_config('app.current_user_id', '', true);
SELECT set_config('app.current_mailbox_id', '', true);
SELECT throws_ok(
  $$SELECT rust_blob_register_metadata('0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef', 'blobs/x', 10, 'text/plain')$$,
  '42501', NULL,
  'GUC bind: rust_blob_register_metadata fails closed when both scope GUCs are unset'
);

SELECT * FROM finish();
