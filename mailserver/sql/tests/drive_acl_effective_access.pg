-- V185/A2 canonical Drive effective-access truth table and RLS proof.
BEGIN;
SELECT plan(44);

SELECT is((SELECT count(*)::int FROM feature_toggles
            WHERE key IN ('feature.drive_node_acl_reads','feature.drive_node_acl_writes')
              AND NOT enabled), 2, 'both Drive ACL behavior toggles seed OFF');
SELECT is((
  SELECT count(*)::int
    FROM pg_proc p JOIN pg_roles r ON r.oid = p.proowner
   WHERE p.oid IN (
     'drive_effective_capability_sources(bigint,bigint,bigint)'::regprocedure,
     'drive_runtime_capability_sources(bigint,bigint,bigint)'::regprocedure,
     'drive_effective_capabilities(bigint,bigint)'::regprocedure,
     'drive_has_node_capability(bigint,bigint,text)'::regprocedure,
     'drive_runtime_has_node_capability(bigint,bigint,text)'::regprocedure,
     'drive_user_has_space_access(bigint,bigint)'::regprocedure,
     'drive_authorize_node(bigint,bigint,text[])'::regprocedure,
     'drive_access_explain(bigint,bigint)'::regprocedure,
     'drive_visible_nodes(bigint,bigint,bigint,integer)'::regprocedure,
     'drive_visible_children(bigint,bigint,bigint,bigint,integer)'::regprocedure
   ) AND r.rolname = 'setjoin_worker'
), 10, 'all A2 authority helpers are worker-owned');

SELECT mk_account('acl2mgr') AS mbm \gset
SELECT mk_account('acl2viewer') AS mbv \gset
SELECT mk_account('acl2direct') AS mbd \gset
SELECT mk_account('acl2outside') AS mbo \gset
SELECT mk_account('acl2disabled') AS mbx \gset
SELECT user_id AS um FROM mailboxes WHERE id=:mbm \gset
SELECT user_id AS uv FROM mailboxes WHERE id=:mbv \gset
SELECT user_id AS ud FROM mailboxes WHERE id=:mbd \gset
SELECT user_id AS uo FROM mailboxes WHERE id=:mbo \gset
SELECT user_id AS ux FROM mailboxes WHERE id=:mbx \gset

SELECT drive_space_create(:um, 'ACL Effective', 'regular') AS sid \gset
SELECT drive_member_grant(:um, :sid, :uv, 'viewer');
SELECT drive_node_create(:um, :sid, NULL, 'folder', 'A') AS a \gset
SELECT drive_node_create(:um, :sid, :a, 'folder', 'B') AS b \gset
SELECT drive_node_create(:um, :sid, :b, 'file', 'report.txt') AS f \gset
SELECT drive_node_create(:um, :sid, :a, 'file', 'sibling.txt') AS sibling \gset

SELECT is(drive_effective_capabilities(:uv, :f),
  ARRAY['traverse','list_children','read_metadata','preview','download']::text[],
  'viewer root source maps through the exact compatibility preset');
SELECT is(cardinality(drive_effective_capabilities(:um, :f)), 12,
  'manager root source receives the complete capability catalog');
SELECT is(drive_effective_capabilities(:ud, :f), ARRAY[]::text[],
  'outsider has no canonical capabilities before a grant');

UPDATE drive_spaces SET acl_mode='shadow' WHERE id=:sid;
INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by)
VALUES (:sid,:b,:ud,'editor',drive_acl_preset_capabilities('editor'),'subtree',:um);
SELECT ok(drive_has_node_capability(:ud, :f, 'modify_content'),
  'shadow evaluator resolves a live direct subtree grant');
SELECT is(drive_runtime_has_node_capability(:ud, :f, 'modify_content'), false,
  'shadow mode does not make direct ACL authority live');
SELECT is((SELECT count(*)::int FROM drive_visible_nodes(:ud,:sid,0,200)), 0,
  'shadow mode cannot leak a direct grant through a list projection');
SELECT is((drive_authorize_node(:ud,:f,ARRAY['preview'])->>'allowed')::boolean,
          false, 'shadow mode cannot leak a direct grant through exact authorize');

UPDATE drive_spaces SET acl_mode='acl' WHERE id=:sid;
SELECT ok(drive_runtime_has_node_capability(:ud, :f, 'modify_content'),
  'acl mode routes runtime exact checks through the canonical evaluator');
SELECT is((SELECT count(*)::int FROM drive_visible_nodes(:ud,:sid,0,200)), 3,
  'set-returning visibility contains the path ancestor, granted anchor, and subtree');
SELECT ok(drive_has_node_capability(:ud,:a,'traverse'),
  'descendant grant projects traverse onto its real path ancestor');
SELECT is(drive_has_node_capability(:ud,:a,'read_metadata'),false,
  'path ancestor receives no metadata or content capability');
SELECT is((SELECT count(*)::int FROM drive_visible_nodes(:ud,:sid,0,200)
            WHERE node_id=:sibling), 0, 'direct subtree grant does not disclose siblings');

INSERT INTO drive_acl_breaks(space_id,node_id,created_by,expected_epoch)
VALUES (:sid,:b,:um,0);
SELECT is(drive_effective_capabilities(:uv,:f), ARRAY[]::text[],
  'inheritance break stops a root role below the break');
SELECT ok(drive_has_node_capability(:ud,:f,'modify_content'),
  'grant anchored on the break still applies below it');
SELECT ok(drive_has_node_capability(:uv,:sibling,'read_metadata'),
  'inheritance break does not narrow a sibling subtree');

INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by)
VALUES (:sid,:a,:uo,'viewer',drive_acl_preset_capabilities('viewer'),'children',:um);
SELECT ok(drive_has_node_capability(:uo,:a,'read_metadata'),
  'children propagation includes its anchor');
SELECT ok(drive_has_node_capability(:uo,:sibling,'read_metadata'),
  'children propagation includes an unbroken direct child');
SELECT is(drive_has_node_capability(:uo,:f,'read_metadata'), false,
  'children propagation excludes grandchildren');

INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by,expires_at)
VALUES (:sid,:f,:ux,'viewer',drive_acl_preset_capabilities('viewer'),'self',:um,now()-interval '1 second');
SELECT is(drive_has_node_capability(:ux,:f,'read_metadata'), false,
  'expired grants fail closed');
INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by,max_uses,used_count)
VALUES (:sid,:f,:ux,'viewer',drive_acl_preset_capabilities('viewer'),'self',:um,1,1);
SELECT is(drive_has_node_capability(:ux,:f,'read_metadata'), false,
  'exhausted use-limited grants fail closed');
INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by,starts_at)
VALUES (:sid,:f,:ux,'viewer',drive_acl_preset_capabilities('viewer'),'self',:um,now()+interval '1 hour');
SELECT is(drive_has_node_capability(:ux,:f,'read_metadata'), false,
  'future grants fail closed');

UPDATE users SET enabled=false WHERE id=:ud;
SELECT is(drive_effective_capabilities(:ud,:f), ARRAY[]::text[],
  'disabled users have no effective capabilities');
UPDATE users SET enabled=true WHERE id=:ud;
SELECT ok(drive_has_node_capability(:ud,:f,'read_metadata'),
  're-enabled user resumes the still-live direct grant');

SELECT is((drive_authorize_node(:ud,:f,ARRAY['preview','download'])->>'allowed')::boolean,
          true, 'exact authorize accepts a held capability subset');
SELECT is(drive_authorize_node(:ud,:f,ARRAY['preview'])->>'nodeId', :f::text,
          'authorize serializes node ids as decimal strings');
SELECT throws_ok(format($sql$SELECT drive_authorize_node(%s,%s,ARRAY['unknown'])$sql$,:ud,:f),
  'BZ252', NULL, 'unknown exact-check capabilities fail closed');
SELECT ok(jsonb_array_length(drive_access_explain(:ud,:f)->'sources') > 0,
  'bounded self explanation reports redacted source facts');
SELECT is((SELECT count(*)::int FROM drive_visible_nodes(:ud,:sid,0,1)), 1,
  'visible-node page limit is enforced');

GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO setjoin_app;
SET LOCAL ROLE setjoin_app;
SELECT set_config('app.current_user_id', :ud::text, true);
SELECT is((SELECT count(*)::int FROM drive_nodes WHERE space_id=:sid), 3,
  'setjoin_app RLS exposes only the traversal path and direct granted subtree');
SELECT is((SELECT count(*)::int FROM drive_nodes WHERE id=:sibling), 0,
  'remembered hidden sibling id remains non-oracular under RLS');
SELECT ok((SELECT count(*) FROM drive_acl_generations WHERE space_id=:sid) = 1,
  'direct ACL principal may read its space generation');
SELECT set_config('app.current_user_id', :ux::text, true);
SELECT is((SELECT count(*)::int FROM drive_nodes WHERE space_id=:sid), 0,
  'ungranted principal sees no node rows under FORCE RLS');
RESET ROLE;
SELECT set_config('app.current_user_id', '', true);

-- Guest outer caps intersect a direct viewer grant.
UPDATE feature_toggles SET enabled=true
 WHERE key IN ('feature.drive','feature.guest_accounts');
SELECT mk_account('acl2guest') AS mbg \gset
SELECT user_id AS ug FROM mailboxes WHERE id=:mbg \gset
SELECT id AS host_domain FROM domains WHERE is_local ORDER BY id LIMIT 1 \gset
INSERT INTO guest_profiles(host_domain_id,name,allow_download,apps)
VALUES (:host_domain,'ACL A2 Guest',false,ARRAY['drive']) RETURNING id AS gpid \gset
INSERT INTO guest_accounts
  (user_id,invited_email,invited_by_email,host_domain_id,profile_id,status)
VALUES (:ug,'acl2guest@example.test','acl2mgr@example.test',:host_domain,:gpid,'active');
INSERT INTO user_app_entitlements(user_id,app,enabled)
VALUES (:ug,'drive',true)
ON CONFLICT (user_id,app) DO UPDATE SET enabled=EXCLUDED.enabled;
INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by)
VALUES (:sid,:b,:ug,'viewer',drive_acl_preset_capabilities('viewer'),'subtree',:um);
SELECT is(drive_has_node_capability(:ug,:f,'download'), false,
  'Guest download profile flag is a hard outer cap');
SELECT ok(drive_has_node_capability(:ug,:f,'preview'),
  'active entitled Guest retains protected preview');
UPDATE guest_profiles SET allow_download=true WHERE id=:gpid;
SELECT ok(drive_has_node_capability(:ug,:f,'download'),
  'Guest download becomes effective only when the outer flag allows it');
UPDATE guest_accounts SET status='expired' WHERE user_id=:ug;
SELECT is(drive_effective_capabilities(:ug,:f), ARRAY[]::text[],
  'expired Guest loses every Drive capability');
UPDATE guest_accounts SET status='active' WHERE user_id=:ug;
UPDATE users SET enabled=false WHERE id=:ug;
SELECT is(drive_effective_capabilities(:ug,:f), ARRAY[]::text[],
  'disabled Guest loses every Drive capability');

-- Bound content immutability and bound-space direct-grant rejection.
SELECT chat_channel_create(:um, 'acl-a2-bound') AS chan \gset
SELECT chat_channel_join(:ud, :chan);
SELECT chat_space_ensure(:um, :chan) AS chatspace \gset
SELECT drive_node_create(:um,:chatspace,NULL,'file','attachment.txt') AS chatnode \gset
SELECT drive_chunk_register(:um,:chatspace,repeat('e',64),10);
SELECT (drive_file_put_version(:um,:chatnode,repeat('e',64),10,NULL,NULL,
  ('[{"sha256":"'||repeat('e',64)||'","size":10}]')::jsonb,NULL,'acl-a2')
  ->>'versionId')::bigint AS chatver \gset
SELECT (chat_message_send(:um,:chan,'acl a2')->>'messageId')::bigint AS chatmsg \gset
INSERT INTO chat_message_attachments
  (channel_id,message_id,file_node_id,version_id,filename,size_bytes)
VALUES (:chan,:chatmsg,:chatnode,:chatver,'attachment.txt',10);
SELECT is(drive_member_role(:chatspace,:ud), 'editor',
  'chat member still derives its legacy editor root source');
SELECT is(drive_has_node_capability(:ud,:chatnode,'modify_content'), false,
  'bound attachment strips modify_content regardless of source');
SELECT is(drive_has_node_capability(:ud,:chatnode,'rename'), false,
  'bound attachment strips rename regardless of source');
SELECT ok(drive_has_node_capability(:ud,:chatnode,'download'),
  'bound attachment remains readable to its binding principal');
UPDATE drive_spaces SET acl_mode='acl' WHERE id=:chatspace;
INSERT INTO drive_acl_grants
  (space_id,node_id,subject_user_id,preset,capabilities,propagation,created_by)
VALUES (:chatspace,:chatnode,:uo,'viewer',drive_acl_preset_capabilities('viewer'),'self',:um);
SELECT is(drive_effective_capabilities(:uo,:chatnode), ARRAY[]::text[],
  'ad-hoc direct grants on a Chat-bound space are ignored');

SELECT * FROM finish();
ROLLBACK;
