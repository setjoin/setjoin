-- pgTAP test for must_change_password feature
-- Run with: pg_prove -d mailserver sql/tests/must_change_password.pg

BEGIN;
SELECT plan(5);

-- 1. Column exists on users table
SELECT col_type_is('public', 'users', 'must_change_password', 'boolean', 'must_change_password is a boolean');

-- 2. Column has NOT NULL constraint
SELECT col_not_null('public', 'users', 'must_change_password', 'must_change_password is NOT NULL');

-- 3. Default value is FALSE
SELECT col_has_default('public', 'users', 'must_change_password', 'must_change_password has a default');
SELECT col_default_is('public', 'users', 'must_change_password', 'false', 'must_change_password defaults to FALSE');

-- 4. Verify it can be set and cleared via UPDATE
DO $$
DECLARE
    v_domain_id BIGINT;
    v_user_id BIGINT;
    v_flag BOOLEAN;
BEGIN
    INSERT INTO domains (name) VALUES ('testmustchange.example') RETURNING id INTO v_domain_id;
    INSERT INTO users (username, email, display_name, password_hash, domain_id, must_change_password)
    VALUES ('testuser', 'testuser@testmustchange.example', 'Test User', '$2a$10$abcdefghijklmnopqrstuv', v_domain_id, TRUE)
    RETURNING id INTO v_user_id;

    SELECT must_change_password INTO v_flag FROM users WHERE id = v_user_id;
    IF v_flag IS NOT TRUE THEN
        RAISE EXCEPTION 'must_change_password should be TRUE after insert';
    END IF;

    UPDATE users SET must_change_password = FALSE WHERE id = v_user_id;
    SELECT must_change_password INTO v_flag FROM users WHERE id = v_user_id;
    IF v_flag IS NOT FALSE THEN
        RAISE EXCEPTION 'must_change_password should be FALSE after update';
    END IF;

    -- Cleanup
    DELETE FROM users WHERE id = v_user_id;
    DELETE FROM domains WHERE id = v_domain_id;
END;
$$;

SELECT pass('must_change_password can be set and cleared');

SELECT * FROM finish();
ROLLBACK;
