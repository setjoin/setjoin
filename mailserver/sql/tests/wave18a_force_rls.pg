  approval_active_delegate((SELECT v FROM _w18a WHERE k = 'u_a')),
  (SELECT v FROM _w18a WHERE k = 'u_c'),
  'OOO delegation: approval_active_delegate resolves Alice -> Carol for requester Bob under FORCE RLS'
);
SELECT is(
  approval_active_delegate((SELECT v FROM _w18a WHERE k = 'u_c')),
  (SELECT v FROM _w18a WHERE k = 'u_c'),
  'OOO delegation: user without active delegation resolves to self'
);

