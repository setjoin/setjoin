-- ── 10) Positive same-tenant INSERT/UPDATE/DELETE ALLOW-flow proofs (all 16) ─
-- Executed as Alice (u_a, mb_a) under SET LOCAL ROLE setjoin_app!
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18a WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18a WHERE k = 'mb_a'), true);

-- 1. calendars ALLOW
WITH ins AS (
  INSERT INTO calendars (mailbox_id, name, color, is_default)
  VALUES ((SELECT v FROM _w18a WHERE k = 'mb_a'), 'Alice Allow Cal', '#aaaaaa', false)
  RETURNING id
), upd AS (
  UPDATE calendars SET name = 'Alice Allow Cal v2' WHERE id IN (SELECT id FROM ins) RETURNING id
), del AS (
  DELETE FROM calendars WHERE id IN (SELECT id FROM upd) RETURNING id
)
SELECT is((SELECT count(*)::int FROM del), 1, 'ALLOW calendars: setjoin_app INSERT/UPDATE/DELETE own calendar succeeds');

