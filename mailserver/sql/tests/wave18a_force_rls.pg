-- pgTAP: wave18a_force_rls.pg
-- Wave 1.8 Phase 546b (`V286__wave18a_nonauth_force_rls.sql`) proof:
--   1. All 20 Wave A non-auth tables have BOTH relrowsecurity AND relforcerowsecurity.
--   2. Divergent user_id != mailbox_id fixtures (`mk_account`) under SET LOCAL ROLE setjoin_app:
--      - Unset GUCs fail closed (0 rows visible on SELECT across all 20 tables; INSERT denied).
--      - Tenant A sees ONLY Tenant A rows and CANNOT SELECT, INSERT, UPDATE, or DELETE Tenant B rows
--        across all 20 tables.
--      - Mailbox-scoped tables enforce strict mailbox_id isolation when app.current_mailbox_id is set
--        (passing user_id as mailbox_id sees 0 rows).
--      - Calendar ACL sharing works without calendars <-> calendar_acls mutual RLS recursion:
--        grantee sees shared calendar & events; read/freebusy grantee cannot mutate events;
--        write grantee can update shared events; calendar_effective_acl & calendar_free_busy work
--        under setjoin_app.
--      - OOO approval delegation (`approval_active_delegate`) resolves delegator -> delegate even
--        when called under setjoin_app as requester != delegator.

BEGIN;
SELECT plan(108);

-- ── 1) Structural check: all 20 tables have ENABLE + FORCE RLS ──────────────
SELECT is(
  (SELECT count(*)::int
     FROM pg_class c
     JOIN pg_namespace n ON n.oid = c.relnamespace AND n.nspname = 'public'
    WHERE c.relname IN (
      'addressbooks','calendar_acls','calendar_events','calendars',
      'contact_group_members','contact_groups','contacts','event_attendees',
      'reminders','vt_timezone','blob_user_charges','blob_user_usage',
      'approval_delegations','signatures','user_imap_settings',
      'user_notification_prefs','user_signatures','vacation_replies',
      'vacation_settings','email_templates'
    )
      AND c.relrowsecurity = true
      AND c.relforcerowsecurity = true),
  20,
  'V286: all 20 Wave A tables have ENABLE + FORCE ROW LEVEL SECURITY'
);

-- Verify ARCH-018 helpers exist, are SECURITY DEFINER, and owned by setjoin_worker.
SELECT is(
  (SELECT count(*)::int
     FROM pg_proc p
     JOIN pg_namespace n ON n.oid = p.pronamespace AND n.nspname = 'public'
     JOIN pg_authid r ON r.oid = p.proowner
    WHERE p.proname IN (
      'rls_caller_is_privileged',
      'rls_mailbox_in_scope',
      'rls_calendar_in_scope',
      'rls_calendar_acl_for_current_user',
      'rls_calendar_event_in_scope',
      'rls_calendar_event_acl_for_current_user',
      'rls_addressbook_in_scope',
      'rls_contact_group_in_scope',
      'approval_active_delegate'
    )
      AND p.prosecdef = true
      AND r.rolname = 'setjoin_worker'),
  9,
  'V286: all 9 ARCH-018 pure-boolean RLS & OOO helpers are SECURITY DEFINER owned by setjoin_worker'
);

-- ── 2) Seed two divergent-ID tenants (A & B) plus a requester (C) as superuser ──
CREATE TEMP TABLE _w18a (
  k text PRIMARY KEY,
  v bigint NOT NULL
);

DO $$
DECLARE
  v_mb_a bigint := mk_account('w18a-alice');
  v_mb_b bigint := mk_account('w18a-bob');
  v_mb_c bigint := mk_account('w18a-carol');
  v_u_a  bigint;
  v_u_b  bigint;
  v_u_c  bigint;
  v_cal_a bigint; v_cal_b bigint; v_cal_a_fb bigint;
  v_ev_a  bigint; v_ev_b  bigint; v_ev_a_fb bigint; v_ev_a_priv bigint;
  v_att_a bigint; v_att_b bigint; v_att_a_fb bigint; v_att_a_priv bigint;
  v_tz_a  bigint; v_tz_b  bigint;
  v_ab_a  bigint; v_ab_b  bigint;
  v_ct_a  bigint; v_ct_b  bigint;
  v_cg_a  bigint; v_cg_b  bigint;
  v_cgm_a bigint; v_cgm_b bigint;
  v_rem_a bigint; v_rem_b bigint;
  v_del_a bigint; v_del_b bigint;
  v_sig_a bigint; v_sig_b bigint;
  v_unp_a bigint; v_unp_b bigint;
  v_us_a  bigint; v_us_b  bigint;
  v_tpl_a bigint; v_tpl_b bigint;
BEGIN
  SELECT user_id INTO v_u_a FROM mailboxes WHERE id = v_mb_a;
  SELECT user_id INTO v_u_b FROM mailboxes WHERE id = v_mb_b;
  SELECT user_id INTO v_u_c FROM mailboxes WHERE id = v_mb_c;

  -- Confirm divergent user_id != mailbox_id invariant
  IF v_u_a = v_mb_a OR v_u_b = v_mb_b OR v_u_c = v_mb_c THEN
    RAISE EXCEPTION 'expected divergent user_id != mailbox_id';
  END IF;

  -- 1. calendars
  INSERT INTO calendars (mailbox_id, name, color, is_default)
  VALUES (v_mb_a, 'Alice Cal', '#111111', true) RETURNING id INTO v_cal_a;
  INSERT INTO calendars (mailbox_id, name, color, is_default)
  VALUES (v_mb_a, 'Alice FreeBusy Cal', '#333333', false) RETURNING id INTO v_cal_a_fb;
  INSERT INTO calendars (mailbox_id, name, color, is_default)
  VALUES (v_mb_b, 'Bob Cal', '#222222', true) RETURNING id INTO v_cal_b;

  -- 2. calendar_acls (C gets read on cal_a and cal_b, and freebusy-only on cal_a_fb)
  INSERT INTO calendar_acls (calendar_id, user_id, permission) VALUES (v_cal_a, v_u_c, 'read');
  INSERT INTO calendar_acls (calendar_id, user_id, permission) VALUES (v_cal_a_fb, v_u_c, 'freebusy');
  INSERT INTO calendar_acls (calendar_id, user_id, permission) VALUES (v_cal_b, v_u_c, 'read');

  -- 3. calendar_events (PUBLIC on cal_a/cal_b/cal_a_fb, plus PRIVATE on cal_a)
  INSERT INTO calendar_events (calendar_id, uid, title, start_at, end_at, classification)
  VALUES (v_cal_a, 'w18a-ev-a', 'Alice Public', now(), now() + interval '1 hour', 'PUBLIC') RETURNING id INTO v_ev_a;
  INSERT INTO calendar_events (calendar_id, uid, title, start_at, end_at, classification)
  VALUES (v_cal_a, 'w18a-ev-a-priv', 'Alice Private Secret', now(), now() + interval '1 hour', 'PRIVATE') RETURNING id INTO v_ev_a_priv;
  INSERT INTO calendar_events (calendar_id, uid, title, start_at, end_at, classification)
  VALUES (v_cal_a_fb, 'w18a-ev-a-fb', 'Alice FreeBusy Secret', now(), now() + interval '1 hour', 'PUBLIC') RETURNING id INTO v_ev_a_fb;
  INSERT INTO calendar_events (calendar_id, uid, title, start_at, end_at, classification)
  VALUES (v_cal_b, 'w18a-ev-b', 'Bob Secret', now(), now() + interval '1 hour', 'PUBLIC') RETURNING id INTO v_ev_b;

  -- 4. event_attendees
  INSERT INTO event_attendees (event_id, email, name)
  VALUES (v_ev_a, 'alice-guest@mk.test', 'Alice Guest') RETURNING id INTO v_att_a;
  INSERT INTO event_attendees (event_id, email, name)
  VALUES (v_ev_a_priv, 'alice-priv-guest@mk.test', 'Alice Priv Guest') RETURNING id INTO v_att_a_priv;
  INSERT INTO event_attendees (event_id, email, name)
  VALUES (v_ev_a_fb, 'alice-fb-guest@mk.test', 'Alice FB Guest') RETURNING id INTO v_att_a_fb;
  INSERT INTO event_attendees (event_id, email, name)
  VALUES (v_ev_b, 'bob-guest@mk.test', 'Bob Guest') RETURNING id INTO v_att_b;

  -- 5. vt_timezone
  INSERT INTO vt_timezone (calendar_id, tzid, standard)
  VALUES (v_cal_a, 'W18A/Alice', '{}'::jsonb) RETURNING id INTO v_tz_a;
  INSERT INTO vt_timezone (calendar_id, tzid, standard)
  VALUES (v_cal_b, 'W18A/Bob', '{}'::jsonb) RETURNING id INTO v_tz_b;

  -- 6. addressbooks
  INSERT INTO addressbooks (mailbox_id, name) VALUES (v_mb_a, 'Alice Book') RETURNING id INTO v_ab_a;
  INSERT INTO addressbooks (mailbox_id, name) VALUES (v_mb_b, 'Bob Book') RETURNING id INTO v_ab_b;

  -- 7. contacts
  INSERT INTO contacts (addressbook_id, vcard_uid, display_name)
  VALUES (v_ab_a, 'w18a-ct-a', 'Alice Contact') RETURNING id INTO v_ct_a;
  INSERT INTO contacts (addressbook_id, vcard_uid, display_name)
  VALUES (v_ab_b, 'w18a-ct-b', 'Bob Contact') RETURNING id INTO v_ct_b;

  -- 8. contact_groups
  INSERT INTO contact_groups (mailbox_id, name) VALUES (v_mb_a, 'Alice Grp') RETURNING id INTO v_cg_a;
  INSERT INTO contact_groups (mailbox_id, name) VALUES (v_mb_b, 'Bob Grp') RETURNING id INTO v_cg_b;

  -- 9. contact_group_members (cgm_one_target: contact_id XOR email)
  INSERT INTO contact_group_members (group_id, contact_id)
  VALUES (v_cg_a, v_ct_a) RETURNING id INTO v_cgm_a;
  INSERT INTO contact_group_members (group_id, contact_id)
  VALUES (v_cg_b, v_ct_b) RETURNING id INTO v_cgm_b;

  -- 10. reminders
  INSERT INTO reminders (mailbox_id, source_type, source_id, fire_at, title)
  VALUES (v_mb_a, 'event', v_ev_a, now(), 'Alice Rem') RETURNING id INTO v_rem_a;
  INSERT INTO reminders (mailbox_id, source_type, source_id, fire_at, title)
  VALUES (v_mb_b, 'event', v_ev_b, now(), 'Bob Rem') RETURNING id INTO v_rem_b;

  -- 11 & 12. blobs + blob_user_usage + blob_user_charges
  INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, ref_count)
  VALUES (repeat('a', 64), 'blobs/a', 100, 'text/plain', 0) ON CONFLICT DO NOTHING;
  INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, ref_count)
  VALUES (repeat('b', 64), 'blobs/b', 200, 'text/plain', 0) ON CONFLICT DO NOTHING;
  INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, ref_count)
  VALUES (repeat('c', 64), 'blobs/c', 64, 'text/plain', 0) ON CONFLICT DO NOTHING;
  INSERT INTO blob_user_usage (user_id, charged_bytes) VALUES (v_u_a, 0) ON CONFLICT DO NOTHING;
  INSERT INTO blob_user_usage (user_id, charged_bytes) VALUES (v_u_b, 0) ON CONFLICT DO NOTHING;
  INSERT INTO blob_user_charges (blob_sha256, user_id, size_bytes) VALUES (repeat('a', 64), v_u_a, 100);
  INSERT INTO blob_user_charges (blob_sha256, user_id, size_bytes) VALUES (repeat('b', 64), v_u_b, 200);

  -- 13. approval_delegations (A delegates to B? No, A delegates to C; B delegates to A? Keep A->C and B->C? Better: A delegates to C, B delegates to C is visible to C, so keep B delegating to B's own extra delegate D so A cannot see B's row!)
  DECLARE v_mb_d bigint := mk_account('w18a-dave'); v_u_d bigint;
  BEGIN
    SELECT user_id INTO v_u_d FROM mailboxes WHERE id = v_mb_d;
    INSERT INTO approval_delegations (delegator_user_id, delegate_user_id, starts_at, ends_at)
    VALUES (v_u_a, v_u_c, now() - interval '1 hour', now() + interval '1 day') RETURNING id INTO v_del_a;
    INSERT INTO approval_delegations (delegator_user_id, delegate_user_id, starts_at, ends_at)
    VALUES (v_u_b, v_u_d, now() - interval '1 hour', now() + interval '1 day') RETURNING id INTO v_del_b;
    INSERT INTO _w18a VALUES ('u_d', v_u_d);
  END;

  -- 14. signatures
  INSERT INTO signatures (mailbox_id, name, body_text) VALUES (v_mb_a, 'Alice Sig', 'A') RETURNING id INTO v_sig_a;
  INSERT INTO signatures (mailbox_id, name, body_text) VALUES (v_mb_b, 'Bob Sig', 'B') RETURNING id INTO v_sig_b;

  -- 15. user_imap_settings
  INSERT INTO user_imap_settings (user_id, expose_all) VALUES (v_u_a, true);
  INSERT INTO user_imap_settings (user_id, expose_all) VALUES (v_u_b, false);

  -- 16. user_notification_prefs
  INSERT INTO user_notification_prefs (user_id, push_enabled) VALUES (v_u_a, true) RETURNING id INTO v_unp_a;
  INSERT INTO user_notification_prefs (user_id, push_enabled) VALUES (v_u_b, false) RETURNING id INTO v_unp_b;

  -- 17. user_signatures
  INSERT INTO user_signatures (user_id, alias_email, signature_text)
  VALUES (v_u_a, 'a@mk.test', 'Sig A') RETURNING id INTO v_us_a;
  INSERT INTO user_signatures (user_id, alias_email, signature_text)
  VALUES (v_u_b, 'b@mk.test', 'Sig B') RETURNING id INTO v_us_b;

  -- 18. vacation_settings
  INSERT INTO vacation_settings (mailbox_id, enabled, subject, body_text)
  VALUES (v_mb_a, true, 'Alice OOO', 'Away');
  INSERT INTO vacation_settings (mailbox_id, enabled, subject, body_text)
  VALUES (v_mb_b, true, 'Bob OOO', 'Away');

  -- 19. vacation_replies
  INSERT INTO vacation_replies (sender_email, mailbox_id, vacation_start)
  VALUES ('sender@ext.test', v_mb_a, CURRENT_DATE);
  INSERT INTO vacation_replies (sender_email, mailbox_id, vacation_start)
  VALUES ('sender@ext.test', v_mb_b, CURRENT_DATE);

  -- 20. email_templates
  INSERT INTO email_templates (mailbox_id, name, subject, body_html)
  VALUES (v_mb_a, 'Alice Tpl', 'Hi', '<p>A</p>') RETURNING id INTO v_tpl_a;
  INSERT INTO email_templates (mailbox_id, name, subject, body_html)
  VALUES (v_mb_b, 'Bob Tpl', 'Hi', '<p>B</p>') RETURNING id INTO v_tpl_b;

  INSERT INTO _w18a VALUES
    ('mb_a', v_mb_a), ('mb_b', v_mb_b), ('mb_c', v_mb_c),
    ('u_a', v_u_a), ('u_b', v_u_b), ('u_c', v_u_c),
    ('cal_a', v_cal_a), ('cal_b', v_cal_b), ('cal_a_fb', v_cal_a_fb),
    ('ev_a', v_ev_a), ('ev_b', v_ev_b), ('ev_a_fb', v_ev_a_fb), ('ev_a_priv', v_ev_a_priv),
    ('att_a', v_att_a), ('att_b', v_att_b), ('att_a_fb', v_att_a_fb), ('att_a_priv', v_att_a_priv),
    ('tz_a', v_tz_a), ('tz_b', v_tz_b),
    ('ab_a', v_ab_a), ('ab_b', v_ab_b),
    ('ct_a', v_ct_a), ('ct_b', v_ct_b),
    ('cg_a', v_cg_a), ('cg_b', v_cg_b),
    ('cgm_a', v_cgm_a), ('cgm_b', v_cgm_b),
    ('rem_a', v_rem_a), ('rem_b', v_rem_b),
    ('del_a', v_del_a), ('del_b', v_del_b),
    ('sig_a', v_sig_a), ('sig_b', v_sig_b),
    ('unp_a', v_unp_a), ('unp_b', v_unp_b),
    ('us_a', v_us_a), ('us_b', v_us_b),
    ('tpl_a', v_tpl_a), ('tpl_b', v_tpl_b);
END $$;

GRANT SELECT ON _w18a TO setjoin_app;

-- ── 3) Switch to setjoin_app (NOSUPERUSER NOBYPASSRLS) with UNSET GUCs ──────
SET LOCAL ROLE setjoin_app;
SELECT set_config('app.current_user_id', '', true);
SELECT set_config('app.current_mailbox_id', '', true);

-- All 20 tables MUST fail closed (0 rows visible) when GUCs are unset.
SELECT is((SELECT count(*)::int FROM calendars WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cal_a','cal_b'))), 0, 'unset GUC: calendars fail-closed');
SELECT is((SELECT count(*)::int FROM calendar_acls WHERE calendar_id IN (SELECT v FROM _w18a WHERE k IN ('cal_a','cal_b'))), 0, 'unset GUC: calendar_acls fail-closed');
SELECT is((SELECT count(*)::int FROM calendar_events WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ev_a','ev_b'))), 0, 'unset GUC: calendar_events fail-closed');
SELECT is((SELECT count(*)::int FROM event_attendees WHERE id IN (SELECT v FROM _w18a WHERE k IN ('att_a','att_b'))), 0, 'unset GUC: event_attendees fail-closed');
SELECT is((SELECT count(*)::int FROM vt_timezone WHERE id IN (SELECT v FROM _w18a WHERE k IN ('tz_a','tz_b'))), 0, 'unset GUC: vt_timezone fail-closed');
SELECT is((SELECT count(*)::int FROM addressbooks WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ab_a','ab_b'))), 0, 'unset GUC: addressbooks fail-closed');
SELECT is((SELECT count(*)::int FROM contacts WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ct_a','ct_b'))), 0, 'unset GUC: contacts fail-closed');
SELECT is((SELECT count(*)::int FROM contact_groups WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cg_a','cg_b'))), 0, 'unset GUC: contact_groups fail-closed');
SELECT is((SELECT count(*)::int FROM contact_group_members WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cgm_a','cgm_b'))), 0, 'unset GUC: contact_group_members fail-closed');
SELECT is((SELECT count(*)::int FROM reminders WHERE id IN (SELECT v FROM _w18a WHERE k IN ('rem_a','rem_b'))), 0, 'unset GUC: reminders fail-closed');
SELECT is((SELECT count(*)::int FROM blob_user_usage WHERE user_id IN (SELECT v FROM _w18a WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: blob_user_usage fail-closed');
SELECT is((SELECT count(*)::int FROM blob_user_charges WHERE user_id IN (SELECT v FROM _w18a WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: blob_user_charges fail-closed');
SELECT is((SELECT count(*)::int FROM approval_delegations WHERE id IN (SELECT v FROM _w18a WHERE k IN ('del_a','del_b'))), 0, 'unset GUC: approval_delegations fail-closed');
SELECT is((SELECT count(*)::int FROM signatures WHERE id IN (SELECT v FROM _w18a WHERE k IN ('sig_a','sig_b'))), 0, 'unset GUC: signatures fail-closed');
SELECT is((SELECT count(*)::int FROM user_imap_settings WHERE user_id IN (SELECT v FROM _w18a WHERE k IN ('u_a','u_b'))), 0, 'unset GUC: user_imap_settings fail-closed');
SELECT is((SELECT count(*)::int FROM user_notification_prefs WHERE id IN (SELECT v FROM _w18a WHERE k IN ('unp_a','unp_b'))), 0, 'unset GUC: user_notification_prefs fail-closed');
SELECT is((SELECT count(*)::int FROM user_signatures WHERE id IN (SELECT v FROM _w18a WHERE k IN ('us_a','us_b'))), 0, 'unset GUC: user_signatures fail-closed');
SELECT is((SELECT count(*)::int FROM vacation_settings WHERE mailbox_id IN (SELECT v FROM _w18a WHERE k IN ('mb_a','mb_b'))), 0, 'unset GUC: vacation_settings fail-closed');
SELECT is((SELECT count(*)::int FROM vacation_replies WHERE mailbox_id IN (SELECT v FROM _w18a WHERE k IN ('mb_a','mb_b'))), 0, 'unset GUC: vacation_replies fail-closed');
SELECT is((SELECT count(*)::int FROM email_templates WHERE id IN (SELECT v FROM _w18a WHERE k IN ('tpl_a','tpl_b'))), 0, 'unset GUC: email_templates fail-closed');

-- ── 4) Divergent-ID trap: setting mailbox GUC to user_id sees 0 mailbox rows ──
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18a WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18a WHERE k = 'u_a'), true);
SELECT is((SELECT count(*)::int FROM calendars WHERE id = (SELECT v FROM _w18a WHERE k = 'cal_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 calendars');
SELECT is((SELECT count(*)::int FROM reminders WHERE id = (SELECT v FROM _w18a WHERE k = 'rem_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 reminders');
SELECT is((SELECT count(*)::int FROM vacation_settings WHERE mailbox_id = (SELECT v FROM _w18a WHERE k = 'mb_a')), 0, 'divergent ID: user_id in mailbox GUC sees 0 vacation_settings');

-- ── 5) Tenant A scope (MailboxTx: both user_id=u_a and mailbox_id=mb_a) ──────
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18a WHERE k = 'u_a'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18a WHERE k = 'mb_a'), true);

-- Tenant A sees ONLY Tenant A rows (never Tenant B) across all 20 tables.
SELECT is((SELECT count(*)::int FROM calendars WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cal_a','cal_b'))), 1, 'tenant A: sees only own calendar');
SELECT is((SELECT count(*)::int FROM calendar_acls WHERE calendar_id IN (SELECT v FROM _w18a WHERE k IN ('cal_a','cal_b'))), 1, 'tenant A: sees only own calendar_acls');
SELECT is((SELECT count(*)::int FROM calendar_events WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ev_a','ev_b'))), 1, 'tenant A: sees only own calendar_events');
SELECT is((SELECT count(*)::int FROM event_attendees WHERE id IN (SELECT v FROM _w18a WHERE k IN ('att_a','att_b'))), 1, 'tenant A: sees only own event_attendees');
SELECT is((SELECT count(*)::int FROM vt_timezone WHERE id IN (SELECT v FROM _w18a WHERE k IN ('tz_a','tz_b'))), 1, 'tenant A: sees only own vt_timezone');
SELECT is((SELECT count(*)::int FROM addressbooks WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ab_a','ab_b'))), 1, 'tenant A: sees only own addressbooks');
SELECT is((SELECT count(*)::int FROM contacts WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ct_a','ct_b'))), 1, 'tenant A: sees only own contacts');
SELECT is((SELECT count(*)::int FROM contact_groups WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cg_a','cg_b'))), 1, 'tenant A: sees only own contact_groups');
SELECT is((SELECT count(*)::int FROM contact_group_members WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cgm_a','cgm_b'))), 1, 'tenant A: sees only own contact_group_members');
SELECT is((SELECT count(*)::int FROM reminders WHERE id IN (SELECT v FROM _w18a WHERE k IN ('rem_a','rem_b'))), 1, 'tenant A: sees only own reminders');
SELECT is((SELECT count(*)::int FROM blob_user_usage WHERE user_id IN (SELECT v FROM _w18a WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own blob_user_usage');
SELECT is((SELECT count(*)::int FROM blob_user_charges WHERE user_id IN (SELECT v FROM _w18a WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own blob_user_charges');
SELECT is((SELECT count(*)::int FROM approval_delegations WHERE id IN (SELECT v FROM _w18a WHERE k IN ('del_a','del_b'))), 1, 'tenant A: sees only own approval_delegations');
SELECT is((SELECT count(*)::int FROM signatures WHERE id IN (SELECT v FROM _w18a WHERE k IN ('sig_a','sig_b'))), 1, 'tenant A: sees only own signatures');
SELECT is((SELECT count(*)::int FROM user_imap_settings WHERE user_id IN (SELECT v FROM _w18a WHERE k IN ('u_a','u_b'))), 1, 'tenant A: sees only own user_imap_settings');
SELECT is((SELECT count(*)::int FROM user_notification_prefs WHERE id IN (SELECT v FROM _w18a WHERE k IN ('unp_a','unp_b'))), 1, 'tenant A: sees only own user_notification_prefs');
SELECT is((SELECT count(*)::int FROM user_signatures WHERE id IN (SELECT v FROM _w18a WHERE k IN ('us_a','us_b'))), 1, 'tenant A: sees only own user_signatures');
SELECT is((SELECT count(*)::int FROM vacation_settings WHERE mailbox_id IN (SELECT v FROM _w18a WHERE k IN ('mb_a','mb_b'))), 1, 'tenant A: sees only own vacation_settings');
SELECT is((SELECT count(*)::int FROM vacation_replies WHERE mailbox_id IN (SELECT v FROM _w18a WHERE k IN ('mb_a','mb_b'))), 1, 'tenant A: sees only own vacation_replies');
SELECT is((SELECT count(*)::int FROM email_templates WHERE id IN (SELECT v FROM _w18a WHERE k IN ('tpl_a','tpl_b'))), 1, 'tenant A: sees only own email_templates');

-- ── 6) Cross-tenant INSERT / UPDATE / DELETE denial under Tenant A ──────────
SELECT throws_ok(
  $$INSERT INTO calendars (mailbox_id, name) VALUES ((SELECT v FROM _w18a WHERE k = 'mb_b'), 'Injected')$$,
  '42501', NULL,
  'cross-tenant INSERT into calendars denied by FORCE RLS'
);
SELECT throws_ok(
  $$INSERT INTO calendar_events (calendar_id, uid, title, start_at, end_at) VALUES ((SELECT v FROM _w18a WHERE k = 'cal_b'), 'x-inj', 'Injected', now(), now() + interval '1 hour')$$,
  '42501', NULL,
  'cross-tenant INSERT into calendar_events denied by FORCE RLS'
);
SELECT throws_ok(
