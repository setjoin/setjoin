-- ── 8) Calendar ACL sharing without recursion (Carol has read on cal_a & cal_b) ─
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18a WHERE k = 'u_c'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18a WHERE k = 'mb_c'), true);

SELECT is(
  (SELECT count(*)::int FROM calendars WHERE id IN (SELECT v FROM _w18a WHERE k IN ('cal_a','cal_b'))),
  2,
  'calendar ACL: Carol sees both shared calendars with zero RLS recursion'
);
SELECT is(
  (SELECT count(*)::int FROM calendar_events WHERE id IN (SELECT v FROM _w18a WHERE k IN ('ev_a','ev_b'))),
  2,
  'calendar ACL: Carol sees events on shared calendars'
);
SELECT is(
  (SELECT count(*)::int FROM event_attendees WHERE id IN (SELECT v FROM _w18a WHERE k IN ('att_a','att_b'))),
  2,
  'calendar ACL: Carol sees attendees on shared events'
);
-- Read grantee cannot mutate shared calendar events!
WITH u AS (
  UPDATE calendar_events SET title = 'Carol Edit' WHERE id = (SELECT v FROM _w18a WHERE k = 'ev_a') RETURNING id
)
SELECT is((SELECT count(*)::int FROM u), 0, 'calendar ACL: read grantee cannot UPDATE shared event');

SELECT throws_ok(
  $$INSERT INTO calendar_events (calendar_id, uid, title, start_at, end_at) VALUES ((SELECT v FROM _w18a WHERE k = 'cal_a'), 'carol-inj', 'No Write', now(), now() + interval '1 hour')$$,
  '42501', NULL,
  'calendar ACL: read grantee cannot INSERT into shared calendar'
);

-- calendar_effective_acl and calendar_free_busy work cleanly under setjoin_app!
SELECT is(
  calendar_effective_acl((SELECT v FROM _w18a WHERE k = 'u_c'), (SELECT v FROM _w18a WHERE k = 'u_a')),
  'read',
  'calendar_effective_acl resolves explicit grant under setjoin_app FORCE RLS'
);
SELECT is(
  jsonb_array_length(
    calendar_free_busy(
      (SELECT v FROM _w18a WHERE k = 'mb_c'),
      ARRAY[(SELECT v FROM _w18a WHERE k = 'mb_a')],
      now() - interval '2 hours',
      now() + interval '2 hours'
    )->0->'intervals'
  ),
  1,
  'calendar_free_busy returns Alice busy block to Carol under setjoin_app FORCE RLS'
);

-- ── 9) OOO approval delegation resolution under setjoin_app as unrelated requester ─
-- Bob (requester != delegator Alice, != delegate Carol) resolves Alice's active delegate!
SELECT set_config('app.current_user_id', (SELECT v::text FROM _w18a WHERE k = 'u_b'), true);
SELECT set_config('app.current_mailbox_id', (SELECT v::text FROM _w18a WHERE k = 'mb_b'), true);

SELECT is(
