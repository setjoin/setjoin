-- scheduled_action_snooze.pg: snooze handler — re-show in Inbox at wake.
-- Two facts (§6): message_snooze applies the Snoozed tag AND enqueues a `snooze`
-- scheduled_action. At wake the handler clears Snoozed and restores Inbox via
-- transition_message_location. Idempotent: a second run is a no-op.
BEGIN;
SELECT plan(7);

INSERT INTO domains (name, is_local) VALUES ('snw.test', TRUE) ON CONFLICT (name) DO NOTHING;
INSERT INTO users (id, username, domain_id, email, display_name, password_hash, must_change_password)
VALUES (195001, 'snw', (SELECT id FROM domains WHERE name='snw.test'),
        'snw@snw.test', 'Snw', crypt('x', gen_salt('bf')), FALSE) ON CONFLICT (id) DO NOTHING;
-- ADR-003: DIVERGENT ids (user 195001 != mailbox 95001).
INSERT INTO mailboxes (id, user_id, domain_id, email, display_name, type, is_primary)
VALUES (95001, 195001, (SELECT id FROM domains WHERE name='snw.test'),
        'snw@snw.test', 'Snw', 'personal', TRUE) ON CONFLICT (id) DO NOTHING;
SELECT create_system_tags(95001);

-- A message in Inbox owned by 95001.
INSERT INTO messages (id, mailbox_id, folder_id, message_id, subject, from_addr, from_name,
    to_addrs, cc_addrs, bcc_addrs, thread_id, raw_ref, received_at)
VALUES (95001, 95001, (SELECT id FROM tags WHERE mailbox_id=95001 AND name='Inbox'),
    '<snw-1@snw.test>', 'Snooze me', 'snd@snw.test', 'Snd',
    '[]'::JSONB, '[]'::JSONB, '[]'::JSONB, 'thr-snw-1', 'raw/95001', now() - interval '1 hour')
ON CONFLICT (id, received_at) DO NOTHING;
INSERT INTO message_tags (message_id, received_at, tag_id, added_by, is_primary)
SELECT 95001, m.received_at, t.id, 'test', TRUE
FROM tags t, messages m WHERE m.id=95001 AND t.mailbox_id=95001 AND t.name='Inbox' ON CONFLICT DO NOTHING;

-- message_snooze: applies Snoozed tag AND enqueues a snooze scheduled_action.
SELECT lives_ok($$ SELECT message_snooze(95001, 95001, now() + interval '3 hours') $$,
  'message_snooze enqueues a snooze action + applies Snoozed tag');
SELECT is(
  (SELECT count(*) FROM scheduled_actions WHERE action_kind='snooze' AND mailbox_id=95001
     AND (payload->>'message_id')::BIGINT = 95001),
  1::BIGINT, 'snooze scheduled_action created (decoupled from message_tags)');
SELECT is(
  (SELECT count(*) FROM message_tags mt JOIN tags t ON t.id=mt.tag_id
   WHERE mt.message_id=95001 AND t.name='Snoozed'),
  1::BIGINT, 'Snoozed tag applied (the other fact)');

-- Fire the handler (force fire_at past first).
UPDATE scheduled_actions SET fire_at = now() - interval '1 minute'
WHERE action_kind='snooze' AND mailbox_id=95001;
SELECT is(
  (SELECT scheduled_action_snooze(sa)->>'status' FROM scheduled_actions sa
   WHERE action_kind='snooze' AND mailbox_id=95001),
  'ok', 'snooze handler reports ok');
SELECT is(
  (SELECT count(*) FROM message_tags mt JOIN tags t ON t.id=mt.tag_id
   WHERE mt.message_id=95001 AND t.name='Snoozed'),
  0::BIGINT, 'Snoozed tag cleared at wake');
SELECT is(
  (SELECT count(*) FROM message_tags mt JOIN tags t ON t.id=mt.tag_id
   WHERE mt.message_id=95001 AND t.name='Inbox'),
  1::BIGINT, 'message restored to Inbox via transition_message_location');

-- Idempotent: a second run is a clean no-op (still in Inbox, still ok).
SELECT is(
  (SELECT scheduled_action_snooze(sa)->>'status' FROM scheduled_actions sa
   WHERE action_kind='snooze' AND mailbox_id=95001),
  'ok', 'second handler run is an idempotent no-op');

SELECT * FROM finish();
ROLLBACK;
