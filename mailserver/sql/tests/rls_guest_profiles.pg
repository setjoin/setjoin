-- rls_guest_profiles.pg — Guest G2 Task 1 schema and FORCE-RLS denial proof.
BEGIN;
SELECT plan(5);

SELECT ok(
    to_regclass('public.guest_profiles') IS NOT NULL
    AND EXISTS (
        SELECT 1
          FROM pg_constraint c
          JOIN pg_class t ON t.oid = c.conrelid
         WHERE t.oid = to_regclass('public.guest_accounts')
           AND c.conname = 'guest_accounts_profile_fk'
           AND c.confrelid = to_regclass('public.guest_profiles')
           AND c.confdeltype = 'r'
    )
    AND EXISTS (
        SELECT 1
          FROM pg_constraint c
         WHERE c.conname = 'user_app_entitlements_app_check'
           AND c.conrelid = to_regclass('public.user_app_entitlements')
           AND pg_get_constraintdef(c.oid) =
               'CHECK ((app = ANY (ARRAY[''mail''::text, ''calendar''::text, ''contacts''::text, ''tasks''::text, ''chat''::text, ''drive''::text, ''meet''::text])))'
    )
    AND NOT EXISTS (
        SELECT 1
          FROM pg_constraint c
         WHERE c.conrelid = to_regclass('public.guest_profiles')
           AND c.contype = 'c'
           AND pg_get_constraintdef(c.oid) LIKE '%btrim%'
    ),
    'guest_profiles exists with RESTRICT assignment FK, exact app values, and no unrequested name check'
);

SELECT is(
    (
        SELECT array_agg(
            format('%s|%s|%s|%s', column_name, data_type, is_nullable, column_default)
            ORDER BY ordinal_position
        )
          FROM information_schema.columns
         WHERE table_schema = 'public'
           AND table_name = 'guest_profiles'
    ),
    ARRAY[
        'id|bigint|NO|nextval(''guest_profiles_id_seq''::regclass)',
        'host_domain_id|bigint|NO|',
        'name|text|NO|',
        'can_post|boolean|NO|true',
        'history_from_join|boolean|NO|true',
        'allow_download|boolean|NO|false',
        'allow_meet_create|boolean|NO|false',
        'allow_meet_host|boolean|NO|false',
        'can_initiate_dm|boolean|NO|false',
        'allow_native_shell|boolean|NO|true',
        'default_expiry_days|integer|YES|',
        'apps|ARRAY|NO|''{}''::text[]',
        'created_at|timestamp with time zone|NO|now()',
        'updated_at|timestamp with time zone|NO|now()'
    ]::text[],
    'guest_profiles has exactly the spec 4.1 columns, nullability, order, and defaults'
);

SELECT is(
    (SELECT relrowsecurity FROM pg_class WHERE oid = to_regclass('public.guest_profiles')),
    true,
    'guest_profiles has row-level security enabled'
);
SELECT is(
    (SELECT relforcerowsecurity FROM pg_class WHERE oid = to_regclass('public.guest_profiles')),
    true,
    'guest_profiles has row-level security forced'
);

INSERT INTO domains (name, is_local) VALUES
    ('g2-profile-host-a.example', TRUE),
    ('g2-profile-host-b.example', TRUE);

DO $$
BEGIN
    IF to_regclass('public.guest_profiles') IS NOT NULL THEN
        EXECUTE $sql$
            INSERT INTO public.guest_profiles (host_domain_id, name)
            SELECT id, 'Default' FROM public.domains
             WHERE name IN ('g2-profile-host-a.example', 'g2-profile-host-b.example')
        $sql$;
    END IF;
    PERFORM set_config(
        'g2test.other_host_domain_id',
        (SELECT id::text FROM domains WHERE name = 'g2-profile-host-b.example'),
        true
    );
END $$;

CREATE FUNCTION pg_temp.visible_guest_profiles(p_host_domain_id bigint)
RETURNS integer LANGUAGE plpgsql AS $$
DECLARE
    v_count integer;
BEGIN
    IF to_regclass('public.guest_profiles') IS NULL THEN
        RETURN -1;
    END IF;
    EXECUTE 'SELECT count(*) FROM public.guest_profiles WHERE host_domain_id = $1'
       INTO v_count USING p_host_domain_id;
    RETURN v_count;
END;
$$;

SET LOCAL ROLE setjoin_app;
SELECT is(
    pg_temp.visible_guest_profiles(current_setting('g2test.other_host_domain_id')::bigint),
    0,
    'guest_profiles: another host domain''s row is invisible without a reducer'
);

SELECT * FROM finish();
ROLLBACK;
