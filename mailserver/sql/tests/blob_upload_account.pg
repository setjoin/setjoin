-- pgTAP: blob_upload_account — user-scoped blob upload accounting reducer
-- (med-blob-reclamation-001, Astra HOLD: admission, charge insertion, and
-- reclamation arming moved out of handler.go's Go transaction into ONE
-- reducer-owned transaction).
--
-- Proves: measured-byte admission + charge + arming land atomically; a dedup
-- re-upload stores no new bytes and is never charged (and re-arms only a
-- still-unattached canonical); the per-user bound rejects over-quota
-- admission with BZ001 while leaving ZERO partial effects (all-or-none — the
-- blobs row, charge and arming roll back with the rejection), including the
-- exact-boundary arithmetic (charged == bound - size admits; anything more
-- rejects); enforcement OFF (p_quota_bytes <= 0) still records accounting.
--
-- Cross-CONNECTION serialization (simultaneous uploads serialize on the
-- blob_user_usage FOR UPDATE row lock) cannot be expressed in single-session
-- pgTAP; the lock-shaped FOR UPDATE read and its bound decision are proven
-- here, and the concurrent bound is proven by
-- mailserver/internal/blob TestConcurrentUploadsNeverExceedPerUserBound.
--
-- Requires: blob_upload_account, blobs, blob_user_charges, blob_user_usage
-- (V235), blob_cleanup_queue, trg_blob_user_charge_inc/dec (V235).
BEGIN;
SELECT plan(36);

-- ── Fixtures (rolled back with the test transaction) ─────────────────────────
-- blob_user_charges/blob_user_usage deliberately carry no users FK (V235
-- header), so synthetic user ids need no users/mailboxes rows.
SELECT repeat('a1', 32) AS sha_new,
       repeat('b2', 32) AS sha_att,
       repeat('c3', 32) AS sha_fresh,
       repeat('d4', 32) AS sha_quota_a,
       repeat('e5', 32) AS sha_quota_b,
       repeat('f6', 32) AS sha_quota_c,
       repeat('07', 32) AS sha_big,
       repeat('18', 32) AS sha_edge,
       repeat('29', 32) AS sha_over
  \gset

-- ── Shape ────────────────────────────────────────────────────────────────────
SELECT has_function('blob_upload_account');

-- ── Validation: defense-in-depth BZ040 (the gateway pre-validates these) ────
SELECT throws_ok(
  $f$SELECT blob_upload_account(NULL, repeat('a1',32), 'blobs/x', 1, 't', 60, 0)$f$,
  'BZ040', NULL, 'NULL p_user_id is refused (BZ040)');
SELECT throws_ok(
  $f$SELECT blob_upload_account(4242, 'NOTAHASH', 'blobs/x', 1, 't', 60, 0)$f$,
  'BZ040', NULL, 'a non-hex p_blob_sha256 is refused (BZ040)');
SELECT throws_ok(
  $f$SELECT blob_upload_account(4242, repeat('a1',32), 'blobs/x', -1, 't', 60, 0)$f$,
  'BZ040', NULL, 'a negative measured size is refused (BZ040)');
SELECT throws_ok(
  $f$SELECT blob_upload_account(4242, repeat('a1',32), 'blobs/x', 1, 't', 0, 0)$f$,
  'BZ040', NULL, 'a non-positive grace window is refused (BZ040)');

-- ══ Phase 1: admission + charge + arming land together ══════════════════════
SELECT is(
  (blob_upload_account(4242, :'sha_new', 'blobs/' || :'sha_new', 100, 'application/pdf', 60, 0))->>'result',
  'stored', 'a fresh blob admits as stored');
SELECT is(
  (SELECT size_bytes FROM blobs WHERE sha256 = :'sha_new'),
  100::bigint, 'the blobs row carries the measured byte size');
SELECT is(
  (SELECT ref_count FROM blobs WHERE sha256 = :'sha_new'),
  0, 'a fresh admission is stored at ref_count = 0');
SELECT is(
  (SELECT user_id::text || ':' || size_bytes FROM blob_user_charges WHERE blob_sha256 = :'sha_new'),
  '4242:100', 'the charge attributes the measured bytes to the uploading user');
SELECT is(
  (SELECT charged_bytes FROM blob_user_usage WHERE user_id = 4242),
  100::bigint, 'the V235 inc trigger sums the charge into the user aggregate');
SELECT is(
  (SELECT delay_minutes FROM blob_cleanup_queue WHERE blob_sha256 = :'sha_new'),
  60, 'arming writes the queue row with the configured grace window');
SELECT is(
  (SELECT (scheduled_at + make_interval(mins => delay_minutes)) >= now()
     FROM blob_cleanup_queue WHERE blob_sha256 = :'sha_new'),
  true, 'a freshly armed entry is not yet due');

-- ══ Phase 2: dedup re-upload — no new bytes, no second charge, re-arm ════════
-- Make the entry due first, so the re-arm (ON CONFLICT DO UPDATE) is observable:
-- a DO NOTHING would leave it due with delay 0; the bump restores the window.
UPDATE blob_cleanup_queue SET scheduled_at = now() - interval '1 minute', delay_minutes = 0
 WHERE blob_sha256 = :'sha_new';
SELECT is(
  (blob_upload_account(5252, :'sha_new', 'blobs/' || :'sha_new', 100, 'application/pdf', 60, 0))->>'result',
  'dedup', 'a re-upload of the same content deduplicates');
SELECT is(
  (SELECT count(*)::int FROM blob_user_charges WHERE blob_sha256 = :'sha_new'),
  1, 'a dedup re-upload stores no second charge');
SELECT is(
  (SELECT charged_bytes FROM blob_user_usage WHERE user_id = 4242),
  100::bigint, 'the first uploader''s aggregate is unchanged by a dedup re-upload');
SELECT is(
  (SELECT count(*)::int FROM blob_user_usage WHERE user_id = 5252),
  0, 'the deduplicating user is charged nothing (no usage row)');
SELECT is(
  (SELECT delay_minutes FROM blob_cleanup_queue WHERE blob_sha256 = :'sha_new'),
  60, 'the dedup re-upload re-arms the grace window (delay restored)');
SELECT is(
  (SELECT (scheduled_at + make_interval(mins => delay_minutes)) >= now()
     FROM blob_cleanup_queue WHERE blob_sha256 = :'sha_new'),
  true, 'the re-armed entry is no longer due');

-- Attached canonical: a dedup re-upload must NOT arm (the V075 detach trigger
-- owns attached blobs' reclamation).
INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, ref_count)
VALUES (:'sha_att', 'blobs/' || :'sha_att', 5, 'application/octet-stream', 1);
SELECT is(
  (blob_upload_account(5252, :'sha_att', 'blobs/' || :'sha_att', 5, 'application/octet-stream', 60, 0))->>'result',
  'dedup', 'a dedup re-upload of an attached canonical still dedups');
SELECT is(
  (SELECT count(*)::int FROM blob_cleanup_queue WHERE blob_sha256 = :'sha_att'),
  0, 'arming skips an attached canonical (ref_count = 1, V075 trigger territory)');

-- Unattached canonical with no queue entry: a dedup re-upload arms it.
INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, ref_count)
VALUES (:'sha_fresh', 'blobs/' || :'sha_fresh', 7, 'application/octet-stream', 0);
SELECT is(
  (blob_upload_account(5252, :'sha_fresh', 'blobs/' || :'sha_fresh', 7, 'application/octet-stream', 60, 0))->>'result',
  'dedup', 'a dedup re-upload of an unattached canonical dedups');
SELECT is(
  (SELECT delay_minutes FROM blob_cleanup_queue WHERE blob_sha256 = :'sha_fresh'),
  60, 'arming covers a still-unattached canonical that had no queue entry');

-- ══ Phase 3: serialized quota bound (user 6262, bound 1000) ══════════════════
SELECT is(
  (blob_upload_account(6262, :'sha_quota_a', 'blobs/' || :'sha_quota_a', 400, 'application/octet-stream', 60, 1000))->>'result',
  'stored', 'first 400-byte upload admits under the 1000-byte bound');
SELECT is(
  (blob_upload_account(6262, :'sha_quota_b', 'blobs/' || :'sha_quota_b', 400, 'application/octet-stream', 60, 1000))->>'result',
  'stored', 'second 400-byte upload admits (800 ≤ 1000)');
-- Over-bound admission raises the registered storage-quota code and aborts the
-- WHOLE reducer — no blobs row, no charge, no arming, aggregate untouched.
SELECT throws_ok(
  $f$SELECT blob_upload_account(6262, repeat('f6',32), 'blobs/x', 400, 'application/octet-stream', 60, 1000)$f$,
  'BZ001', NULL, 'a third 400-byte upload is rejected over the bound (BZ001 over_quota)');
SELECT is(
  (SELECT count(*)::int FROM blobs WHERE sha256 = :'sha_quota_c'),
  0, 'the rejected upload persists NO blobs row (transaction rolled back)');
SELECT is(
  (SELECT count(*)::int FROM blob_user_charges WHERE user_id = 6262),
  2, 'the rejected upload persists NO charge row');
SELECT is(
  (SELECT charged_bytes FROM blob_user_usage WHERE user_id = 6262),
  800::bigint, 'the aggregate is exactly the accepted bytes after the rejection');

-- Boundary arithmetic (the overflow-safe shape: charged > bound - size):
-- 800 == 1000 - 200 admits; anything more rejects.
SELECT is(
  (blob_upload_account(6262, :'sha_edge', 'blobs/' || :'sha_edge', 200, 'application/octet-stream', 60, 1000))->>'result',
  'stored', 'a boundary upload charging the bound exactly admits');
SELECT throws_ok(
  $f$SELECT blob_upload_account(6262, repeat('29',32), 'blobs/x', 1, 'application/octet-stream', 60, 1000)$f$,
  'BZ001', NULL, 'one byte past the exact bound is rejected (BZ001)');

-- An upload larger than the whole bound rejects even from an empty aggregate.
SELECT throws_ok(
  $f$SELECT blob_upload_account(6464, '07' || repeat('00', 31), 'blobs/x', 400, 'application/octet-stream', 60, 100)$f$,
  'BZ001', NULL, 'a single upload over the whole bound is rejected (BZ001)');
SELECT is(
  (SELECT count(*)::int FROM blob_user_usage WHERE user_id = 6464),
  0, 'a fully-rejected uploader is left with no usage row');

-- ══ Phase 4: enforcement OFF (p_quota_bytes <= 0) still records accounting ══
SELECT is(
  (blob_upload_account(6363, :'sha_big', 'blobs/' || :'sha_big', 5000, 'application/octet-stream', 60, 0))->>'result',
  'stored', 'with enforcement OFF even a large upload admits');
SELECT is(
  (SELECT charged_bytes FROM blob_user_usage WHERE user_id = 6363),
  5000::bigint, 'enforcement OFF still records the measured-byte accounting');

-- ══ Dec trigger parity: reclaiming a charged blob credits the aggregate ═════
DELETE FROM blobs WHERE sha256 = :'sha_quota_a';
SELECT is(
  (SELECT charged_bytes FROM blob_user_usage WHERE user_id = 6262),
  600::bigint, 'reclamation (blob delete) cascades the charge and credits the aggregate');

-- ── Migration bookkeeping ────────────────────────────────────────────────────
SELECT is(
  (SELECT count(*)::int FROM schema_migrations WHERE version = 243),
  1, 'schema_migrations records version 243');

SELECT * FROM finish();
ROLLBACK;
