-- sharing_default_clear.pg — pgTAP tests for the sharing_defaults delete reducer
-- (spec 2026-06-27-sharing-delegation-design.md §4 / D8).
-- Covers: owner clears own user-scope row, non-owner non-admin BZ116, unknown
-- id BZ114, sharing.manage admin clears an org row, domain-scope gate, audit.
BEGIN;
SELECT plan(8);

-- fixtures (mirror sharing_default_set.pg)
INSERT INTO domains (id, name, is_local) VALUES
  (95011, 'sdc-a.test', TRUE),
  (95012, 'sdc-b.test', TRUE);
INSERT INTO users (id, username, domain_id, email, display_name, enabled) VALUES
  (95211, 'sdc_alice', 95011, 'alice@sdc-a.test', 'Alice', TRUE),
  (95212, 'sdc_admin', 95011, 'admin@sdc-a.test', 'Admin', TRUE),
  (95213, 'sdc_rando', 95011, 'rando@sdc-a.test', 'Rando', TRUE),
  (95214, 'sdc_badmin', 95012, 'badmin@sdc-b.test', 'B Admin', TRUE);
INSERT INTO admin_role_groups (id, name, permissions) VALUES
  (95511, 'sdc-sharing-admin', ARRAY['sharing.manage']);
INSERT INTO admin_role_groups (id, name, permissions, domain_scope) VALUES
  (95512, 'sdc-sharing-admin-b', ARRAY['sharing.manage'], 95012);
INSERT INTO admin_role_assignments (user_id, role_group_id, granted_by) VALUES
  (95212, 95511, 95212),
  (95214, 95512, 95212);

CREATE TEMP TABLE _sdc AS
SELECT (SELECT sharing_default_set(95211, 'calendar', 'user', 95211, 'everyone', 95011, 'none'))    AS user_row,
       (SELECT sharing_default_set(95212, 'calendar', 'org',  95011, 'everyone', 95011, 'freebusy')) AS org_row;

-- unknown id → BZ114
SELECT throws_ok(
  $$SELECT sharing_default_clear(95211, 999999999)$$,
  'BZ114', NULL, 'unknown id raises BZ114');

-- a non-owner non-admin cannot clear someone else's user-scope row
SELECT throws_ok(
  format($$SELECT sharing_default_clear(95213, %s)$$, (SELECT user_row FROM _sdc)),
  'BZ116', NULL, 'non-owner non-admin clear raises BZ116');

-- a non-admin cannot clear an org row
SELECT throws_ok(
  format($$SELECT sharing_default_clear(95213, %s)$$, (SELECT org_row FROM _sdc)),
  'BZ116', NULL, 'non-admin org-row clear raises BZ116');

-- a domain-B-scoped admin cannot clear a domain-A org row (D7)
SELECT throws_ok(
  format($$SELECT sharing_default_clear(95214, %s)$$, (SELECT org_row FROM _sdc)),
  'BZ116', NULL, 'cross-domain admin clear raises BZ116');

-- owner clears their own user-scope row
SELECT lives_ok(
  format($$SELECT sharing_default_clear(95211, %s)$$, (SELECT user_row FROM _sdc)),
  'owner clears own row');
SELECT is(
  (SELECT count(*)::int FROM sharing_defaults WHERE id = (SELECT user_row FROM _sdc)),
  0, 'user row deleted');

-- sharing.manage admin clears the org row
SELECT lives_ok(
  format($$SELECT sharing_default_clear(95212, %s)$$, (SELECT org_row FROM _sdc)),
  'admin clears org row');

-- audit (D8)
SELECT ok(
  (SELECT count(*) FROM admin_audit_log WHERE action = 'sharing_default_cleared' AND user_id = 95211) >= 1
  AND (SELECT count(*) FROM admin_audit_log WHERE action = 'sharing_default_cleared' AND user_id = 95212) >= 1,
  'audit rows written');

SELECT * FROM finish();
ROLLBACK;
