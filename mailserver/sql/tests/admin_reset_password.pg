-- pgTAP: authoritative administrator password reset.
--
-- Proves the reducer re-evaluates current OU/domain reach after taking its
-- target lock and keeps password replacement plus complete revocation atomic.
BEGIN;
SELECT plan(9);

INSERT INTO domains (id, name, is_local) OVERRIDING SYSTEM VALUE VALUES
  (95710, 'reset-authority.test', TRUE);

INSERT INTO departments (id, name, path, ldap_ou) OVERRIDING SYSTEM VALUE VALUES
  (95701, 'Engineering', '/eng',   'ou=Engineering,dc=reset,dc=test'),
  (95702, 'Sales',       '/sales', 'ou=Sales,dc=reset,dc=test');

INSERT INTO users (
  id, username, domain_id, department_id, email, display_name,
  password_hash, enabled
) OVERRIDING SYSTEM VALUE VALUES
  (95711, 'reset_actor',  95710, NULL,  'actor@reset-authority.test',
   'Reset Actor', 'actor-old', TRUE),
  (95712, 'reset_in',     95710, 95701, 'in@reset-authority.test',
   'In Scope', 'in-old', TRUE),
  (95713, 'reset_moved',  95710, 95702, 'moved@reset-authority.test',
   'Moved Out', 'moved-old', TRUE);

INSERT INTO admin_role_groups (
  id, name, permissions, domain_scope
) OVERRIDING SYSTEM VALUE VALUES
  (95701, 'reset-eng-admin', ARRAY['users.password_reset'], 95710);

INSERT INTO admin_role_assignments (
  user_id, role_group_id, scope_type, scope_id, granted_by
) VALUES
  (95711, 95701, 'ou', 95701, 95711);

INSERT INTO oauth_tokens (
  user_id, token_hash, token_type, expires_at
) VALUES (
  95712, digest('reset-authority-refresh','sha256'),
  'refresh', now()+interval '1 hour'
);
INSERT INTO sessions (
  id, user_id, token_hash, expires_at, auth_method
) VALUES (
  'reset-authority-session', 95712,
  digest('reset-authority-access','sha256'),
  now()+interval '1 hour', 'password'
);

SELECT ok(
  admin_can_manage_with_permission(
    95711, 95712, 'users.password_reset'
  ),
  'one live assignment owns both reset permission and Engineering reach'
);

SET LOCAL ROLE setjoin_app;
SELECT lives_ok(
  $$SELECT admin_reset_password(
      95711,95712,95710,'in-new',TRUE
    )$$,
  'in-scope reset commits through the production application role'
);
RESET ROLE;
SELECT is(
  (SELECT password_hash FROM users WHERE id=95712),
  'in-new',
  'successful reducer changes the password hash'
);
SELECT is(
  (SELECT count(*)::int FROM sessions WHERE user_id=95712),
  0,
  'successful reducer removes runtime sessions'
);
SELECT is(
  (SELECT count(*)::int FROM oauth_tokens
    WHERE user_id=95712 AND revoked_at IS NULL),
  0,
  'successful reducer revokes active OAuth anchors'
);
SELECT is(
  (SELECT count(*)::int FROM session_revocations
    WHERE user_id=95712 AND scope='all'
      AND reason='admin_password_reset'),
  1,
  'successful reducer records one all-session revocation'
);

-- This is the post-move state the password-reset transaction must authorize
-- after its early gateway check: the target is now in /sales, outside /eng.
SELECT throws_ok(
  $$SELECT admin_reset_password(
      95711,95713,95710,'moved-new',TRUE
    )$$,
  'BZ061', NULL,
  'target outside current OU reach is rejected inside the reducer'
);
SELECT is(
  (SELECT password_hash FROM users WHERE id=95713),
  'moved-old',
  'out-of-scope denial leaves the password unchanged'
);
SELECT is(
  (SELECT count(*)::int FROM session_revocations WHERE user_id=95713),
  0,
  'out-of-scope denial creates no revocation side effect'
);

SELECT * FROM finish();
ROLLBACK;
