-- pgTAP: Wave 2.4 (#551) — Blob reclamation lifecycle under Mark-and-Sweep GC.
--
-- Replaces the retired blobs.ref_count / blob_cleanup_queue trigger tests:
--   • verifies blobs.ref_count column and blob_cleanup_queue table are dropped (V293)
--   • two message_attachments on one sha256 keep blob_has_live_reference() = true
--   • deleting one attachment keeps it live (still referenced by the second)
--   • deleting the last attachment makes blob_has_live_reference() = false
--   • past the 24h grace floor, blob_gc_mark() transitions it to reclaim_eligible
--
-- Namespaced fixture ids (domain 96010 / user 79010 / mailbox 99010 / message
-- 990100 / attachments 990101-2) so this file never collides with a sibling test.
BEGIN;
SELECT plan(6);

SELECT is(
  (SELECT count(*)::int FROM information_schema.columns
    WHERE table_schema = 'public' AND table_name = 'blobs' AND column_name = 'ref_count'),
  0, 'V293 retired public.blobs.ref_count column');

SELECT is(
  to_regclass('public.blob_cleanup_queue'),
  NULL, 'V293 dropped public.blob_cleanup_queue table');

INSERT INTO domains (id, name, is_local) VALUES (96010, 'blobrc.test', TRUE)
  ON CONFLICT (id) DO NOTHING;
INSERT INTO users (id, username, domain_id, email, display_name)
  VALUES (79010, 'blobrc', 96010, 'u@blobrc.test', 'BlobRC')
  ON CONFLICT (id) DO NOTHING;
INSERT INTO mailboxes (id, user_id, domain_id, email, display_name, type, is_primary)
  VALUES (99010, 79010, 96010, 'u@blobrc.test', 'BlobRC', 'personal', TRUE)
  ON CONFLICT (id) DO NOTHING;

INSERT INTO messages (id, mailbox_id, folder_id, message_id, subject, from_addr, from_name,
    to_addrs, cc_addrs, bcc_addrs, thread_id, raw_ref, received_at)
  VALUES (990100, 99010, 1, '<blobrc-1@blobrc.test>', 'Has attachments', 'u@blobrc.test', 'BlobRC',
    '[]'::JSONB, '[]'::JSONB, '[]'::JSONB, 'thread-blobrc-1', 'raw/990100', now())
  ON CONFLICT (id, received_at) DO NOTHING;

SELECT repeat('99', 32) AS test_sha \gset

-- Seed an old (>24h grace) canonical blob with two message_attachments.
INSERT INTO blobs (sha256, minio_ref, size_bytes, content_type, created_at)
  VALUES (:'test_sha', 'blobs/' || :'test_sha', 1024, 'application/pdf', now() - interval '48 hours');

INSERT INTO message_attachments (id, message_id, received_at, blob_sha256, filename, content_type, size_bytes)
  SELECT 990101, 990100, m.received_at, :'test_sha', 'a.pdf', 'application/pdf', 1024
    FROM messages m WHERE m.id = 990100;
INSERT INTO message_attachments (id, message_id, received_at, blob_sha256, filename, content_type, size_bytes)
  SELECT 990102, 990100, m.received_at, :'test_sha', 'b.pdf', 'application/pdf', 1024
    FROM messages m WHERE m.id = 990100;

-- 3. Two attachments mark the blob live.
SELECT is(
  public.blob_has_live_reference(:'test_sha'),
  true,
  'two message_attachments on one sha256 keep blob live');

-- 4. Deleting one attachment leaves the blob live.
DELETE FROM message_attachments WHERE id = 990101;
SELECT is(
  public.blob_has_live_reference(:'test_sha'),
  true,
  'deleting one attachment keeps blob live while second attachment remains');

-- 5. Deleting the last attachment drops the live reference.
DELETE FROM message_attachments WHERE id = 990102;
SELECT is(
  public.blob_has_live_reference(:'test_sha'),
  false,
  'deleting the last attachment drops live reference');

-- 6. Mark-and-Sweep Phase 1 marks the unreferenced >24h blob reclaim_eligible.
SELECT public.blob_gc_mark(1440, 0, 500);
SELECT is(
  (SELECT gc_state FROM public.blob_gc_state WHERE blob_sha256 = :'test_sha'),
  'reclaim_eligible',
  'blob_gc_mark transitions unreferenced >24h blob to reclaim_eligible');

SELECT * FROM finish();
ROLLBACK;
