-- revoke_user_sessions.pg — pgTAP: complete all-session revocation boundary.
BEGIN;
SELECT plan(30);
SET LOCAL app.capture_notify = 'on';

-- Seed: FK targets — user_id=1 (target) + user_id=9 (admin actor, audit FK).
INSERT INTO domains (id, name, is_local) VALUES (1, 'test.revoke.example', TRUE)
  ON CONFLICT DO NOTHING;
INSERT INTO users (id, username, domain_id, email, display_name, password_hash)
  VALUES (1, 'revokeuser', 1, 'revokeuser@test.revoke.example', 'Revoke User', 'x'),
         (9, 'adminuser',  1, 'admin@test.revoke.example',      'Admin User',  'x'),
         (910001, 'revokeapprole', 1,
          'revokeapprole@test.revoke.example', 'App Role Revoke User', 'x')
  ON CONFLICT DO NOTHING;

INSERT INTO oauth_tokens(user_id,token_hash,token_type,expires_at)
VALUES (1,digest('revoke-refresh','sha256'),'refresh',now()+interval '1 hour');
-- er5-s12 (occ_39d362b7ed334db62e35b41c): the OIDC PROVIDER's own token store
-- is a distinct table (oidc_tokens) from first-party oauth_tokens — a disable
-- must revoke BOTH, or the OP refresh grant keeps the federated RP session
-- alive forever. Seed one live OP session (with a refresh grant) for the
-- target user plus one for a DIFFERENT user to prove scoping.
INSERT INTO oidc_clients(id, name, secret, redirect_uris)
VALUES ('relying-party-client', 'er5-s12 RP fixture', 'x', ARRAY['https://rp.example/cb'])
  ON CONFLICT (id) DO NOTHING;
INSERT INTO oidc_tokens(id,client_id,user_id,subject,refresh_token_hash,refresh_expires_at,scopes,expires_at)
VALUES ('revoke-op-token','relying-party-client',1,'revokeuser@local',
        digest('revoke-op-refresh','sha256'),now()+interval '30 days',
        ARRAY['openid','email'],now()+interval '5 minutes'),
       ('revoke-op-token-other','relying-party-client',9,'admin@local',
        digest('revoke-op-refresh-other','sha256'),now()+interval '30 days',
        ARRAY['openid'],now()+interval '5 minutes');
INSERT INTO sessions(id,user_id,token_hash,expires_at,auth_method)
VALUES ('revoke-session',1,digest('revoke-access','sha256'),
        now()+interval '1 hour','oidc');
INSERT INTO ws_subscriptions(connection_id,session_id,user_id)
VALUES ('revoke-ws','revoke-session',1);
SELECT identity_auth_link_elevation_begin(
  1,'11111111-1111-4111-8111-111111111111',
  'revoke-session',digest('revoke-access','sha256'),
  'oidc','test-revoke-provider',now()+interval '5 minutes'
);

-- Insert a denylist row (scope='all') and capture the notify tee.
CREATE TEMP TABLE _rev AS
SELECT revoke_user_sessions(1, 'all', 'admin_revoke_all', 9, NULL, NULL) AS id;

SELECT isnt((SELECT id FROM _rev), NULL, 'revoke_user_sessions returns the new id');
SELECT is(
  (SELECT scope FROM session_revocations WHERE id = (SELECT id FROM _rev)),
  'all', 'denylist row written with scope=all');
SELECT ok(
  (SELECT expires_at > now()+interval '30 days'
     FROM session_revocations WHERE id = (SELECT id FROM _rev)),
  'all-scope enforcement row has a bounded 31-day lifetime');

-- The push fired once on the fixed channel, with user_id+scope in the payload.
SELECT is(
  (SELECT count(*)::int FROM _test_notify_log WHERE channel = 'session_revoke'),
  1, 'app_notify fired exactly once on session_revoke');
SELECT is(
  (SELECT (payload::jsonb)->>'user_id' FROM _test_notify_log WHERE channel='session_revoke'),
  '1', 'payload carries user_id');
SELECT isnt(
  (SELECT (payload::jsonb)->>'expires_at'
     FROM _test_notify_log WHERE channel='session_revoke'),
  NULL, 'payload carries the enforcement expiry');

-- CA-0b: audit row written in-txn for the sensitive revocation write.
SELECT is(
  (SELECT count(*)::int FROM admin_audit_log
   WHERE action = 'revoke_user_sessions' AND target_id = 1),
  1, 'CA-0b audit row written for revoked user');

SELECT is(
  (SELECT count(*)::int FROM oauth_tokens
    WHERE user_id=1 AND revoked_at IS NULL),
  0, 'scope=all revokes every active OAuth token anchor');
SELECT is(
  (SELECT count(*)::int FROM oidc_tokens
    WHERE user_id=1 AND revoked_at IS NULL),
  0, 'scope=all revokes every active OIDC Provider session (er5-s12)');
SELECT is(
  (SELECT count(*)::int FROM oidc_tokens
    WHERE user_id=9 AND revoked_at IS NULL),
  1, 'scope=all leaves OTHER users'' OIDC Provider sessions active');
SELECT isnt(
  (SELECT revoked_at FROM oidc_tokens WHERE id='revoke-op-token'),
  NULL, 'the OP token row is revoked in place (never deleted)');
SELECT is(
  (SELECT count(*)::int FROM sessions WHERE user_id=1),
  0, 'scope=all removes every HTTP session');
SELECT is(
  (SELECT count(*)::int FROM ws_subscriptions WHERE user_id=1),
  0, 'scope=all removes every websocket subscription');
SELECT is(
  (SELECT count(*)::int FROM identity_auth_link_elevations
    WHERE user_id=1 AND consumed_at IS NULL),
  0, 'scope=all invalidates every pending identity-link elevation');

SELECT revoke_user_sessions(1, 'all', 'repeat_all', 9, NULL, NULL);
SELECT is(
  (SELECT count(*)::int FROM session_revocations
    WHERE user_id=1 AND scope='all'),
  1, 'repeated all-scope revocation compacts to one greatest watermark');

INSERT INTO oauth_tokens(
  user_id,token_hash,token_type,expires_at,family_id
) VALUES
  (1,digest('family-a','sha256'),'refresh',now()+interval '40 days',
   'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'),
  (1,digest('family-b','sha256'),'refresh',now()+interval '40 days',
   'bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb');
SELECT revoke_user_sessions(
  1,'family','family_test',9,NULL,
  'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
);
SELECT is(
  (SELECT count(*)::int FROM oauth_tokens
    WHERE user_id=1
      AND family_id='aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
      AND revoked_at IS NULL),
  0, 'family scope revokes the matching durable refresh anchors');
SELECT is(
  (SELECT count(*)::int FROM oauth_tokens
    WHERE user_id=1
      AND family_id='bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
      AND revoked_at IS NULL),
  1, 'family scope leaves sibling refresh families active');
-- Narrow scopes stay narrow: the OP store has no family/jti concept, and a
-- family/jti denylist event must NOT widen into it (er5-s12 scope contract).
SELECT is(
  (SELECT count(*)::int FROM oidc_tokens
    WHERE revoked_at IS NULL),
  1, 'family scope does NOT widen into the OIDC Provider store');
SELECT ok(
  (SELECT expires_at >= now()+interval '39 days'
     FROM session_revocations
    WHERE user_id=1 AND scope='family'),
  'family enforcement survives through the durable family lifetime');
SELECT throws_ok(
  $$ SELECT revoke_user_sessions(1,'family','bad',9,NULL,'') $$,
  'BZ097', NULL, 'family scope requires a non-empty family id');

INSERT INTO sessions(id,user_id,token_hash,expires_at,auth_method)
VALUES ('target-jti',1,digest('target-jti','sha256'),
        now()+interval '2 hours','oidc');
SELECT revoke_user_sessions(1,'jti','jti_test',9,'target-jti',NULL);
SELECT is(
  (SELECT count(*)::int FROM sessions
    WHERE user_id=1 AND id='target-jti'),
  0, 'JTI scope removes the matching persisted web session');
SELECT ok(
  (SELECT expires_at > now()+interval '30 days'
     FROM session_revocations
    WHERE user_id=1 AND scope='jti' AND jti='target-jti'),
  'JTI enforcement has the access-token compatibility lifetime');
SELECT is(
  (SELECT count(*)::int FROM oidc_tokens
    WHERE revoked_at IS NULL),
  1, 'jti scope also does NOT widen into the OIDC Provider store');

-- Production reachability: setjoin_app is NOBYPASSRLS while link elevations
-- are FORCE-RLS deny-all. The reducer's narrowly pinned definer boundary must
-- still perform the complete cleanup rather than silently deleting zero rows.
INSERT INTO oauth_tokens(user_id,token_hash,token_type,expires_at)
VALUES (910001,digest('revoke-refresh-app-role','sha256'),
        'refresh',now()+interval '1 hour');
INSERT INTO oidc_tokens(id,client_id,user_id,subject,refresh_token_hash,refresh_expires_at,scopes,expires_at)
VALUES ('revoke-op-token-app-role','relying-party-client',910001,'approle@local',
        digest('revoke-op-refresh-app-role','sha256'),now()+interval '30 days',
        ARRAY['openid'],now()+interval '5 minutes');
INSERT INTO sessions(id,user_id,token_hash,expires_at,auth_method)
VALUES ('revoke-session-app-role',910001,digest('revoke-access-app-role','sha256'),
        now()+interval '1 hour','oidc');
INSERT INTO ws_subscriptions(connection_id,session_id,user_id)
VALUES ('revoke-ws-app-role','revoke-session-app-role',910001);
SELECT identity_auth_link_elevation_begin(
  910001,'22222222-2222-4222-8222-222222222222',
  'revoke-session-app-role',digest('revoke-access-app-role','sha256'),
  'oidc','test-revoke-provider-app-role',now()+interval '5 minutes'
);
SET LOCAL ROLE setjoin_app;
SELECT lives_ok(
  $$SELECT revoke_user_sessions(
      910001,'all','app_role_revoke_all',9,NULL,NULL
    )$$,
  'setjoin_app can execute the complete definer-owned revocation boundary'
);
RESET ROLE;
SELECT is(
  (SELECT count(*)::int FROM oauth_tokens
    WHERE user_id=910001 AND revoked_at IS NULL),
  0, 'application-role revoke closes active OAuth anchors');
SELECT is(
  (SELECT count(*)::int FROM oidc_tokens
    WHERE user_id=910001 AND revoked_at IS NULL),
  0, 'application-role revoke closes OIDC Provider sessions under RLS too');
SELECT is(
  (SELECT count(*)::int FROM sessions WHERE user_id=910001),
  0, 'application-role revoke closes HTTP sessions');
SELECT is(
  (SELECT count(*)::int FROM ws_subscriptions WHERE user_id=910001),
  0, 'application-role revoke closes websocket subscriptions');
SELECT is(
  (SELECT count(*)::int FROM identity_auth_link_elevations
    WHERE user_id=910001 AND consumed_at IS NULL),
  0, 'application-role revoke bypasses elevation RLS only inside the reducer');

-- Illegal scope → BZ097.
SELECT throws_ok(
  $$ SELECT revoke_user_sessions(1, 'bogus', 'r', NULL, NULL, NULL) $$,
  'BZ097', NULL, 'illegal scope raises BZ097');

SELECT finish();
ROLLBACK;
