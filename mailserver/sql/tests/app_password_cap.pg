-- pgTAP test for the per-user app-password cap (trg_app_password_limit trigger).
-- The BEFORE INSERT trigger on app_passwords rejects the 11th *active*
-- (revoked_at IS NULL) password for a user with ERRCODE BZ015.
BEGIN;
SELECT plan(4);

-- Namespaced fixtures (domain 96015 / user 70015) so the per-user count is isolated.
INSERT INTO domains (id, name, is_local)
VALUES (96015, 'apcap-test.example', TRUE)
ON CONFLICT (id) DO NOTHING;

INSERT INTO users (id, username, email, display_name, password_hash, domain_id, enabled)
VALUES (70015, 'apcap', 'apcap@apcap-test.example', 'AppPw Cap', '$2a$10$abcdefghijklmnopqrstuv', 96015, TRUE)
ON CONFLICT (id) DO NOTHING;

-- Fill the cap: exactly 10 active app passwords (the 10th sees 9 existing, allowed).
INSERT INTO app_passwords (user_id, name, token_hash)
SELECT 70015, 'ap' || g, 'hash' || g FROM generate_series(1, 10) g;

-- 1. We are exactly at the cap with 10 active passwords.
SELECT is(
  (SELECT COUNT(*) FROM app_passwords WHERE user_id = 70015 AND revoked_at IS NULL),
  10::bigint,
  'user 70015 holds 10 active app passwords (at the cap)'
);

-- 2. The 11th active insert is rejected with BZ015 and the documented message.
SELECT throws_ok(
  $$ INSERT INTO app_passwords (user_id, name, token_hash) VALUES (70015, 'ap11', 'hash11') $$,
  'BZ015',
  'Maximum 10 app passwords per user',
  '11th active app password rejected with BZ015'
);

-- 3. Revoked passwords do not count toward the cap: revoke one, then an insert succeeds.
UPDATE app_passwords SET revoked_at = now()
WHERE id = (SELECT MIN(id) FROM app_passwords WHERE user_id = 70015 AND revoked_at IS NULL);

SELECT lives_ok(
  $$ INSERT INTO app_passwords (user_id, name, token_hash) VALUES (70015, 'ap-after-revoke', 'hashr') $$,
  'insert succeeds after revoking one (revoked rows excluded from the cap)'
);

-- 4. Back at 10 active again → the cap re-engages and rejects the next insert.
SELECT throws_ok(
  $$ INSERT INTO app_passwords (user_id, name, token_hash) VALUES (70015, 'ap-over', 'hasho') $$,
  'BZ015',
  'Maximum 10 app passwords per user',
  'cap re-engages once back at 10 active passwords'
);

SELECT * FROM finish();
ROLLBACK;
