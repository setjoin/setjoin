-- device_hmac_secret_enc.pg — pgTAP for V247 (med-auth-baseline-secrets-001 /
-- D-AUTHSERVER-SQL--ARCHIVE-003): devices.hmac_secret moves to the family's
-- AES-256-GCM _enc format with key-id handling.
--
-- Proven here (this package's acceptance ONLY):
--   1. the at-rest shape: hmac_secret nullable; hmac_secret_enc + hmac_secret_key_id
--      present; registration-shaped and migrated rows store ONLY _enc ciphertext
--      (plaintext cleared, envelope + active key id stamped);
--   2. the med-shard2-006 revoke rotation still functions against a ciphertext row
--      (no cross-column constraint blocks the lifecycle reducer);
--   3. the V247 schema_migrations record exists.
-- NOT asserted here: V060 devices_admin_read / app-pool read scope for
-- hmac_secret — that evidence is owned by med-dbschema-rls-001. This file closes
-- no RLS claim. The EK01 envelope CONTENT (AES-256-GCM under the app master key)
-- is proven by shared/device Go tests; SQL only exercises the storage shape with
-- placeholder envelopes ('EK01' magic || random body).
BEGIN;
SELECT plan(11);

-- ── 1–3: schema shape ────────────────────────────────────────────────────────
SELECT has_column('devices', 'hmac_secret_enc',
  'devices has the hmac_secret_enc envelope column');
SELECT col_type_is('devices', 'hmac_secret_enc', 'bytea',
  'hmac_secret_enc is bytea (EK01 envelope)');
SELECT has_column('devices', 'hmac_secret_key_id',
  'devices has the hmac_secret_key_id key-version column');
SELECT ok(
  (SELECT NOT attnotnull FROM pg_attribute
    WHERE attrelid = 'devices'::regclass AND attname = 'hmac_secret'),
  'hmac_secret dropped NOT NULL (legacy rows + ciphertext-only writes coexist)');

-- ── Fixture: domain + user (device ids 90071/90072/90073) ───────────────────
INSERT INTO domains (name, is_local) VALUES ('hmacenc.test', TRUE)
  ON CONFLICT (name) DO NOTHING;
INSERT INTO users (id, username, domain_id, email, display_name, password_hash)
  SELECT 90071, 'hmacenc_actor',
    (SELECT id FROM domains WHERE name = 'hmacenc.test'),
    'dev@hmacenc.test', 'HMAC Enc Actor', 'x'
  WHERE NOT EXISTS (SELECT 1 FROM users WHERE id = 90071);

-- ── 4: registration-shaped write stores ONLY ciphertext ─────────────────────
-- Mirrors the Go writer (RegisterDevice): envelope + key id in, plaintext never
-- persisted (hmac_secret NULL — possible only after V247 dropped NOT NULL).
INSERT INTO devices (id, user_id, fingerprint, hmac_secret, hmac_secret_enc, hmac_secret_key_id)
VALUES (90071, 90071, repeat('e', 40), NULL,
        'EK01'::bytea || gen_random_bytes(41), 'v1');
SELECT is(
  (SELECT (hmac_secret IS NULL)::int
          + (hmac_secret_enc IS NOT NULL)::int
          + (hmac_secret_key_id = 'v1')::int
     FROM devices WHERE id = 90071),
  3,
  'registration-shaped row stores only _enc ciphertext with the active key id');

-- ── 5: migrated-from-plaintext leg ends ciphertext-only ─────────────────────
-- Legacy row (pre-V247 plaintext), then the app's lazy migration (one atomic
-- UPDATE: envelope + key id in, plaintext out — shared/device GetDeviceSecret).
INSERT INTO devices (id, user_id, fingerprint, hmac_secret)
VALUES (90072, 90071, repeat('f', 40), 'legacy-issued-hmac-secret');
UPDATE devices
   SET hmac_secret_enc    = 'EK01'::bytea || gen_random_bytes(41),
       hmac_secret_key_id = 'v1',
       hmac_secret        = NULL
 WHERE id = 90072 AND hmac_secret = 'legacy-issued-hmac-secret' AND hmac_secret_enc IS NULL;
SELECT is(
  (SELECT (hmac_secret IS NULL)::int
          + (hmac_secret_enc IS NOT NULL)::int
          + (hmac_secret_key_id = 'v1')::int
     FROM devices WHERE id = 90072),
  3,
  'row migrated from plaintext stores only _enc ciphertext (compatibility leg)');
SELECT is(
  (SELECT hmac_secret FROM devices WHERE id = 90072),
  NULL,
  'the issued plaintext is gone after migration');

-- ── 6: revoke rotation still functions on a ciphertext row ──────────────────
-- med-shard2-006 control must keep working: a revoked row's trust value is
-- replaced; the lifecycle reducer must not be blocked by the new columns.
SELECT lives_ok(
  $$ SELECT device_enroll_transition(90071, 90071, 'enrolled', 'enc test enroll') $$,
  'unenrolled -> enrolled works for a ciphertext row');
SELECT lives_ok(
  $$ SELECT device_enroll_transition(90071, 90071, 'revoked', 'enc test revoke') $$,
  'enrolled -> revoked (with rotation) works for a ciphertext row');
SELECT is(
  (SELECT enroll_state FROM devices WHERE id = 90071),
  'revoked',
  'ciphertext row reaches revoked state through the lifecycle reducer');

-- ── 7: schema_migrations record ─────────────────────────────────────────────
SELECT ok(
  (SELECT EXISTS (SELECT 1 FROM schema_migrations WHERE version = 247)),
  'V247 recorded in schema_migrations');

SELECT * FROM finish();
ROLLBACK;
