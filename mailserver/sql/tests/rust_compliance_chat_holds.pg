BEGIN;
SELECT plan(24);
CREATE TEMP TABLE compl3_hold_actor AS SELECT mk_account('compl3-hold-sql') AS mailbox_id;
ALTER TABLE compl3_hold_actor ADD COLUMN user_id bigint;
UPDATE compl3_hold_actor a SET user_id=m.user_id FROM mailboxes m WHERE m.id=a.mailbox_id;
CREATE TEMP TABLE compl3_hold_role AS WITH x AS (INSERT INTO admin_role_groups(name,permissions) VALUES ('compl3-hold-sql',ARRAY['chat.compliance_manage']) RETURNING id) SELECT id FROM x;
INSERT INTO admin_role_assignments(role_group_id,user_id) SELECT r.id,a.user_id FROM compl3_hold_role r CROSS JOIN compl3_hold_actor a;
UPDATE feature_toggles SET enabled=true WHERE key='feature.chat_compliance';
CREATE TEMP TABLE compl3_hold_case AS WITH x AS (INSERT INTO ediscovery_cases(name,created_by) SELECT 'Hold SQL',user_id FROM compl3_hold_actor RETURNING id) SELECT id FROM x;
CREATE TEMP TABLE compl3_hold_channel AS WITH x AS (INSERT INTO chat_channels(kind,name,created_by) SELECT 'channel','compl3-hold-sql',user_id FROM compl3_hold_actor RETURNING id) SELECT id FROM x;
CREATE TEMP TABLE compl3_hold_result AS SELECT rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'hold',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'channelId',(SELECT id FROM compl3_hold_channel),'reason','SQL evidence'),'127.0.0.1') AS result;
SELECT is((SELECT (result->>'status')::int FROM compl3_hold_result),201,'permitted hold succeeds');
SELECT is((SELECT created_by FROM chat_case_holds WHERE id=(SELECT (result->'body'->>'holdId')::bigint FROM compl3_hold_result)),(SELECT user_id FROM compl3_hold_actor),'hold actor is authenticated');
SELECT is((SELECT count(*)::int FROM chat_case_hold_channels WHERE hold_id=(SELECT (result->'body'->>'holdId')::bigint FROM compl3_hold_result)),1,'hold covers selected channel');
SELECT is((SELECT count(*)::int FROM admin_audit_log WHERE action='chat_case_hold_set' AND user_id=(SELECT user_id FROM compl3_hold_actor)),1,'hold adds one core audit');
SELECT is((rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'release',jsonb_build_object('holdId',(SELECT (result->'body'->>'holdId')::bigint FROM compl3_hold_result),'reason',''),'127.0.0.1')->>'status')::int,204,'Go permits release with empty reason');
SELECT is((SELECT released_by FROM chat_case_holds WHERE id=(SELECT (result->'body'->>'holdId')::bigint FROM compl3_hold_result)),(SELECT user_id FROM compl3_hold_actor),'release actor is authenticated');
SELECT throws_like($test$SELECT rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'release',jsonb_build_object('holdId',(SELECT (result->'body'->>'holdId')::bigint FROM compl3_hold_result),'reason','again'),'127.0.0.1')$test$,'%already released%','repeat release is refused without duplicate audit');
DELETE FROM admin_role_assignments WHERE role_group_id=(SELECT id FROM compl3_hold_role);
SELECT is((rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'hold',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'channelId',(SELECT id FROM compl3_hold_channel),'reason','Revoked'),'127.0.0.1')->>'status')::int,403,'revoked grant cannot place hold');
INSERT INTO admin_role_assignments(role_group_id,user_id) SELECT r.id,a.user_id FROM compl3_hold_role r CROSS JOIN compl3_hold_actor a;
SELECT is((rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'search',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'query',jsonb_build_object('terms','no-hits'),'han',false,'limit',50),'127.0.0.1')->>'status')::int,403,'management alone cannot read content');
SELECT is((rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'export',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'query',jsonb_build_object('channels',jsonb_build_array((SELECT id FROM compl3_hold_channel)),'includeAttachments',false)),'127.0.0.1')->>'status')::int,403,'management alone cannot export content');
UPDATE admin_role_groups SET permissions=array_append(permissions,'chat.ediscovery') WHERE id=(SELECT id FROM compl3_hold_role);
CREATE TEMP TABLE compl3_search_result AS SELECT rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'search',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'query',jsonb_build_object('terms','no-hits'),'han',false,'limit',50),'127.0.0.1') AS result;
SELECT is((SELECT (result->>'status')::int FROM compl3_search_result),200,'content grant authorizes search');
SELECT is((SELECT executed_by FROM chat_ediscovery_searches WHERE case_id=(SELECT id FROM compl3_hold_case)),(SELECT user_id FROM compl3_hold_actor),'persisted search actor comes from authentication');
SELECT is((SELECT count(*)::int FROM admin_audit_log WHERE action='chat_ediscovery_search' AND user_id=(SELECT user_id FROM compl3_hold_actor)),1,'search records one best-effort core audit');
CREATE TEMP TABLE compl3_read_result AS SELECT rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'read',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'channelId',(SELECT id FROM compl3_hold_channel),'limit',100),'127.0.0.1') AS result;
SELECT is((SELECT (result->>'status')::int FROM compl3_read_result),200,'content grant authorizes audited channel read');
SELECT is((SELECT count(*)::int FROM chat_ediscovery_searches WHERE case_id=(SELECT id FROM compl3_hold_case) AND kind='read' AND executed_by=(SELECT user_id FROM compl3_hold_actor)),1,'channel read persists its authenticated case record');
SELECT is((SELECT count(*)::int FROM admin_audit_log WHERE action='chat_ediscovery_read' AND user_id=(SELECT user_id FROM compl3_hold_actor)),1,'channel read adds one core audit');
CREATE TEMP TABLE compl3_export_result AS SELECT rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'export',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'query',jsonb_build_object('channels',jsonb_build_array((SELECT id FROM compl3_hold_channel)),'includeAttachments',false)),'127.0.0.1') AS result;
SELECT is((SELECT (result->>'status')::int FROM compl3_export_result),200,'content grant authorizes canonical export begin');
SELECT is((SELECT executed_by FROM chat_ediscovery_searches WHERE case_id=(SELECT id FROM compl3_hold_case) AND kind='export'),(SELECT user_id FROM compl3_hold_actor),'export actor comes from authentication');
SELECT is((SELECT count(*)::int FROM admin_audit_log WHERE action='chat_ediscovery_export' AND user_id=(SELECT user_id FROM compl3_hold_actor)),1,'export adds one core audit');
SELECT is((SELECT count(*)::int FROM chat_audit_log WHERE channel_id=(SELECT id FROM compl3_hold_channel) AND action='export.run'),1,'export commits its mandatory channel-chain act');
UPDATE admin_role_groups SET permissions=ARRAY['chat.compliance_manage'] WHERE id=(SELECT id FROM compl3_hold_role);
SELECT is((rust_compliance_chat_command((SELECT user_id FROM compl3_hold_actor),false,'export',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'query',jsonb_build_object('channels',jsonb_build_array((SELECT id FROM compl3_hold_channel)),'includeAttachments',false)),'127.0.0.1')->>'status')::int,403,'revoked live content grant cannot export');
SELECT is((SELECT count(*)::int FROM chat_ediscovery_searches WHERE case_id=(SELECT id FROM compl3_hold_case) AND kind='export'),1,'revocation produces no extra export record');
SELECT is((rust_compliance_chat_command(0,true,'export',jsonb_build_object('caseId',(SELECT id FROM compl3_hold_case),'query',jsonb_build_object('channels',jsonb_build_array((SELECT id FROM compl3_hold_channel)),'includeAttachments',false)),'127.0.0.1')->>'status')::int,403,'zero actor is denied even with signed provenance');
SELECT is((SELECT count(*)::int FROM chat_audit_log WHERE channel_id=(SELECT id FROM compl3_hold_channel) AND action='export.run'),1,'denials add no channel-chain act');
SELECT * FROM finish();
ROLLBACK;
