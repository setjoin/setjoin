-- chat_presence.pg: typing signal (Pillar A1 Task 7). No table backs this
-- feature (ephemeral notify only) — chat_channel_members has no FK to users
-- (V119), so bare bigint ids suffice as fixtures throughout.
-- Requires: chat_presence.sql, chat_channel.sql, notify_chat_state.sql.
BEGIN;
SELECT plan(7);
SELECT set_config('app.capture_notify', 'on', true);

-- ── Fixture: a small 2-member channel ──────────────────────────────────────
-- 701 = owner, 702 = member, 703 = never joins (non-member fixture).
SELECT chat_channel_create(701, 'presence-small') AS small_id \gset
SELECT chat_member_add(701, :small_id, 702);

-- chat_member_add's own 'member_added' fan-out already put one notify on
-- BOTH chat:701 and chat:702 (702 is a fan-out target of its own join) —
-- capture the baseline so the typing assert below is a delta, not a total.
SELECT notify_count('chat:702') AS n_before_typing \gset

-- Test 1: a member's typing signal fans out to co-members without erroring.
SELECT lives_ok(format($$ SELECT chat_typing_signal(701, %s) $$, :small_id),
  'member typing signal succeeds');

-- Test 2: it actually pushes — exactly one additional notify lands on the
-- OTHER member's self-channel.
SELECT is(notify_count('chat:702'), :n_before_typing + 1, 'typing signal notifies the co-member');
SELECT is(last_notify_event('chat:702'), 'typing', 'notify payload event is "typing"');

-- Test 3: a non-member raises BZ163 (same code/shape as chat_message.sql).
SELECT throws_ok(format($$ SELECT chat_typing_signal(703, %s) $$, :small_id),
  'BZ163', NULL, 'a non-member raises BZ163');

-- ── Fixture: a 33-member channel (over the >32 cap) ────────────────────────
-- Bulk-inserted directly (not via chat_member_add) so the setup itself
-- generates no typing-relevant notify traffic to disentangle from the assert.
SELECT chat_channel_create(710, 'presence-big') AS big_id \gset
INSERT INTO chat_channel_members (channel_id, user_id, role)
  SELECT :big_id, 800 + g, 'member' FROM generate_series(1, 32) g;
SELECT is((SELECT count(*)::int FROM chat_channel_members WHERE channel_id = :big_id),
  33, 'fixture channel has 33 members (owner + 32)');

-- Test 4: over the cap, the signal no-ops — zero notify rows anywhere.
SELECT notify_count('chat:710') AS n_before \gset
SELECT lives_ok(format($$ SELECT chat_typing_signal(710, %s) $$, :big_id),
  'typing signal on an over-cap channel does not error');
SELECT is(notify_count('chat:710'), :n_before,
  'typing signal on a 33-member channel produces zero additional notify rows');

SELECT * FROM finish();
ROLLBACK;
