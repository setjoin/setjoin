-- Exchange replacement assessment schema, registry and default-OFF contract.
BEGIN;
SELECT plan(21);

SELECT has_table('exchange_registry_snapshots', 'registry snapshot table exists');
SELECT has_table('exchange_assessment_projects', 'project table exists');
SELECT has_table('exchange_assessment_runs', 'run table exists');
SELECT has_table('exchange_assessment_leases', 'lease/fencing table exists');
SELECT has_table('exchange_assessment_probe_results', 'probe result table exists');
SELECT has_table('exchange_assessment_artifacts', 'artifact lifecycle table exists');
SELECT has_table('exchange_assessment_evidence', 'evidence table exists');
SELECT has_table('exchange_assessment_decisions', 'decision table exists');
SELECT has_table('exchange_assessment_publications', 'immutable publication table exists');
SELECT has_table('exchange_assessment_tombstones', 'deletion tombstone table exists');
SELECT has_table('exchange_assessment_idempotency', 'idempotency replay table exists');
SELECT ok((SELECT relrowsecurity AND relforcerowsecurity FROM pg_class WHERE oid='exchange_assessment_idempotency'::regclass), 'idempotency table has ENABLE + FORCE RLS');
SELECT ok(EXISTS(SELECT 1 FROM schema_migrations WHERE version=219), 'upgrade-safe Exchange SoD permission-map migration is installed');

INSERT INTO exchange_assessment_idempotency(idempotency_key,actor_id,operation,payload_sha256,result)
SELECT '11111111-1111-4111-8111-111111111111',id,'project.create',repeat('a',64),'{}'::jsonb
FROM users ORDER BY id LIMIT 1;
SET LOCAL ROLE setjoin_app;
SELECT is(
  (SELECT count(*) FROM exchange_assessment_idempotency),
  0::bigint, 'setjoin_app cannot read worker-only Exchange idempotency receipts'
);
RESET ROLE;

SELECT is(
  (SELECT source_digest FROM exchange_registry_snapshots WHERE registry_version=1),
  'cf6f4a008b80a10314b120fb058802bae42386c92af7fa187d18745cf7f50f09',
  'compiled registry digest survives SQL load'
);
SELECT is(
  (SELECT projection->>'sourceDigest' FROM exchange_registry_snapshots WHERE registry_version=1),
  (SELECT source_digest FROM exchange_registry_snapshots WHERE registry_version=1),
  'compile/load/export registry digest round-trips'
);
SELECT is(
  (SELECT enabled FROM feature_toggles WHERE key='feature.exchange_replacement_assessment'),
  false,
  'product assessment feature is default OFF'
);
SELECT is(
  (SELECT count(*)::integer FROM admin_permissions WHERE permission_key LIKE 'exchange.assessment.%'),
  7,
  'seven granular permissions are installed'
);
SELECT ok(
  (SELECT permissions @> ARRAY[
    'exchange.assessment.read','exchange.assessment.run','exchange.assessment.decide',
    'exchange.assessment.attest','exchange.assessment.audit','exchange.assessment.publish',
    'exchange.assessment.delete'
  ] FROM admin_role_groups WHERE id=1),
  'Super Admin receives the complete assessment permission set'
);
SELECT throws_ok(
  $$INSERT INTO exchange_registry_snapshots(registry_version,source_digest,projection)
    VALUES(2,'bad','{}')$$,
  '23514', NULL, 'registry digest shape is constrained'
);
SELECT throws_ok(
  $$INSERT INTO exchange_assessment_probe_results(
      run_id,root_id,probe_id,capability_id,stable_instance_id,terminal_state,observed_at)
    VALUES(999999,'r','p','c','i','silently_skipped',now())$$,
  '23514', NULL, 'unknown terminal result state is rejected before FK evaluation'
);

SELECT * FROM finish();
ROLLBACK;
