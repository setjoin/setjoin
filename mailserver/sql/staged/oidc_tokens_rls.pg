-- STAGED, NOT RUN: needs staged/oidc_tokens_force_rls.sql applied (see its header).
-- #525: oidc_tokens is FORCE-RLS on app.current_user_id; credential-keyed lookups
-- go through worker-owned reducers that derive the user from the credential.
BEGIN;
SELECT plan(24);
INSERT INTO domains(name,is_local) VALUES('oidc-rls-pgtap.test',true) RETURNING id AS dom \gset
INSERT INTO users(username,email,display_name,domain_id,password_hash) VALUES('a@oidc-rls-pgtap.test','a@oidc-rls-pgtap.test','a',:dom,'x') RETURNING id AS ua \gset
INSERT INTO users(username,email,display_name,domain_id,password_hash) VALUES('b@oidc-rls-pgtap.test','b@oidc-rls-pgtap.test','b',:dom,'x') RETURNING id AS ub \gset
INSERT INTO oidc_clients(id,name,secret,redirect_uris) VALUES('oidc-rls-pgtap','t','x',ARRAY['https://rp.test/cb']),('oidc-rls-other','t','x',ARRAY['https://rp.test/cb']);
INSERT INTO oidc_tokens(id,client_id,user_id,subject,scopes,expires_at,refresh_token_hash,refresh_expires_at)
VALUES('tok-a','oidc-rls-pgtap',:ua,:'ua',ARRAY['openid','offline_access'],now()+interval '5 minutes','hash-a',now()+interval '30 days'),
      ('tok-b','oidc-rls-pgtap',:ub,:'ub',ARRAY['openid','email'],now()+interval '5 minutes','hash-b',now()+interval '30 days');
INSERT INTO oidc_tokens(id,client_id,user_id,subject,scopes,expires_at,refresh_token_hash,refresh_expires_at,revoked_at)
VALUES('tok-b-spent','oidc-rls-pgtap',:ub,:'ub',ARRAY['openid'],now()+interval '5 minutes','hash-b-spent',now()+interval '30 days',now());
SELECT ok((SELECT relrowsecurity AND relforcerowsecurity FROM pg_class WHERE relname='oidc_tokens'),'oidc_tokens is ENABLE+FORCE RLS');
SET LOCAL ROLE setjoin_app;
-- no principal: fail closed
SELECT is((SELECT count(*) FROM oidc_tokens),0::bigint,'no user GUC reads nothing');
SELECT is((SELECT count(*) FROM oidc_tokens WHERE refresh_token_hash='hash-a'),0::bigint,'no user GUC cannot find a token by credential');
SELECT throws_ok($$INSERT INTO oidc_tokens(id,client_id,user_id,subject,scopes,expires_at) VALUES('x-none','oidc-rls-pgtap',1,'1',ARRAY['openid'],now())$$,'42501',NULL,'no user GUC cannot insert');
RESET ROLE;
SELECT set_config('app.current_user_id',:'ua',true);
SET LOCAL ROLE setjoin_app;
SELECT is((SELECT count(*) FROM oidc_tokens),1::bigint,'user A sees only A rows');
SELECT is((SELECT count(*) FROM oidc_tokens WHERE id='tok-b'),0::bigint,'user A cannot read B by id');
SELECT is((SELECT count(*) FROM oidc_tokens WHERE refresh_token_hash='hash-b'),0::bigint,'user A cannot read B by refresh hash');
SELECT throws_ok(format($$INSERT INTO oidc_tokens(id,client_id,user_id,subject,scopes,expires_at) VALUES('x-forged','oidc-rls-pgtap',%s,'%s',ARRAY['openid'],now())$$,:ub,:ub),'42501',NULL,'user A cannot insert a row for B');
SELECT lives_ok(format($$INSERT INTO oidc_tokens(id,client_id,user_id,subject,scopes,expires_at) VALUES('own-new','oidc-rls-pgtap',%s,'%s',ARRAY['openid'],now())$$,:ua,:ua),'user A inserts own row');
WITH u AS (UPDATE oidc_tokens SET revoked_at=now() WHERE id='tok-b' RETURNING 1) SELECT is((SELECT count(*) FROM u),0::bigint,'user A cannot revoke B by id');
WITH u AS (UPDATE oidc_tokens SET revoked_at=now() WHERE refresh_token_hash='hash-b' RETURNING 1) SELECT is((SELECT count(*) FROM u),0::bigint,'user A cannot revoke B by hash');
SELECT throws_ok(format($$UPDATE oidc_tokens SET user_id=%s WHERE id='tok-a'$$,:ub),'42501',NULL,'user A cannot reassign own row to B');
WITH d AS (DELETE FROM oidc_tokens WHERE id='tok-b' RETURNING 1) SELECT is((SELECT count(*) FROM d),0::bigint,'user A cannot delete B');
-- credential reducers derive the user from the credential
SELECT is((SELECT user_id FROM rust_identity_oidc_refresh_anchor('hash-b')),:ub::bigint,'anchor derives B from B''s hash, not the caller');
SELECT is((SELECT spent FROM rust_identity_oidc_refresh_anchor('hash-b-spent')),true,'anchor reports a spent token');
SELECT is((SELECT live FROM rust_identity_oidc_refresh_anchor('hash-b')),true,'anchor reports a live token');
SELECT is((SELECT count(*) FROM rust_identity_oidc_refresh_anchor('no-such-hash')),0::bigint,'anchor of an unknown hash is empty');
SELECT is((SELECT user_id FROM rust_identity_oidc_token_owner('tok-b')),:ub::bigint,'token owner derives from the stored row');
SELECT is((SELECT count(*) FROM rust_identity_oidc_token_owner('no-such-id')),0::bigint,'unknown token id has no owner');
SELECT is((SELECT user_id FROM rust_identity_oidc_revoke_target('hash-b','nope','oidc-rls-pgtap')),:ub::bigint,'revoke target by hash');
SELECT is((SELECT user_id FROM rust_identity_oidc_revoke_target('nope','tok-b','oidc-rls-pgtap')),:ub::bigint,'revoke target by id');
SELECT is((SELECT count(*) FROM rust_identity_oidc_revoke_target('hash-b','tok-b','oidc-rls-other')),0::bigint,'another client cannot target the token');
SELECT is((SELECT count(*) FROM oidc_tokens WHERE id='tok-b' AND revoked_at IS NULL)+(SELECT count(*) FROM rust_identity_oidc_token_owner('tok-b') WHERE false),0::bigint,'B row stays invisible after lookups');
RESET ROLE;
SELECT is((SELECT count(*) FROM oidc_tokens WHERE id='tok-b' AND revoked_at IS NULL AND user_id=:ub),1::bigint,'B row is untouched by A''s attempts');
SELECT * FROM finish();
ROLLBACK;
