# setjoin asrbot (Meet B3 captions bot) env — rendered by lib-livekit.sh
# (render_asrbot_env, called from install.sh) into /etc/setjoin/asrbot.env
# (0600), read by setjoin-asr-bot.service via EnvironmentFile=. Full env
# contract: asrbot/AGENTS.md. This process holds no DB/S3 credential (D4) —
# never add one here.
LIVEKIT_URL={{LIVEKIT_URL}}
FUNASR_URL={{FUNASR_URL|ws://127.0.0.1:10096}}
# Loopback-only (refused at startup by bot.ValidateLoopback otherwise).
ASR_LISTEN={{ASR_LISTEN|127.0.0.1:7890}}
# The control-API bearer secret (B3 Task 18 pipeline-review finding 1) —
# required (bot.ValidateToken refuses to start without it). The SAME value
# install.sh writes into config.env's ASR_TOKEN (law 3, one secret one
# generation step) — mismatched values mean every gateway->asrbot call 401s.
ASR_TOKEN={{ASR_TOKEN}}
ASR_MAX_MEETINGS={{ASR_MAX_MEETINGS|2}}
ASR_MAX_ACTIVE_TRACKS={{ASR_MAX_ACTIVE_TRACKS|4}}
