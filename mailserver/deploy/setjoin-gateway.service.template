[Unit]
Description=Setjoin Rust server (setjoin-server, unit setjoin-gateway.service)
Documentation=https://github.com/setjoin/setjoin/blob/main/docs/adr/ARCH-031-go-is-deleted.md
# Systemd owns the loopback HTTP and configured public HTTPS sockets. The loopback
# listener (setjoin-gateway.socket) queues connections across a restart instead
# of refusing them and the process needs no capability. All non-/auth/* routes
# are served natively by setjoin-server, and /auth/* is proxied to setjoin-auth.
# Rollback reinstalls the previous release's matching binaries, units, socket
# set and configuration.
Requires=setjoin-gateway.socket
After=network.target setjoin-gateway.socket setjoin-auth.service
Wants=setjoin-auth.service
# Stay inactive (not failed) if the active release does not carry setjoin-server.
ConditionPathExists={{RUNTIME_DIR}}/setjoin-server
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User={{USER|setjoin}}
Group={{GROUP|setjoin}}
ExecStart={{RUNTIME_DIR}}/setjoin-server
# Federation gets only its app/worker/LISTEN credentials and static settings.
# Never load config.env or the owner credential tier into the front door.
EnvironmentFile=-{{FEDERATION_ENV}}
# Storage gets only S3/MinIO endpoint and credentials, independent of SMTP
# enablement (#289 legal holds, blobs, attachments).
EnvironmentFile=-{{STORAGE_ENV}}
# SMTP (#501) likewise gets its own allow-listed file: the worker tier and the
# settings it needs, never the owner credential tier or config.env.
EnvironmentFile=-{{SMTP_ENV}}
EnvironmentFile={{GATEWAY_ENV}}
EnvironmentFile=-{{TLS_ENV}}
Restart=always
RestartSec=2
# The gateway drains active HTTP for 30s on SIGTERM.
TimeoutStopSec=40
# When SETJOIN_SEARCH_TIER2_ENABLED=true, raise MemoryMax (e.g. >= 768M) to
# accommodate cgroup-charged Tantivy MmapDirectory faulted pages, lazy CJK
# dictionaries, and the 32 MB default (<= 50 MB capped) writer heap.
MemoryMax=512M
TasksMax=512
LimitNOFILE=65536

# No capability: the socket is bound by systemd.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=setjoin/search
StateDirectoryMode=0700
ReadWritePaths=-/var/lib/setjoin/search
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=setjoin-gateway

[Install]
WantedBy=multi-user.target
Also=setjoin-gateway.socket
