[Unit]
Description=Setjoin native SMTP inbound MTA (STARTTLS-less, as frozen Go) listener (#501)
ConditionPathExists={{RUNTIME_DIR}}/setjoin-gateway

[Socket]
ListenStream={{SMTP_LISTEN}}
FileDescriptorName=smtp
Service=setjoin-gateway.service
Accept=no
NoDelay=true
Backlog=4096

[Install]
WantedBy=sockets.target
