[Unit]
Description=SetJoin Auth Server (Rust setjoin-auth)
Documentation=https://github.com/setjoin/setjoin
After=network.target postgresql.service
Wants=postgresql.service
# The server (setjoin-gateway.service) proxies /auth/* routes to this process.
# Ordering only (Wants, not Requires, on the server side), so a server restart
# never hard-depends on auth being healthy.
Before=setjoin-gateway.service
# StartLimit* live in [Unit] (systemd ignores them under [Service]).
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User={{USER|setjoin}}
Group={{GROUP|setjoin}}
WorkingDirectory={{RUNTIME_DIR}}
ExecStart={{RUNTIME_DIR}}/setjoin-auth

ExecStartPre=/bin/sh -c 'until pg_isready -U mail -d mailserver -h 127.0.0.1; do sleep 2; done'
# Readiness through setjoin-auth's direct loopback /health endpoint, without
# credentials (a failed login from 127.0.0.1 would feed captcha/tarpit).
ExecStartPost=/bin/sh -c 'i=0; while [ $$i -lt 150 ]; do if curl -sf --max-time 2 "http://${LISTEN_ADDR}/health" >/dev/null 2>&1; then exit 0; fi; i=$$((i+1)); sleep 1; done; echo "setjoin-auth: /health not ready" >&2; exit 1'
TimeoutStartSec=180

# Restart policy (StartLimit* are in [Unit], above)
Restart=always
RestartSec=5

# Resource limits
MemoryMax=512M
CPUQuota=200%
TasksMax=1024
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No CAP_NET_BIND_SERVICE: loopback-only unprivileged port (auth.env LISTEN_ADDR).

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=setjoin-auth

# Least privilege (#359b): config.env (app-role DB_DSN/DB_DIRECT_DSN, shared
# JWT/keys), then auth.env: root-only 0600, carrying the only DB credential
# setjoin-auth reads beyond config.env (DB_WORKER_DSN), LISTEN_ADDR, empty
# TLS_CERT/TLS_KEY, and TRUSTED_PROXY_IP=127.0.0.1. The privileged credential
# file (owner tiers) is NOT loaded by this internet-facing process.
# ORDER-SENSITIVE: auth.env stays LAST (later EnvironmentFile wins).
EnvironmentFile={{CONFIG_ENV}}
EnvironmentFile={{AUTH_ENV}}

[Install]
WantedBy=multi-user.target
