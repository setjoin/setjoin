          <type>ZABBIX_ACTIVE</type>
          <value_type>UNSIGNED</value_type>
          <delay>30s</delay>
          <triggers>
            <trigger>
              <uuid>10000000000000000000000000000001</uuid>
              <expression>{last()}&lt;&gt;200</expression>
