# Pgpool-II configuration — 3-node HA deployment
# Place at /etc/pgpool2/pgpool.conf on each node.
# Generated by HA Deploy Wizard.

# ── Backend PostgreSQL nodes ──
# Node 1 (initial primary)
backend_hostname0 = '{{.Node1}}'
backend_port0 = 5432
backend_weight0 = 1
backend_flag0 = 'ALWAYS_PRIMARY|DISALLOW_TO_FAILOVER'

# Node 2 (sync standby)
backend_hostname1 = '{{.Node2}}'
backend_port1 = 5432
backend_weight1 = 1

# Node 3 (async standby)
backend_hostname2 = '{{.Node3}}'
backend_port2 = 5432
backend_weight2 = 1

# ── Connection Pooling ──
listen_addresses = '*'
# The '*' bind is functionally required for cross-node pgpool/watchdog
# communication and application SQL access — which makes the FIREWALL the
# load-bearing control (this file ships weaker network defaults than the
# single-node loopback/TLS posture). Required firewall posture:
#   9999/tcp  → application clients + peer pgpool nodes ONLY
#   9000/udp+tcp (watchdog/heartbeat) → peer pgpool nodes ONLY
#   5432/tcp  → this host's pgpool → backend PostgreSQL nodes ONLY
# Never expose 9999 to anything broader than the backend/management network.
port = 9999
num_init_children = 32
max_pool = 4
connection_life_time = 600
client_idle_limit = 300
#
# ── Client-auth and encryption hardening (operator MUST render these) ──
# This template ships WITHOUT pool_hba or TLS by default: as rendered below,
# client SQL AND the health-check credential transit the backend network in
# cleartext. Before production use, set:
#   enable_pool_hba = on        (requires shipping a minimal pool_hba.conf —
#                               at minimum: local all all trust, then host
#                               records restricted to the app/management
#                               subnets with scram-sha-256; pgpool refuses to
#                               start if the file is absent, so render it in
#                               the same pass)
#   ssl = on                    (plus ssl_cert/ssl_key) so the client path is
#                               encrypted end to end
# until then, rely on the firewall rules above and keep health_check_password
# out of any world-readable render.


# ── Health Check ──
health_check_period = 3
health_check_timeout = 10
health_check_user = 'pgpool'
health_check_password = '{{.PgpoolPass}}'
health_check_max_retries = 3
health_check_retry_delay = 1

# ── Failover ──
failover_command = '/etc/pgpool2/failover.sh %d %P %H %R'
failback_command = ''
fail_over_on_backend_error = on
search_primary_node_timeout = 10

# ── Load Balancing ──
load_balance_mode = on

# ── Watchdog (split-brain prevention) ──
use_watchdog = on
wd_hostname = '{{.MyHost}}'
wd_port = 9000
wd_priority = 1
wd_lifecheck_method = 'heartbeat'
wd_heartbeat_keepalive = 2
wd_heartbeat_deadtime = 30

other_pgpool_hostname0 = '{{.Peer1}}'
other_pgpool_port0 = 9999
other_pgpool_wd_port0 = 9000

other_pgpool_hostname1 = '{{.Peer2}}'
other_pgpool_port1 = 9999
other_pgpool_wd_port1 = 9000

# ── Synchronous Replication ──
# At least one standby must confirm each write
synchronous_standby_names = 'ANY 1 (node2, node3)'
