# =============================================================================
# SetJoin Gateway — Environment Variable Configuration
# =============================================================================
# Copy this file to /etc/mail/environment and customize for your deployment.
# All variables have sensible defaults for single-node operation.
# Lines starting with # are comments.
#
# HA deployment: see docs/guides/HA_OVERVIEW.md for full 3-node setup.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# The runtime DSNs below MUST be the least-privilege application role
# (setjoin_app: NOSUPERUSER, NOBYPASSRLS, owns nothing, constrained by FORCE'd
# RLS). Tenant-facing services must never run as the database owner or a
# PostgreSQL superuser — one all-powerful runtime credential turns any gateway
# flaw into total data exposure.
#
# install.sh provisions this shape by default (docs/guides/NATIVE_RLS_FLIP_RUNBOOK.md):
#   setjoin_app    → DB_DSN / DB_DIRECT_DSN below (the ONLY credentials here)
#   setjoin_worker → DB_WORKER_DSN (BYPASSRLS, cross-tenant background jobs)
#   setjoin_owner  → DB_OWNER_DSN / DB_DIRECT_OWNER_DSN (migrations, partition DDL)
# The privileged tiers are NEVER written to this tenant-facing file; they live
# exclusively in /etc/setjoin/db-credentials.d/db-credentials.env (0600
# root:root) and reach the units through their own EnvironmentFile= line.
# The opt-out (--permissive-dsn single-DSN mode) still renders an owner-credential
# runtime — it is an explicit, operator-chosen downgrade, not a default.
DB_DSN=postgres://setjoin_app:<generated-app-password>@127.0.0.1:6432/mailserver?sslmode=disable

# Direct PostgreSQL connection (for LISTEN/NOTIFY — bypasses PgBouncer);
# same constrained setjoin_app role, direct host.
DB_DIRECT_DSN=postgres://setjoin_app:<generated-app-password>@127.0.0.1:5432/mailserver?sslmode=disable

# Maximum database connections in the pool
DB_MAX_CONNS=10

# ── Encryption (REQUIRED in production) ──────────────────────────────────────
# Master encryption key for S3 blobs and sensitive DB columns.
# Generate with: mailctl key generate
# Minimum 32 hex characters (16 bytes).
# Without this key, the server will not start in production mode.
# In dev mode (SETJOIN_DEV=true), an ephemeral key is auto-generated.
DB_ENCRYPTION_KEY=

# HMAC key for the admin_audit_log tamper-evidence chain (audit chain V3).
# Any strong random secret; never stored in the database. Empty = the audit
# chain falls back to unkeyed sha256 (verifiable but forgeable by anyone who
# can read the raw rows) and the server logs a WARN at boot.
AUDIT_HMAC_KEY=CHANGE_ME_GENERATE_32_RANDOM_BYTES
BACKUP_SIGNING_KEY_FILE=/etc/setjoin/backup-signing-key

# Crypto algorithm profile: standard (AES-256-GCM), smx (SM2/SM3/SM4), hybrid
CRYPTO_ALGORITHM_PROFILE=standard

# ── Listen ───────────────────────────────────────────────────────────────────
# HTTP listen address. Use :443 for production HTTPS, :80 for dev h2c.
LISTEN_ADDR=:443

# TLS certificate and key (PEM format). Leave empty for h2c dev mode.
TLS_CERT=/etc/mail/tls/server.pem
TLS_KEY=/etc/mail/tls/server-key.pem

# ── Object Storage (SeaweedFS / S3-compatible) ───────────────────────────────
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mailblobs
S3_SECURE=false

# ── JWT ──────────────────────────────────────────────────────────────────────
# Shared secret between gateway and auth server. Min 32 chars.
JWT_SECRET=
JWT_ISSUER=mailserver
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=720h
# Optional independent master; empty derives from JWT_SECRET.
JWT_MAIL_ATTACHMENT_SECRET=
# Rotation-only: old attachment master; verification only. Remove after
# every gateway runs the new key and the 5m token TTL + clock skew has drained.
JWT_MAIL_ATTACHMENT_PREVIOUS_SECRET=

# ── Auth Server ──────────────────────────────────────────────────────────────
# Internal API key shared between gateway and auth server.
INTERNAL_API_KEY=

# Public hostname (used in SAML entity ID, OIDC redirects)
HOSTNAME=mail.example.com

# ── Geoblocking (optional) ───────────────────────────────────────────────────
# MaxMind GeoLite2 database path
GEOIP_DB_PATH=/etc/mail/GeoLite2-City.mmdb

# Comma-separated country codes to block (e.g. CN,RU,KP)
GEO_BLOCK_COUNTRIES=

# ── Backup (optional) ────────────────────────────────────────────────────────
# Backup provider: s3 or oss. Leave empty to disable.
BACKUP_PROVIDER=
BACKUP_ENDPOINT=
BACKUP_REGION=us-east-1
BACKUP_BUCKET=
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────────
# Metrics endpoint (/metrics) Bearer token. Fail-closed by default: if this is
# left empty, /metrics returns 401 for every request. Set METRICS_ALLOW_UNAUTHENTICATED=1
# instead of a token to explicitly allow unauthenticated scraping (e.g. a
# trusted-network Prometheus scrape) — a loud startup WARN names the opt-out.
METRICS_TOKEN=
METRICS_ALLOW_UNAUTHENTICATED=

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ── Development Mode ─────────────────────────────────────────────────────────
# Set to true to enable dev-only features (ephemeral encryption key, h2c, CORS)
SETJOIN_DEV=false

# ── WebAuthn / Passkeys ──────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Mailserver
WEBAUTHN_RP_ORIGIN=http://localhost:80

# ── Push Notifications (MFA) ─────────────────────────────────────────────────
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# ── setjoin Meet B1 (conferencing — LiveKit SFU sidecar) ─────────────────────
# Provisioned unconditionally by install.sh (mailserver/deploy/scripts/
# lib-livekit.sh) alongside the setjoin-sfu.service unit; feature.meet itself
# ships seeded OFF (flip per-org once ready). LIVEKIT_API_KEY is a constant
# key ID, not a secret; LIVEKIT_API_SECRET is generated ONCE by install.sh
# and written here AND into /etc/setjoin/livekit.yaml's keys.setjoin in the
# same run — never edit one without the other (they must match verbatim).
LIVEKIT_API_KEY=setjoin
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://127.0.0.1:7880

# ── setjoin Meet B2 (recording — LiveKit Egress + a loopback Valkey bus) ─────
# Provisioned unconditionally by install.sh alongside the SFU (Task 9);
# feature.meet_recording itself ships seeded OFF (gates only the start
# route — see mailserver/internal/meet/AGENTS.md). MEET_EGRESS_ENABLED is a
# constant, not a secret (read directly, not via config.env.sample-as-koanf).
# VALKEY_PASSWORD is generated ONCE by install.sh and mirrored verbatim into
# /etc/setjoin/valkey.conf, /etc/setjoin/egress.yaml, and livekit.yaml's
# redis: block in the same run (law 3 — never edit one without the others).
MEET_EGRESS_ENABLED=true
VALKEY_PASSWORD=

# Guest lobby rate limits (the ONE unauthenticated Meet surface). Sized for a
# multi-guest office behind one corporate NAT egress IP — several guests at
# the same site share one IP, so the ceiling must clear plausible legitimate
# concurrency, not just one person.
MEET_GUEST_WRITE_RATE_LIMIT=20   # join-request creates, per (IP,slug) per 15min
MEET_GUEST_READ_RATE_LIMIT=120   # lobby polls, per IP per minute (~6 guests at the 3s poll)

# ── setjoin Pillar C1 (DM federation — optional, s2s inside mailserverd) ────
# Written ONLY when install.sh's FEDERATION_ENABLED prompt is answered yes
# (a Go service inside mailserverd, cmd/mailserverd/main.go — no systemd
# unit, no sidecar). All three of FEDERATION_LOCAL_DOMAIN/_CERT/_KEY must be
# non-empty for the static gate to construct+start federation.Service;
# FEDERATION_LISTEN_ADDR defaults to :7443 when unset. feature.federation
# (DB toggle, seeded OFF) and the admin allow-list console (federation.manage)
# separately gate actual cross-org peering.
FEDERATION_LOCAL_DOMAIN=
FEDERATION_LISTEN_ADDR=:7443
FEDERATION_CERT=
FEDERATION_KEY=

# ── Threat Detection ─────────────────────────────────────────────────────────
THREAT_FEED_ENABLED=true
THREAT_GEO_BLOCK_ENABLED=true
THREAT_SPRAY_DETECT_ENABLED=true
THREAT_CAPTCHA_ENABLED=true
THREAT_TARPIT_ENABLED=true
THREAT_SPRAY_WINDOW_SECS=300
THREAT_SPRAY_MAX_USERS=5
THREAT_SPRAY_LOCKOUT_MINS=30
THREAT_CAPTCHA_WINDOW_MINS=5
THREAT_CAPTCHA_THRESHOLD=3
THREAT_TARPIT_WINDOW_MINS=15
THREAT_TARPIT_THRESHOLD=3
THREAT_RATE_LIMIT_PER_MIN=20

# ── Kerberos / SPNEGO ────────────────────────────────────────────────────────
KERBEROS_ENABLED=false

# ── SAML / OIDC Enterprise SSO ───────────────────────────────────────────────
SAML_ENABLED=false
OIDC_ENABLED=false
# OIDC Provider (IdP mode). Keys default to the writable install root.
OIDC_PROVIDER_ENABLED=false
OIDC_PROVIDER_PRIVATE_KEY_FILE=/opt/setjoin/oidc_key.pem
OIDC_PROVIDER_PUBLIC_KEY_FILE=/opt/setjoin/oidc_pub.pem
# Optional comma-separated browser origins for OIDC token/UserInfo CORS.
# The provider's own https://HOSTNAME origin is always allowed.
OIDC_PROVIDER_ALLOWED_ORIGINS=
# IMAP requires STARTTLS on non-loopback port 143 and enables implicit TLS on
# 993. Startup rejects a non-loopback IMAP_ADDR unless TLS_CERT/TLS_KEY are set.
IMAP_TLS_ADDR=:993
AD_SYNC_ENABLED=false
JIT_ENABLED=false

# ── HA (3-node deployment only) ──────────────────────────────────────────────
# See docs/guides/HA_OVERVIEW.md for full 3-node setup.
# Node index in the HA cluster (1, 2, or 3)
HA_NODE_INDEX=
# Peer gateway addresses (comma-separated)
HA_GATEWAY_PEERS=
# Pgpool-II endpoint for HA database access
HA_PGPOOL_DSN=
