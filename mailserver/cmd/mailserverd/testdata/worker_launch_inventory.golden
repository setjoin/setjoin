named|cert-monitor|func(ctx context.Context) { certMon.Run(ctx, 24*time.Hour) }
named|http-port80|func(context.Context) { logger.Info("HTTP redirect server starting", "addr", ":80") if err := http80Server.ListenAndServe(); err != nil && err != http.ErrServerClosed { logger.Error("HTTP server error", "error", err) } }
named|http-tls|func(context.Context) { logger.Info("gateway starting (TLS + HTTP/2)", "addr", state.Address) if err := httpServer.Serve(tlsListener); err != nil && err != http.ErrServerClosed { logger.Error("TLS server error", "error", err) stop() } }
named|http-h2c|func(context.Context) { logger.Info("gateway starting (h2c dev mode)", "addr", state.Address) if err := httpServer.Serve(state.Listener); err != nil && err != http.ErrServerClosed { logger.Error("server error", "error", err) stop() } }
