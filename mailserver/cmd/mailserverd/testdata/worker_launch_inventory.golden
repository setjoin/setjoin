schema=1
named|config-reload|func(context.Context) { for range reloadCh { logger.Info("SIGHUP received, reloading config") newCfg, err := config.LoadWithKoanf(os.Getenv("SETJOIN_CONFIG")) if err != nil { logger.Error("config reload failed, keeping old config", "error", err) continue } cfgPtr.Store(newCfg) middleware.LoadTrustedProxies(context.Background(), pool) if err := smime.SetDefaultEncryptAlgorithm(smime.EncryptAlgorithm(newCfg.SMIMEEncryptAlgorithm)); err != nil { logger.Error("config reload: invalid smime.encrypt_algorithm, keeping previous", "error", err) } else { logger.Info("outbound S/MIME content encryption", "algorithm", string(smime.DefaultEncryptAlgorithm())) } logger.Info("config reloaded successfully") } }
named|db-listener|listener.Run
named|approval-notify|func(ctx context.Context) { approval.HandleApprovalCreatedNotify(ctx, workerPool.Pool, []byte(msg.Payload), []byte(cfg.JWTSecret), approvalNotifyBaseURL, logger) }
managed|webhook-retry|webhookDispatcher.StartRetryWorker
named|session-denylist-refresh|func(context.Context) { tick := time.NewTicker(30 * time.Second) defer tick.Stop() for { select { case <-lifecycleCtx.Done(): return case <-tick.C: if err := sessionDenylist.Refresh(lifecycleCtx); err != nil { logger.Warn("session denylist: reconcile failed (fail-closed active)", "error", err) } } } }
named|spam-trainer|spamTrainer.Start
named|mdm-notify|func(context.Context) { for payload := range devicePolicyCh { n, err := mdm.ParseNotifyPayload(payload) if err != nil { logger.Warn("mam: malformed device_policy notification", "error", err, "payload", payload) continue } logger.Debug("mam: device_policy change (no WS push wired; clients refresh on next check-in)", "device_id", n.DeviceID, "version", n.Version, "action", n.Action) } }
named|auth-chain-reload|func(ctx context.Context) { chain.ListenForChanges(ctx, listener) }
