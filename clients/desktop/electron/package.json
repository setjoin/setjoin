{
  "name": "setjoin-desktop-electron",
  "version": "0.1.0",
  "private": true,
  "description": "SetJoin desktop shell (Electron) — hosts the webmail SPA + window.setjoinNative bridge. Migration of clients/desktop/src-tauri per ARCH-013.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/bundle.mjs && ELECTRON_DEV_SERVER_URL=${ELECTRON_DEV_SERVER_URL:-http://localhost:5173} electron .",
		"test": "vitest run",
		"lint": "biome lint . --error-on-warnings",
		"format:check": "biome format .",
		"check:patch-cadence": "node scripts/check-electron-patch-cadence.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.4.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  }
}
